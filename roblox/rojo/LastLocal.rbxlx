      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Polaroid</string>
          <string name="Source"><![CDATA[--!strict
-- Polaroid 600 rules from polaroidManager.ts / engineTools.ts.
-- A shot privately records framed anomalies; the stop scores them like a flag.
-- Flash may raise suspicion when parents are alert, or make one glance.

local Polaroid = {}

Polaroid.STARTING_FILM = 8
Polaroid.MAX_FILM = 10
Polaroid.SHUTTER_COOLDOWN = 0.9
Polaroid.FLASH_GLANCE_CHANCE = 0.5
-- Web frustum cone (~0.65 rad) and max distance (18 m).
Polaroid.CONE_RAD = 0.65
Polaroid.MAX_RANGE_M = 18
-- SUS.visible in constants.ts
Polaroid.FLASH_WATCH_SUSPICION = 10

export type Photo = {
	id: string,
	stop: string,
	framed: { string },
	developed: boolean,
}

function Polaroid.inFrame(camPos: Vector3, lookDir: Vector3, targetPos: Vector3, studsPerMeter: number): boolean
	local ox = targetPos.X - camPos.X
	local oy = targetPos.Y - camPos.Y
	local oz = targetPos.Z - camPos.Z
	local dist = math.sqrt(ox * ox + oy * oy + oz * oz)
	if dist > Polaroid.MAX_RANGE_M * studsPerMeter or dist < 0.05 then
		return false
	end
	local lookLen = math.sqrt(lookDir.X * lookDir.X + lookDir.Y * lookDir.Y + lookDir.Z * lookDir.Z)
	if lookLen < 0.05 then
		return false
	end
	local lx = lookDir.X / lookLen
	local ly = lookDir.Y / lookLen
	local lz = lookDir.Z / lookLen
	local tx = ox / dist
	local ty = oy / dist
	local tz = oz / dist
	local cosAngle = lx * tx + ly * ty + lz * tz
	-- angle < CONE_RAD ⇔ cos > cos(CONE_RAD)
	return cosAngle >= math.cos(Polaroid.CONE_RAD)
end

function Polaroid.photoCatches(framed: { string }, liveIds: { string }): boolean
	for _, framedId in framed do
		for _, liveId in liveIds do
			if framedId == liveId then
				return true
			end
		end
	end
	return false
end

-- Watched/hunted bands: parents are alert enough that a flash counts as visible.
function Polaroid.flashWatched(band: string): boolean
	return band == "watched" or band == "hunted"
end

function Polaroid.clampFilm(n: number): number
	return math.clamp(math.floor(n + 0.5), 0, Polaroid.MAX_FILM)
end

return Polaroid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Practice</string>
          <string name="Source"><![CDATA[--!strict
-- Practice / chapter-select helpers from src/game/practice.ts.
-- Chapter II/III starts are off-record: no endings, badges, or DataStore writes.

local Practice = {}

-- 1-based index into Route.SEGMENTS (web CHAPTER_START_SEGMENT is 0-based into SEGS).
-- Ch I: whole ride from Hoyt. Ch II: into Safe Haven. Ch III: Greenpoint restraint.
Practice.CHAPTER_START_INDEX = {
	[1] = 1,
	[2] = 5,
	[3] = 11,
}

function Practice.normalizeChapter(chapter: number): number
	if chapter == 2 or chapter == 3 then
		return chapter
	end
	return 1
end

function Practice.startIndex(chapter: number): number
	local ch = Practice.normalizeChapter(chapter)
	return Practice.CHAPTER_START_INDEX[ch] or 1
end

function Practice.isPractice(chapter: number): boolean
	return Practice.normalizeChapter(chapter) > 1
end

function Practice.offRecord(practiceOn: boolean, debugRun: boolean): boolean
	return practiceOn or debugRun
end

return Practice
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">PsychLog</string>
          <string name="Source"><![CDATA[--!strict
-- Ride Psych Log: anomaly types seen / caught this ride (web psychLog.ts).
-- Shown on the Travel Report. Persistent Case Files stay in MetaStore (PR15).

local PsychLog = {}

export type EntryDef = {
	id: string,
	title: string,
	tier: number,
	note: string,
}

export type RideRecord = {
	id: string,
	stop: string,
	seen: boolean,
	caught: boolean,
}

export type RideState = {
	records: { RideRecord },
	byId: { [string]: RideRecord },
}

-- Catalog ids this Rojo slice can schedule (plus photo catch marker).
local ENTRIES: { [string]: EntryDef } = {
	poster_changed = {
		id = "poster_changed",
		title = "The Misprint",
		tier = 0,
		note = "An ad shifted color while you weren’t looking.",
	},
	sticker = {
		id = "sticker",
		title = "Window Residue",
		tier = 0,
		note = "Something appeared on the glass between stops.",
	},
	lighttemp = {
		id = "lighttemp",
		title = "The Cold Panel",
		tier = 0,
		note = "One ceiling tube turned a hospital blue.",
	},
	mapstop = {
		id = "mapstop",
		title = "Route Map Error",
		tier = 1,
		note = "The strip map listed Hollow St. There is no Hollow St.",
	},
	moved = {
		id = "moved",
		title = "The Relocated Passenger",
		tier = 1,
		note = "A rider was at the far doors without crossing the car.",
	},
	extra = {
		id = "extra",
		title = "The Additional Passenger",
		tier = 1,
		note = "A silent rider sat at the far end. They didn’t board.",
	},
	wrong_announcement = {
		id = "wrong_announcement",
		title = "Wrong Call",
		tier = 1,
		note = "The conductor named a stop you were not approaching.",
	},
	wrong_countdown = {
		id = "wrong_countdown",
		title = "Wrong Minutes",
		tier = 1,
		note = "The board’s minute count disagreed with the stretch.",
	},
	nearword = {
		id = "nearword",
		title = "Warped Copy",
		tier = 2,
		note = "An ad rearranged itself into words meant for you.",
	},
	empty = {
		id = "empty",
		title = "The Empty Car",
		tier = 3,
		note = "Every stranger was gone at once. Your parents didn’t mention it.",
	},
	faceturn = {
		id = "faceturn",
		title = "The Woman on Your Bench",
		tier = 2,
		note = "Her head turned further than a neck allows.",
	},
	momface = {
		id = "momface",
		title = "Mom, Fixed",
		tier = 3,
		note = "Her face set into an expression that wasn’t hers.",
	},
}

PsychLog.ENTRIES = ENTRIES

function PsychLog.newRide(): RideState
	return { records = {}, byId = {} }
end

function PsychLog.definition(id: string): EntryDef?
	return ENTRIES[id]
end

function PsychLog.markSeen(state: RideState, id: string, stop: string)
	local existing = state.byId[id]
	if existing ~= nil then
		existing.seen = true
		return
	end
	local rec: RideRecord = { id = id, stop = stop, seen = true, caught = false }
	state.byId[id] = rec
	table.insert(state.records, rec)
end

function PsychLog.markCaught(state: RideState, id: string, stop: string)
	local existing = state.byId[id]
	if existing ~= nil then
		existing.seen = true
		existing.caught = true
		return
	end
	local rec: RideRecord = { id = id, stop = stop, seen = true, caught = true }
	state.byId[id] = rec
	table.insert(state.records, rec)
end

function PsychLog.formatReport(state: RideState): string
	if #state.records == 0 then
		return "Psych Log\n(none this ride)"
	end
	local lines = { "Psych Log" }
	for _, rec in state.records do
		local def = ENTRIES[rec.id]
		local title = if def ~= nil then def.title else rec.id
		local status = if rec.caught then "documented" else "unconfirmed"
		table.insert(lines, string.format("• %s @ %s [%s]", title, rec.stop, status))
	end
	return table.concat(lines, "\n")
end

return PsychLog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Restraint</string>
          <string name="Source"><![CDATA[--!strict
-- Greenpoint Av restraint beat (web gameState startRestraintMoment /
-- updateRestraint / endRestraint). Pure helpers; Ride owns the live state.

local Constants = require(script.Parent.Constants)

local Restraint = {}

Restraint.START_AT = Constants.RESTRAINT_START_AT
Restraint.WAIT_TIMEOUT = Constants.RESTRAINT_WAIT
Restraint.DURATION = Constants.RESTRAINT_DURATION
Restraint.GRACE = Constants.RESTRAINT_GRACE

Restraint.BEAT_MOM = 1.5
Restraint.BEAT_DAD = 4.0
Restraint.BEAT_EMPTY = 7.0
Restraint.BEAT_MOUTH = 10.5

export type State = {
	t: number,
	started: boolean,
	wait: number,
	dur: number,
	beats: number,
	grace: number,
}

function Restraint.newState(duration: number): State
	return {
		t = 0,
		started = false,
		wait = 0,
		dur = duration,
		beats = 0,
		grace = 0,
	}
end

function Restraint.shouldStart(segRestraint: boolean, done: boolean, elapsed: number, startAt: number, busy: boolean): boolean
	if not segRestraint or done or busy then
		return false
	end
	return elapsed >= startAt
end

-- Advance one tick. Returns "wait" | "holding" | "fail_wait" | "fail_release" | "ok".
function Restraint.tick(state: State, dt: number, held: boolean): string
	if state.grace > 0 then
		state.grace = math.max(0, state.grace - dt)
		if not held then
			return "wait"
		end
	end

	if not state.started then
		state.wait += dt
		if held then
			state.started = true
			return "holding"
		end
		if state.wait > Restraint.WAIT_TIMEOUT then
			return "fail_wait"
		end
		return "wait"
	end

	if not held and state.t < state.dur then
		return "fail_release"
	end

	state.t += dt
	if state.t >= state.dur then
		return "ok"
	end
	return "holding"
end

function Restraint.progress(state: State): number
	if not state.started then
		return 0
	end
	if state.dur <= 0 then
		return 1
	end
	return math.clamp(state.t / state.dur, 0, 1)
end

function Restraint.dimFraction(t: number): number
	-- Web: dim = max(0.4, min(1, 1 - t/6))
	return math.clamp(1 - t / 6, 0.4, 1)
end

function Restraint.shouldFireBeat(state: State, at: number): boolean
	if state.t >= at and state.beats < at then
		state.beats = at
		return true
	end
	return false
end

function Restraint.grantGrace(state: State, seconds: number)
	state.grace = math.max(state.grace, seconds)
end

return Restraint
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Route</string>
          <string name="Source"><![CDATA[--!strict
-- G train stops and the stretch table from src/constants.ts (STOPS, SEGS,
-- CHAPTERS). Fields this slice plays: name, real / false / haven, arrival
-- tick, quiet PA, parent chat index, and mask check times (seconds into the
-- stretch, fitted to sliceCruise). Safe Haven runs at kind "haven"; the trial stays out.

local Route = {}

export type Tick = "doors" | "flicker"
export type StopKind = "real" | "false" | "haven"

export type Segment = {
	stop: number,
	b: boolean,
	kind: StopKind,
	tick: Tick?,
	silent: boolean,
	crowd: boolean,
	final: boolean,
	-- Classon Av only. Mom pulls you back; no trial.
	forgiving: boolean,
	-- Greenpoint Av restraint beat (hold Space/F; don't let go).
	restraint: boolean?,
	paLie: string?,
	-- Web SEGS.chat index into CHATS / calm swaps. Nil = no chat on this stretch.
	chat: number?,
	-- Seconds into the stretch when a mask check starts (slice-scaled).
	masks: { number }?,
	-- Web cruise is 26 unless noted. The slice uses a shorter cruise.
	-- Stop 11 is longer so the 15 s restraint can finish before arrival.
	sliceCruise: number,
}

-- Signed names, stop numbers 1 through 13. The web array has an empty [0].
local STOPS: { [number]: string } = {
	[1] = "Hoyt–Schermerhorn",
	[2] = "Fulton St",
	[3] = "Clinton–Washington Avs",
	[4] = "Classon Av",
	[5] = "Bedford–Nostrand Avs",
	[6] = "Myrtle–Willoughby Avs",
	[7] = "Flushing Av",
	[8] = "Broadway",
	[9] = "Metropolitan Av",
	[10] = "Nassau Av",
	[11] = "Greenpoint Av",
	[12] = "21 St",
	[13] = "Court Sq",
}

local CHAPTERS = {
	{ from = 1, to = 5, numeral = "I", title = "THE DESCENT" },
	{ from = 6, to = 10, numeral = "II", title = "SIGNAL DRIFT" },
	{ from = 11, to = 13, numeral = "III", title = "OPERATION SKYWARD" },
}

-- Same order as SEGS. sliceCruise is the shortened stand-in for the web cruise
-- (26, or the override on 6b and the last stretch).
local SEGMENTS: { Segment } = {
	{ stop = 2, b = false, kind = "real", tick = nil, silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = nil, masks = nil, sliceCruise = 12 },
	{ stop = 3, b = false, kind = "real", tick = nil, silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = 0, masks = { 12 }, sliceCruise = 12 },
	{ stop = 4, b = false, kind = "false", tick = "doors", silent = false, crowd = false, final = false, forgiving = true, paLie = nil, chat = nil, masks = nil, sliceCruise = 12 },
	{ stop = 5, b = false, kind = "real", tick = nil, silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = 1, masks = { 12 }, sliceCruise = 12 },
	{ stop = 6, b = false, kind = "haven", tick = nil, silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = nil, masks = nil, sliceCruise = 12 },
	-- 6b. No announcement. The arrival flicker is the whole-car blackout.
	{ stop = 6, b = true, kind = "false", tick = "flicker", silent = true, crowd = false, final = false, forgiving = false, paLie = nil, chat = nil, masks = nil, sliceCruise = 8 },
	{ stop = 7, b = false, kind = "real", tick = nil, silent = false, crowd = true, final = false, forgiving = false, paLie = nil, chat = 2, masks = { 12 }, sliceCruise = 12 },
	{ stop = 8, b = false, kind = "real", tick = nil, silent = false, crowd = true, final = false, forgiving = false, paLie = nil, chat = 3, masks = { 8, 13 }, sliceCruise = 12 },
	{
		stop = 9,
		b = false,
		kind = "false",
		tick = "doors",
		silent = false,
		crowd = false,
		final = false,
		forgiving = false,
		paLie = "This is Court Square. Last stop. Everybody off the train.",
		chat = nil,
		masks = nil,
		sliceCruise = 12,
	},
	{ stop = 10, b = false, kind = "real", tick = nil, silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = 4, masks = { 12 }, sliceCruise = 12 },
	{
		stop = 11,
		b = false,
		kind = "real",
		tick = nil,
		silent = false,
		crowd = false,
		final = false,
		forgiving = false,
		restraint = true,
		paLie = nil,
		chat = nil,
		masks = nil,
		-- Long enough for RESTRAINT_START_AT + DURATION before brake ends.
		sliceCruise = 22,
	},
	-- 21 St. False stop. Flicker tick: the lights go out for 0.16 s. No "This is".
	{ stop = 12, b = false, kind = "false", tick = "flicker", silent = false, crowd = false, final = false, forgiving = false, paLie = nil, chat = nil, masks = { 12 }, sliceCruise = 12 },
	{ stop = 13, b = false, kind = "real", tick = nil, silent = false, crowd = false, final = true, forgiving = false, paLie = nil, chat = nil, masks = nil, sliceCruise = 10 },
}

Route.SEGMENTS = SEGMENTS

function Route.stopName(stop: number): string
	return STOPS[stop] or ""
end

-- Web gameState currentCarIndex thresholds (metres along the consist).
Route.CAR_A_MAX_X = -10.2
Route.CAR_C_MIN_X = 10.2

function Route.carLabel(xMetres: number): string
	if xMetres < Route.CAR_A_MAX_X then
		return "CAR A (LEAD)"
	elseif xMetres > Route.CAR_C_MIN_X then
		return "CAR C (REAR)"
	end
	return "CAR B (MID)"
end

-- HUD chapter line. Car letter defaults to mid until the client swaps it
-- from the player's position.
function Route.chapterLine(stop: number, carLabel: string?): string
	local numeral = "I"
	local title = "THE DESCENT"
	for _, chapter in CHAPTERS do
		if stop >= chapter.from and stop <= chapter.to then
			numeral = chapter.numeral
			title = chapter.title
			break
		end
	end
	return "CH. " .. numeral .. " · " .. title .. " · " .. (carLabel or "CAR B (MID)")
end

-- Replace the trailing car tag on a chapter line (server still ships MID).
function Route.withCarLabel(chapterLine: string, carLabel: string): string
	local replaced, count = string.gsub(chapterLine, "CAR [ABC] %([^%)]+%)", carLabel, 1)
	if count > 0 then
		return replaced
	end
	return chapterLine .. " · " .. carLabel
end

function Route.segmentLength(segment: Segment, accel: number, brake: number): number
	return accel + segment.sliceCruise + brake
end

return Route
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Sanity</string>
          <string name="Source"><![CDATA[--!strict
-- Sanity bands, tiers, and clamps from src/constants.ts / engineVitals.ts.
-- The Ride attribute is absolute 0–100; each stretch clamps into that stop's
-- band. Holding the Greenpoint restraint raises the ceiling for stops 11–13.

local Sanity = {}

Sanity.TIER_HIGH = "high"
Sanity.TIER_MEDIUM = "medium"
Sanity.TIER_LOW = "low"
Sanity.TIER_CRITICAL = "critical"

-- Web BANDS by stop number.
local BANDS: { [number]: { number } } = {
	[1] = { 80, 100 },
	[2] = { 80, 100 },
	[3] = { 80, 100 },
	[4] = { 70, 95 },
	[5] = { 50, 85 },
	[6] = { 50, 85 },
	[7] = { 30, 70 },
	[8] = { 30, 70 },
	[9] = { 30, 70 },
	[10] = { 5, 30 },
	[11] = { 0, 9 },
	[12] = { 0, 9 },
	[13] = { 0, 9 },
}

-- Web DRIFT: only where the band ceiling drops.
local DRIFT: { [number]: number } = {
	[2] = 0,
	[3] = 0,
	[4] = -5,
	[5] = -5,
	[6] = 0,
	[7] = -5,
	[8] = 0,
	[9] = 0,
	[10] = -5,
	[11] = -5,
	[12] = 0,
	[13] = 0,
}

function Sanity.tierOf(san: number): string
	if san >= 75 then
		return Sanity.TIER_HIGH
	end
	if san >= 40 then
		return Sanity.TIER_MEDIUM
	end
	if san >= 10 then
		return Sanity.TIER_LOW
	end
	return Sanity.TIER_CRITICAL
end

function Sanity.bandForStop(stop: number, restraintOk: boolean, raise: number): (number, number)
	local pair = BANDS[stop]
	local lo = if pair ~= nil then pair[1] else 0
	local hi = if pair ~= nil then pair[2] else 9
	if stop >= 11 and restraintOk then
		hi += raise
	end
	return lo, hi
end

function Sanity.driftForStop(stop: number): number
	local d = DRIFT[stop]
	if d == nil then
		-- Stop 1 (boarding) and unknown stops: no drift.
		return 0
	end
	return d
end

function Sanity.clamp(value: number, lo: number, hi: number): number
	return math.clamp(value, lo, hi)
end

-- Apply a delta inside the current stop band (web addSanity).
function Sanity.apply(current: number, delta: number, lo: number, hi: number): number
	return Sanity.clamp(current + delta, lo, hi)
end

-- Position inside the band, 0–1, for Sanity Retained (PR14 report).
function Sanity.bandPosition(san: number, lo: number, hi: number): number
	if hi <= lo then
		return 1
	end
	return math.clamp((san - lo) / (hi - lo), 0, 1)
end

function Sanity.retainedPercent(samples: { number }): number
	if #samples == 0 then
		return 0
	end
	local sum = 0
	for _, pos in samples do
		sum += pos
	end
	return math.floor((100 * sum) / #samples + 0.5)
end

return Sanity
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Score</string>
          <string name="Source"><![CDATA[--!strict
-- Per-stop suspicion. The server decides the result. The number stays in
-- range. Reaching 100 does not end the ride.

local Score = {}

-- correct: the flag hit an anomaly. anomalyLive: a tell or the poster is
-- up right now. A correct flag lowers suspicion. A flag while nothing is
-- up is a false alarm. Flagging the wrong body while something is up
-- changes nothing.
function Score.flagDelta(correct: boolean, anomalyLive: boolean, falseAmount: number, correctAmount: number): number
	if correct then
		return -correctAmount
	end
	if not anomalyLive then
		return falseAmount
	end
	return 0
end

-- One result. A catch wins. A false alarm wins over a miss. A miss does
-- not outrank a clean stop that had no anomaly.
function Score.result(hadAnomaly: boolean, noticed: boolean, falseAlarm: boolean): string
	if noticed then
		return "noticed"
	end
	if falseAlarm then
		return "false"
	end
	if hadAnomaly then
		return "missed"
	end
	return "clean"
end

-- Clean pays the clean bonus and the no-incident decay. A miss pays only
-- the decay. It does not go up. Noticed and false alarm were already
-- applied when the flag happened.
function Score.endDelta(kind: string, cleanAmount: number, decayAmount: number): number
	if kind == "clean" then
		return -(cleanAmount + decayAmount)
	end
	if kind == "missed" then
		return -decayAmount
	end
	return 0
end

-- Standing at the doors, moving to them, or staring on a false stop.
function Score.falseStopDelta(reacted: boolean, amount: number): number
	if reacted then
		return amount
	end
	return 0
end

-- Caught staring at an active anomaly (or a parent) while parents are alert.
function Score.stareDelta(caught: boolean, amount: number): number
	if caught then
		return amount
	end
	return 0
end

-- Sitting still and looking away on a clean stop (decay bonus).
function Score.sittingStillDelta(still: boolean, amount: number): number
	if still then
		return -amount
	end
	return 0
end

function Score.apply(current: number, delta: number, least: number, most: number): number
	return math.clamp(current + delta, least, most)
end

return Score
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Trestle</string>
          <string name="Source"><![CDATA[--!strict
-- Newtown Creek trestle timing from gameState.ts (G route only).
-- Exit mouth ~25% of the way to 21 St; re-enter ~60% of the way to Court Sq.

local Trestle = {}

-- Web TRESTLE_FOG #322018 — sodium dusk haze outside (RGB for WorldLight).
Trestle.FOG_RGB = { 50, 32, 24 }
Trestle.TUNNEL_FOG_RGB = { 4, 5, 4 }
-- Tunnel fog stays near WorldLight defaults (near/far in studs at 3 studs/m).
Trestle.TUNNEL_FOG_START = 27
Trestle.TUNNEL_FOG_END = 90
-- Open air pushes fog farther (web +5 near / +55 far metres).
Trestle.OPEN_FOG_START = 27 + 5 * 3
Trestle.OPEN_FOG_END = 90 + 55 * 3

-- How many metres of odo to blend tunnel ↔ open after a mouth.
Trestle.BLEND_M = 40

export type Plan = {
	-- Odo where the train leaves the tunnel (Infinity = never this stretch).
	exitAt: number,
	-- Odo where the train re-enters (nil = not this stretch).
	enterAt: number?,
}

function Trestle.plan(stop: number, b: boolean, origin: number, segDist: number): Plan
	if stop == 12 and not b then
		return {
			exitAt = origin + 0.25 * segDist,
			enterAt = nil,
		}
	end
	if stop == 13 then
		return {
			exitAt = -math.huge,
			enterAt = origin + 0.6 * segDist,
		}
	end
	return {
		exitAt = math.huge,
		enterAt = nil,
	}
end

-- 0 = fully in tunnel, 1 = fully outside (car middle).
function Trestle.outsideLevel(odo: number, plan: Plan): number
	local exitAt = plan.exitAt
	local enterAt = plan.enterAt
	if enterAt == nil then
		if exitAt >= math.huge then
			return 0
		end
		if odo < exitAt then
			return 0
		end
		return math.clamp((odo - exitAt) / Trestle.BLEND_M, 0, 1)
	end
	-- Already outside at the start of the Court Sq stretch.
	if odo < enterAt then
		return 1
	end
	return math.clamp(1 - (odo - enterAt) / Trestle.BLEND_M, 0, 1)
end

function Trestle.show(level: number): boolean
	return level > 0.05
end

-- Arriving platform is open-air on the 21 St approach; leaving is open when
-- departing 21 St toward Court Sq.
function Trestle.arrivingOpenAir(stop: number, b: boolean): boolean
	return stop == 12 and not b
end

function Trestle.leavingOpenAir(stop: number): boolean
	return stop == 13
end

return Trestle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Trial</string>
          <string name="Source"><![CDATA[--!strict
-- False Stop Trial loop from src/game/engineTrial.ts.
-- Signs lie; the chime marks the honest light / door. Visuals live in TrialSpace.

local Trial = {}

export type Mode = "paths" | "board"

export type State = {
	depth: number,
	need: number,
	mode: Mode,
	correct: number,
	stopName: string,
}

export type ChoiceItem = {
	text: string,
	val: number,
}

export type RoundView = {
	signs: { string },
	items: { ChoiceItem },
	windowSeconds: number, -- 0 = no timeout
	boardDoors: boolean,
}

export type PickResult = {
	kind: "continue" | "exit",
	clean: boolean?,
	subtitle: string,
	state: State,
}

local TERMINUS_SIGN = "Court Sq"
local TERMINUS = "Court Square"
local OPPOSITE = "Church Av"
local ORIGIN = "Hoyt–Schermerhorn"
local LINE = "G"

local function shuffle(list: { string }, rng: () -> number): { string }
	local out = table.clone(list)
	for i = #out, 2, -1 do
		local j = math.clamp(math.floor(rng() * i) + 1, 1, i)
		out[i], out[j] = out[j], out[i]
	end
	return out
end

function Trial.start(stopName: string): State
	return {
		depth = 0,
		need = 2,
		mode = "paths",
		correct = 0,
		stopName = stopName,
	}
end

function Trial.windowSeconds(depth: number): number
	if depth == 0 then
		return 0
	end
	return math.max(7, 14 - depth * 2)
end

function Trial.round(state: State, rng: () -> number): (State, RoundView)
	local d = state.depth
	local correct = if state.mode == "paths"
		then math.clamp(math.floor(rng() * 3), 0, 2)
		else (if rng() < 0.5 then 0 else 2)
	state.correct = correct

	local toward = "To " .. TERMINUS_SIGN .. " trains"
	local pools = {
		{ toward, "Exit", "To " .. OPPOSITE .. " trains" },
		{ toward, toward, toward },
		{
			toward:gsub("^To (%S)(%S)", "To %2%1"):gsub("trains$", "trians"),
			"Ext",
			"To You",
		},
		{ ORIGIN, ORIGIN, ORIGIN },
	}
	local pool = pools[math.min(d, 3) + 1]
	local signs = shuffle(pool, rng)

	local boardDoors = state.mode == "board"
	if boardDoors then
		signs = {
			TERMINUS_SIGN .. "-bound " .. LINE,
			"—",
			TERMINUS_SIGN .. "-bound " .. LINE,
		}
	end

	local items: { ChoiceItem }
	if state.mode == "paths" then
		local pathLabels = {
			{ "Left stairs", "Turnstiles", "Right stairs" },
			{ "Left stairs", "Middle stairs", "Right stairs" },
			{ "Down", "Down", "Down" },
		}
		local labels = pathLabels[math.min(d, 2) + 1]
		items = {
			{ text = labels[1], val = 0 },
			{ text = labels[2], val = 1 },
			{ text = labels[3], val = 2 },
		}
	else
		items = {
			{ text = "Board the left train", val = 0 },
			{ text = "Board the right train", val = 2 },
		}
	end

	return state, {
		signs = signs,
		items = items,
		windowSeconds = Trial.windowSeconds(d),
		boardDoors = boardDoors,
	}
end

function Trial.applyPick(state: State, val: number?): PickResult
	local ok = val ~= nil and val == state.correct
	if state.mode == "paths" then
		if ok then
			state.need -= 1
			local sub = if state.need > 0
				then "The stairs go down to another platform."
				else "You come out at the platform edge. Two trains are coming."
			if state.need <= 0 then
				state.mode = "board"
			end
			return { kind = "continue", subtitle = sub, state = state }
		end
		state.depth += 1
		state.need = math.min(state.need + 1, 3)
		if state.depth >= 4 then
			return {
				kind = "exit",
				clean = false,
				subtitle = "The stairs bring you back up onto the same platform. It’s quieter now.",
				state = state,
			}
		end
		return {
			kind = "continue",
			subtitle = "The stairs bring you back up onto the same platform. It’s quieter now.",
			state = state,
		}
	end

	-- board
	if ok then
		return { kind = "exit", clean = true, subtitle = "", state = state }
	end
	state.depth += 1
	state.mode = "paths"
	state.need = 1
	if state.depth >= 4 then
		return {
			kind = "exit",
			clean = false,
			subtitle = "The doors close on nothing. You’re back on the stairs.",
			state = state,
		}
	end
	return {
		kind = "continue",
		subtitle = "The doors close on nothing. You’re back on the stairs.",
		state = state,
	}
end

-- Chime cycle events for paths (flick correct first) or board (open/close).
export type CycleEvent = {
	at: number,
	index: number,
	kind: "flick" | "open" | "close",
}

function Trial.cycleEvents(state: State, rng: () -> number): { CycleEvent }
	local events: { CycleEvent } = {}
	if state.mode == "paths" then
		table.insert(events, { at = 0, index = state.correct, kind = "flick" })
		for i = 0, 2 do
			if i ~= state.correct then
				table.insert(events, {
					at = 0.8 + rng() * 2.2,
					index = i,
					kind = "flick",
				})
			end
		end
		if state.depth >= 1 then
			local decoys = {}
			for i = 0, 2 do
				if i ~= state.correct then
					table.insert(decoys, i)
				end
			end
			local decoy = decoys[math.clamp(math.floor(rng() * #decoys) + 1, 1, #decoys)]
			table.insert(events, {
				at = 0.22 + rng() * 0.13,
				index = decoy,
				kind = "flick",
			})
		end
	else
		local fake = if state.correct == 0 then 2 else 0
		table.insert(events, { at = 1.95, index = state.correct, kind = "open" })
		table.insert(events, { at = 1.15, index = fake, kind = "open" })
		table.insert(events, { at = 3.2, index = 0, kind = "close" })
		table.insert(events, { at = 3.2, index = 2, kind = "close" })
	end
	return events
end

Trial.CYCLE = 3.6
Trial.TERMINUS = TERMINUS

return Trial
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="31">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="32">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Builds the car, then runs the stop cycle. Characters load after the car
-- exists so nobody spawns into the void.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarBuilder = require(script.CarBuilder)
local Ride = require(script.Ride)
local WorldLight = require(script.WorldLight)
local Constants = require(ReplicatedStorage.Shared.Constants)

Players.CharacterAutoLoads = false
-- Workspace place properties (Gravity, StreamingEnabled, FallenPartsDestroyHeight)
-- live only in default.project.json. Runtime writes need PluginOrOpenCloud and
-- abort this script before Ride is created.

-- Forced again if Studio resets Lighting when play starts.
WorldLight.bind()

local car = CarBuilder.build()
Ride.start(car)

local function prepare(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.WalkSpeed = Constants.WALK_SPEED_MPS * Constants.STUDS_PER_METER
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = true
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.RespawnLocation = car.board

	humanoid.Died:Connect(function()
		task.wait(2)
		if player.Parent == Players then
			player:LoadCharacterAsync()
		end
	end)
end

local function spawnPlayer(player: Player)
	player.CharacterAdded:Connect(function(character: Model)
		prepare(player, character)
	end)
	player:LoadCharacterAsync()
end

Players.PlayerAdded:Connect(spawnPlayer)
for _, player in Players:GetPlayers() do
	spawnPlayer(player)
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">AnomalySystem</string>
          <string name="Source"><![CDATA[--!strict
-- Anomaly catalog for this slice. The ride asks pick() which one tell a
-- stop gets, applies it, and validates flags with verdict(). The arrival
-- PA lie in Route is a separate scripted line. It is not this catalog.
-- "extra" is the far-seat passenger (seat6): hidden at boarding, shown
-- mid-stretch, cleared on arrival. New types (lighttemp, sticker, mapstop,
-- moved, empty, nearword, faceturn, momface) follow web anomalyManager.ts
-- with NEAR_X fair-reach for close-look tells.

local AnomalySystem = {}

-- Web NEAR_X: small / readable tells only within this many metres of the seat.
AnomalySystem.NEAR_X = 5

AnomalySystem.ANNOUNCE_ID = "announcement"
AnomalySystem.COUNTDOWN_ID = "countdown"
AnomalySystem.EXTRA_ID = "seat6"
AnomalySystem.STICKER_ID = "sticker"
AnomalySystem.MAP_ID = "mapstop"
AnomalySystem.NEARWORD_ID = "nearword"
AnomalySystem.LIGHT_ID = "lighttemp"
AnomalySystem.EMPTY_ID = "empty"
AnomalySystem.MOVED_ID = "s3"
AnomalySystem.FACETURN_ID = "s2"
AnomalySystem.MOMFACE_ID = "mom"

export type Schedule = {
	posterStop: number,
	extraStop: number,
	announceStop: number,
	countdownStop: number,
	lighttempStop: number?,
	stickerStop: number?,
	nearwordStop: number?,
	mapstopStop: number?,
	movedStop: number?,
	emptyStop: number?,
	faceturnStop: number?,
	momfaceStop: number?,
}

function AnomalySystem.types(): { string }
	return {
		"poster_changed",
		"extra",
		"wrong_announcement",
		"wrong_countdown",
		"lighttemp",
		"sticker",
		"nearword",
		"mapstop",
		"moved",
		"empty",
		"faceturn",
		"momface",
	}
end

function AnomalySystem.isNear(xMetres: number): boolean
	return math.abs(xMetres) <= AnomalySystem.NEAR_X
end

-- Candidate X positions for close-look props (must pass isNear).
function AnomalySystem.nearSlots(): { number }
	return { -4.5, -3.0, -1.5, 0, 1.5, 3.0, 4.5 }
end

function AnomalySystem.pickNearSlot(seed: number): number
	local slots = AnomalySystem.nearSlots()
	local index = (math.floor(math.abs(seed)) % #slots) + 1
	return slots[index]
end

-- At most one tell. Earlier schedule entries win when stops collide.
-- b stretches (the silent 6b blackout) get none.
function AnomalySystem.pick(stop: number, b: boolean, schedule: Schedule): string?
	if b then
		return nil
	end
	if stop == schedule.posterStop then
		return "poster_changed"
	end
	if stop == schedule.extraStop then
		return "extra"
	end
	if stop == schedule.announceStop then
		return "wrong_announcement"
	end
	if stop == schedule.countdownStop then
		return "wrong_countdown"
	end
	if schedule.lighttempStop ~= nil and stop == schedule.lighttempStop then
		return "lighttemp"
	end
	if schedule.stickerStop ~= nil and stop == schedule.stickerStop then
		return "sticker"
	end
	if schedule.nearwordStop ~= nil and stop == schedule.nearwordStop then
		return "nearword"
	end
	if schedule.mapstopStop ~= nil and stop == schedule.mapstopStop then
		return "mapstop"
	end
	if schedule.movedStop ~= nil and stop == schedule.movedStop then
		return "moved"
	end
	if schedule.emptyStop ~= nil and stop == schedule.emptyStop then
		return "empty"
	end
	if schedule.faceturnStop ~= nil and stop == schedule.faceturnStop then
		return "faceturn"
	end
	if schedule.momfaceStop ~= nil and stop == schedule.momfaceStop then
		return "momface"
	end
	return nil
end

-- Another signed station. Never the stop the train is actually approaching
-- when some other signed name exists.
function AnomalySystem.wrongStop(actual: string, candidate: string, fallback: string): string
	if candidate ~= "" and candidate ~= actual then
		return candidate
	end
	if fallback ~= "" and fallback ~= actual then
		return fallback
	end
	return actual
end

function AnomalySystem.boardMinutes(honest: number, wrong: number, telling: boolean): number
	if telling then
		return wrong
	end
	return honest
end

-- Same split as a passenger flag. An active tell is noticed. Anything else
-- the server accepts is a false flag. Hidden targets never reach this.
function AnomalySystem.verdict(passengerAnomaly: boolean, targetIsTell: boolean, tellActive: boolean): "noticed" | "false"
	if passengerAnomaly or (targetIsTell and tellActive) then
		return "noticed"
	end
	return "false"
end

return AnomalySystem
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">CarBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- One G-train car, in parts, from the measurements in subwayCarBuilder.ts.
-- Passengers stand or sit on the web game's spots. A model named in
-- ReplicatedStorage.Models replaces the part figure; a missing model does not
-- stop the car from building.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)
local KeepOut = require(ReplicatedStorage.Shared.KeepOut)
local Passengers = require(ReplicatedStorage.Shared.Passengers)
local Consist = require(script.Parent.Consist)
local AnomalySystem = require(script.Parent.AnomalySystem)

local CarBuilder = {}

export type DoorLeaf = {
	model: Model,
	x0: number,
	y: number,
	z: number,
	side: number,
}

export type Lamp = {
	part: BasePart,
	light: PointLight?,
}

export type BuiltCar = {
	model: Model,
	doors: { DoorLeaf },
	lamps: { Lamp },
	passengers: Folder,
	board: SpawnLocation,
}

local function metres(x: number, y: number, z: number): Vector3
	local s = Constants.STUDS_PER_METER
	return Vector3.new(x * s, y * s, z * s)
end

local function sizeM(x: number, y: number, z: number): Vector3
	return metres(x, y, z)
end

type PartOpts = {
	name: string,
	parent: Instance,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	collide: boolean?,
	query: boolean?,
	shape: Enum.PartType?,
}

local function makePart(opts: PartOpts): Part
	local part = Instance.new("Part")
	part.Name = opts.name
	part.Anchored = true
	part.Size = opts.size
	part.CFrame = opts.cframe
	part.Color = opts.color or Constants.COLOR.wall
	part.Material = opts.material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = if opts.collide == nil then true else opts.collide
	part.CanQuery = if opts.query == nil then false else opts.query
	part.CanTouch = false
	part.Transparency = opts.transparency or 0
	if opts.shape ~= nil then
		part.Shape = opts.shape
	end
	part.Parent = opts.parent
	return part
end

local function applyShown(model: Model, shown: boolean)
	model:SetAttribute("Hidden", not shown)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc.Name == "KeepOut" then
				desc.CanCollide = shown
				desc.CanQuery = false
			elseif desc.Name == "Root" then
				desc.Transparency = 1
				desc.CanQuery = false
				desc.CanCollide = false
			else
				local base = desc:GetAttribute("ShownTransparency")
				local shownTransparency = if typeof(base) == "number" then base else 0
				desc.Transparency = if shown then shownTransparency else 1
				desc.CanQuery = shown
				desc.CanCollide = false
			end
		end
		if desc:IsA("Decal") or desc:IsA("Texture") then
			(desc :: Decal).Transparency = if shown then 0 else 1
		end
	end
end

function CarBuilder.setCrowd(folder: Folder, shown: boolean)
	for _, child in folder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("Crowd") == true then
			applyShown(child, shown)
		end
	end
end

-- Far-seat extra (and any other named rider). Server owns show/hide;
-- Flag already ignores Hidden models.
function CarBuilder.setPassengerShown(folder: Folder, id: string, shown: boolean)
	local model = folder:FindFirstChild(id)
	if model == nil or not model:IsA("Model") then
		return
	end
	applyShown(model, shown)
end

local function rememberTransparency(model: Model)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") and desc.Name ~= "KeepOut" and desc.Name ~= "Root" then
			desc:SetAttribute("ShownTransparency", desc.Transparency)
		end
	end
end

local function tagPassenger(model: Model, def: Passengers.PassengerDef)
	model.Name = def.id
	model:SetAttribute("PassengerId", def.id)
	model:SetAttribute("Label", def.label)
	model:SetAttribute("Standing", def.standing)
	model:SetAttribute("Anomaly", def.anomaly)
	model:SetAttribute("Crowd", def.crowd)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc:SetAttribute("PassengerId", def.id)
		end
	end
end

local function addBox(model: Model, name: string, boxSize: Vector3, localPos: Vector3, color: Color3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = boxSize
	part.CFrame = CFrame.new(localPos)
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = true
	part.Parent = model
	return part
end

local function studs(metresLength: number): number
	return Constants.meters(metresLength)
end

-- Part figure facing local +Z, feet on the pivot. Seated laps sit near the bench.
local function buildFallback(def: Passengers.PassengerDef): Model
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Transparency = 1
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local s = Constants.STUDS_PER_METER
	if def.standing then
		for _, dx in { -0.09, 0.09 } do
			addBox(model, "Leg", Vector3.new(0.14 * s, 0.8 * s, 0.16 * s), Vector3.new(dx * s, 0.44 * s, 0), def.pants)
			addBox(model, "Shoe", Vector3.new(0.14 * s, 0.08 * s, 0.26 * s), Vector3.new(dx * s, 0.04 * s, 0.04 * s), Constants.COLOR.ink)
		end
		addBox(model, "Torso", Vector3.new(0.42 * s, 0.55 * s, 0.24 * s), Vector3.new(0, 1.12 * s, 0), def.shirt)
		addBox(model, "Arm", Vector3.new(0.12 * s, 0.5 * s, 0.12 * s), Vector3.new(-0.28 * s, 1.1 * s, 0), def.shirt)
		addBox(model, "Arm", Vector3.new(0.12 * s, 0.5 * s, 0.12 * s), Vector3.new(0.28 * s, 1.1 * s, 0), def.shirt)
		addBox(model, "Head", Vector3.new(0.26 * s, 0.28 * s, 0.26 * s), Vector3.new(0, 1.55 * s, 0), def.skin)
		addBox(model, "Hair", Vector3.new(0.28 * s, 0.12 * s, 0.28 * s), Vector3.new(0, 1.7 * s, 0), def.hair)
		if not def.anomaly then
			addBox(model, "Eye", Vector3.new(0.045 * s, 0.045 * s, 0.03 * s), Vector3.new(-0.06 * s, 1.57 * s, 0.14 * s), Constants.COLOR.ink)
			addBox(model, "Eye", Vector3.new(0.045 * s, 0.045 * s, 0.03 * s), Vector3.new(0.06 * s, 1.57 * s, 0.14 * s), Constants.COLOR.ink)
		end
	else
		addBox(model, "Shin", Vector3.new(0.13 * s, 0.42 * s, 0.14 * s), Vector3.new(-0.1 * s, 0.24 * s, 0.36 * s), def.pants)
		addBox(model, "Shin", Vector3.new(0.13 * s, 0.42 * s, 0.14 * s), Vector3.new(0.1 * s, 0.24 * s, 0.36 * s), def.pants)
		addBox(model, "Shoe", Vector3.new(0.13 * s, 0.08 * s, 0.22 * s), Vector3.new(-0.1 * s, 0.04 * s, 0.42 * s), Constants.COLOR.ink)
		addBox(model, "Shoe", Vector3.new(0.13 * s, 0.08 * s, 0.22 * s), Vector3.new(0.1 * s, 0.04 * s, 0.42 * s), Constants.COLOR.ink)
		addBox(model, "Lap", Vector3.new(0.38 * s, 0.16 * s, 0.4 * s), Vector3.new(0, 0.5 * s, 0.12 * s), def.pants)
		addBox(model, "Torso", Vector3.new(0.4 * s, 0.48 * s, 0.24 * s), Vector3.new(0, 0.92 * s, 0), def.shirt)
		addBox(model, "Head", Vector3.new(0.26 * s, 0.28 * s, 0.26 * s), Vector3.new(0, 1.32 * s, 0), def.skin)
		addBox(model, "Hair", Vector3.new(0.28 * s, 0.1 * s, 0.28 * s), Vector3.new(0, 1.46 * s, -0.02 * s), def.hair)
		if not def.anomaly then
			addBox(model, "Eye", Vector3.new(0.045 * s, 0.045 * s, 0.03 * s), Vector3.new(-0.06 * s, 1.34 * s, 0.14 * s), Constants.COLOR.ink)
			addBox(model, "Eye", Vector3.new(0.045 * s, 0.045 * s, 0.03 * s), Vector3.new(0.06 * s, 1.34 * s, 0.14 * s), Constants.COLOR.ink)
		end
	end

	model:SetAttribute("ModelSource", "fallback")
	return model
end

local function stripImported(model: Model)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BaseScript") or desc:IsA("Humanoid") or desc:IsA("Animator") or desc:IsA("AnimationController") then
			desc:Destroy()
		end
	end
end

local function wrapClone(source: Instance): Model?
	local clone = source:Clone()
	if clone:IsA("Model") then
		stripImported(clone)
		return clone
	end
	if clone:IsA("BasePart") then
		local model = Instance.new("Model")
		model.Name = source.Name
		clone.Parent = model
		return model
	end
	if clone:IsA("Folder") then
		local model = Instance.new("Model")
		model.Name = source.Name
		for _, child in clone:GetChildren() do
			child.Parent = model
		end
		clone:Destroy()
		stripImported(model)
		if #model:GetChildren() == 0 then
			model:Destroy()
			return nil
		end
		return model
	end
	clone:Destroy()
	return nil
end

local function hasParts(model: Model): boolean
	return model:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function scaleToHeight(model: Model, targetMetres: number): boolean
	local ok, boxSize = pcall(function(): Vector3
		local _, size = model:GetBoundingBox()
		return size
	end)
	if not ok or typeof(boxSize) ~= "Vector3" or boxSize.Y < 0.05 then
		return false
	end
	local scale = studs(targetMetres) / boxSize.Y
	if math.abs(scale - 1) < 0.02 then
		return true
	end
	local scaled = pcall(function()
		model:ScaleTo(scale)
	end)
	return scaled
end

-- glTF models face +Z. PivotTo turns local +Z onto `face` and puts the feet
-- on the floor point. A YawOffset attribute (degrees) on the imported model
-- adds to the web-game yaw when the FBX comes in backwards.
local function placeModel(model: Model, feetWorld: Vector3, ry: number)
	local pivot = model:GetPivot()
	local boxCf, boxSize = model:GetBoundingBox()
	local feetNow = Vector3.new(boxCf.Position.X, boxCf.Position.Y - boxSize.Y / 2, boxCf.Position.Z)
	local feetLocal = pivot:PointToObjectSpace(feetNow)
	local face = Vector3.new(math.sin(ry), 0, math.cos(ry))
	local rot = CFrame.lookAt(Vector3.zero, -face)
	local pos = feetWorld - rot:VectorToWorldSpace(feetLocal)
	model:PivotTo(CFrame.new(pos) * rot.Rotation)
end

local function addKeepOut(model: Model, feet: Vector3, passengerId: string)
	local radius = KeepOut.cylinderRadiusStuds()
	local height = studs(1.7)
	local cylinder = Instance.new("Part")
	cylinder.Name = "KeepOut"
	cylinder.Shape = Enum.PartType.Cylinder
	cylinder.Size = Vector3.new(height, radius * 2, radius * 2)
	cylinder.CFrame = CFrame.new(feet + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	cylinder.Anchored = true
	cylinder.Material = Enum.Material.SmoothPlastic
	cylinder.Transparency = 1
	cylinder.CanCollide = true
	cylinder.CanQuery = false
	cylinder.CanTouch = false
	cylinder.Parent = model
	cylinder:SetAttribute("PassengerId", passengerId)
end

local function prepareParts(model: Model)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CanTouch = false
			desc.CanQuery = desc.Name ~= "Root"
			desc.Massless = true
		end
	end
end

local attachProps: (Model, Passengers.PassengerDef) -> ()

local function buildPassenger(def: Passengers.PassengerDef, folder: Folder): string
	local template: Instance? = nil
	local modelsFolder = ReplicatedStorage:FindFirstChild("Models")
	if modelsFolder ~= nil then
		for _, name in Passengers.modelNames(def) do
			local found = modelsFolder:FindFirstChild(name)
			if found ~= nil then
				template = found
				break
			end
		end
	end

	local model: Model? = nil
	local source = "fallback"
	if template ~= nil then
		model = wrapClone(template)
		if model ~= nil and hasParts(model) then
			model.Parent = folder
			prepareParts(model)
			local targetHeight = if def.standing then 1.7 else 1.3
			if scaleToHeight(model, targetHeight) then
				source = "imported"
			else
				model:Destroy()
				model = nil
			end
		elseif model ~= nil then
			model:Destroy()
			model = nil
		end
	end

	local built: Model
	if model ~= nil then
		built = model
	else
		built = buildFallback(def)
		built.Parent = folder
		source = "fallback"
	end

	local yaw = def.ry
	if source == "imported" then
		local extra = built:GetAttribute("YawOffset")
		if typeof(extra) == "number" then
			yaw += math.rad(extra)
		end
	end

	local feet = metres(def.x, 0, def.z)
	placeModel(built, feet, yaw)
	prepareParts(built)
	tagPassenger(built, def)
	built:SetAttribute("ModelSource", source)
	rememberTransparency(built)

	if def.standing then
		addKeepOut(built, feet, def.id)
	end
	-- Crowd waits for crowded stretches. The far-seat anomaly waits for the
	-- mid-ride "extra" tell (Ride shows them, then clears on arrival).
	if def.crowd or def.anomaly then
		applyShown(built, false)
	end
	attachProps(built, def)

	local reported = def.modelName or def.id
	return if source == "imported" then reported else reported .. " (parts)"
end

local function findModel(name: string): Instance?
	local modelsFolder = ReplicatedStorage:FindFirstChild("Models")
	if modelsFolder == nil then
		return nil
	end
	return modelsFolder:FindFirstChild(name)
end

local PROP_ALIASES: { [string]: { string } } = {
	prop_phone = { "prop_phone", "Prop_Phone" },
	prop_phone_texter = { "prop_phone_texter", "Prop_PhoneTexter" },
	prop_tote_bag = { "prop_tote_bag", "Prop_ToteBag" },
	prop_backpack = { "prop_backpack", "Prop_Backpack" },
	prop_newspaper_folded = { "prop_newspaper_folded", "Prop_Newspaper" },
	prop_newspaper_open = { "prop_newspaper_open", "Prop_NewspaperOpen" },
}

attachProps = function(host: Model, def: Passengers.PassengerDef)
	local props = def.props
	if props == nil then
		return
	end
	local cf = host:GetPivot()
	for index, propName in props do
		local template: Instance? = nil
		local aliases = PROP_ALIASES[propName]
		if aliases == nil then
			template = findModel(propName)
		else
			for _, alias in aliases do
				template = findModel(alias)
				if template ~= nil then
					break
				end
			end
		end
		if template == nil then
			continue
		end
		local clone = template:Clone()
		local propModel: Model
		if clone:IsA("Model") then
			propModel = clone
		elseif clone:IsA("BasePart") then
			propModel = Instance.new("Model")
			clone.Parent = propModel
		else
			clone:Destroy()
			continue
		end
		propModel.Name = propName
		propModel.Parent = host
		prepareParts(propModel)
		local _, size = propModel:GetBoundingBox()
		local target = if string.find(propName, "phone", 1, true)
			then Constants.meters(0.14)
			elseif string.find(propName, "tote", 1, true) then Constants.meters(0.47)
			elseif string.find(propName, "backpack", 1, true) then Constants.meters(0.36)
			elseif string.find(propName, "open", 1, true) then Constants.meters(0.2)
			else Constants.meters(0.26)
		if size.Y > 0.001 then
			pcall(function()
				propModel:ScaleTo(target / size.Y)
			end)
		end
		local side = (index - 1) * 0.18
		local localOffset = if string.find(propName, "backpack", 1, true)
			then Vector3.new(side, 0.95, -0.22)
			elseif string.find(propName, "tote", 1, true) then Vector3.new(0.22, 0.45, 0.05)
			elseif string.find(propName, "newspaper", 1, true) then Vector3.new(0.12, 0.9, 0.18)
			else Vector3.new(0.08, 0.85, 0.2)
		local world = cf.Position + cf:VectorToWorldSpace(localOffset * Constants.STUDS_PER_METER)
		propModel:PivotTo(CFrame.new(world) * cf.Rotation)
	end
end

local function buildDoorLeaf(parent: Instance, xMetres: number, zMetres: number, side: number, doors: { DoorLeaf })
	local doorModel = Instance.new("Model")
	doorModel.Name = "DoorLeaf"
	doorModel.Parent = parent
	local x0 = Constants.meters(xMetres)
	local y = Constants.meters(1)
	local z = Constants.meters(zMetres)
	local leaf = makePart({
		name = "Leaf",
		parent = doorModel,
		size = sizeM(0.66, 2, 0.05),
		cframe = CFrame.new(x0, y, z),
		color = Constants.COLOR.door,
		collide = false,
	})
	makePart({
		name = "Window",
		parent = doorModel,
		size = sizeM(0.3, 0.62, 0.03),
		cframe = CFrame.new(x0, y + Constants.meters(0.36), z),
		color = Constants.COLOR.dark,
		transparency = 0.45,
		collide = false,
	})
	doorModel.PrimaryPart = leaf
	table.insert(doors, {
		model = doorModel,
		x0 = x0,
		y = y,
		z = z,
		side = side,
	})
end

local function doorSide(key: string): number
	-- Leaves open away from the gap. W48 and E42 carry the inner edge on +X.
	if string.find(key, "W48", 1, true) or string.find(key, "E42", 1, true) then
		return -1
	end
	return 1
end

local function adoptModeledCar(car: Model): ({ DoorLeaf }?, { Lamp }?)
	local template = findModel("Car_B") or findModel("car_B_interior")
	if template == nil then
		return nil, nil
	end
	local clone = template:Clone()
	local model: Model
	if clone:IsA("Model") then
		model = clone
	elseif clone:IsA("BasePart") then
		model = Instance.new("Model")
		clone.Parent = model
	else
		model = Instance.new("Model")
		if clone:IsA("Folder") then
			for _, child in clone:GetChildren() do
				child.Parent = model
			end
			clone:Destroy()
		else
			clone:Destroy()
			return nil, nil
		end
	end
	model.Name = "Car_B"
	model.Parent = car
	if not hasParts(model) then
		model:Destroy()
		return nil, nil
	end
	local ok, boxSize = pcall(function(): Vector3
		local _, size = model:GetBoundingBox()
		return size
	end)
	if not ok or typeof(boxSize) ~= "Vector3" then
		model:Destroy()
		return nil, nil
	end
	local longest = math.max(boxSize.X, boxSize.Z)
	local target = Constants.meters(18.09)
	if longest > 0.05 then
		local scaled = pcall(function()
			model:ScaleTo(target / longest)
		end)
		if not scaled then
			model:Destroy()
			return nil, nil
		end
	end
	local boxCf, sized = model:GetBoundingBox()
	local bottom = boxCf.Position.Y - sized.Y / 2
	model:PivotTo(model:GetPivot() + Vector3.new(0, Constants.meters(-0.06) - bottom, 0))

	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CanTouch = false
			desc.CanQuery = false
			desc.Massless = true
			if string.match(desc.Name, "^LightStrip_%d+") then
				desc.Material = Enum.Material.Neon
				desc.Color = Constants.COLOR.lightOn
			end
		end
	end

	local groups: { [string]: { BasePart } } = {}
	local order: { string } = {}
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			local key = string.match(desc.Name, "^(DoorLeaf_[^_]+_%d+)")
			if key ~= nil then
				if groups[key] == nil then
					groups[key] = {}
					table.insert(order, key)
				end
				table.insert(groups[key], desc)
			end
		end
	end
	local doors: { DoorLeaf } = {}
	for _, key in order do
		local group = Instance.new("Model")
		group.Name = key
		group.Parent = model
		local parts = groups[key]
		for _, part in parts do
			part.Parent = group
		end
		local pivot = group:GetPivot()
		table.insert(doors, {
			model = group,
			x0 = pivot.Position.X,
			y = pivot.Position.Y,
			z = pivot.Position.Z,
			side = doorSide(key),
		})
	end

	local lamps: { Lamp } = {}
	local lightIndex = 0
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") and string.match(desc.Name, "^LightStrip_%d+") then
			local point: PointLight? = nil
			if lightIndex % 3 == 0 then
				local glow = Instance.new("PointLight")
				glow.Name = "Glow"
				glow.Color = Constants.COLOR.lamp
				glow.Brightness = Constants.LAMP_BRIGHTNESS
				glow.Range = Constants.meters(Constants.LAMP_RANGE_M)
				glow.Shadows = true
				glow.Parent = desc
				point = glow
			end
			local lamp: Lamp = { part = desc, light = point }
			table.insert(lamps, lamp)
			lightIndex += 1
		end
	end
	if #doors == 0 or #lamps == 0 then
		model:Destroy()
		return nil, nil
	end
	return doors, lamps
end

local function hidePartCarVisuals(car: Model)
	local keepCollider = {
		Floor = true,
		SeatLip = true,
		DoorSeal = true,
		ShellWall = true,
		Bulkhead = true,
		GangwayDoor = true,
		FrontGangwayDoor = true,
		RearGangwayDoor = true,
		Lintel = true,
		Ceiling = true,
	}
	for _, folderName in { "Shell", "Seats", "Doors", "Poles", "Lights" } do
		local folder = car:FindFirstChild(folderName)
		if folder ~= nil then
			for _, desc in folder:GetDescendants() do
				if desc:IsA("BasePart") then
					desc.Transparency = 1
					if not keepCollider[desc.Name] then
						desc.CanCollide = false
					end
					local glow = desc:FindFirstChild("Glow")
					if glow ~= nil and glow:IsA("PointLight") then
						glow.Enabled = false
					end
				end
			end
		end
	end
end

function CarBuilder.build(): BuiltCar
	local car = Instance.new("Model")
	car.Name = "SubwayCar"

	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	shell.Parent = car
	local seats = Instance.new("Folder")
	seats.Name = "Seats"
	seats.Parent = car
	local doorFolder = Instance.new("Folder")
	doorFolder.Name = "Doors"
	doorFolder.Parent = car
	local poleFolder = Instance.new("Folder")
	poleFolder.Name = "Poles"
	poleFolder.Parent = car
	local lightFolder = Instance.new("Folder")
	lightFolder.Name = "Lights"
	lightFolder.Parent = car
	local passengers = Instance.new("Folder")
	passengers.Name = "Passengers"
	passengers.Parent = car

	makePart({
		name = "Floor",
		parent = shell,
		size = sizeM(18, 0.4, 3.06),
		cframe = CFrame.new(metres(0, -0.2, 0)),
		color = Constants.COLOR.floor,
		material = Enum.Material.Concrete,
	})
	-- Closes the window band so a walk can't leave the car. Invisible.
	for _, side in { -1, 1 } do
		makePart({
			name = "ShellWall",
			parent = shell,
			size = sizeM(18.2, 2.5, 0.08),
			cframe = CFrame.new(metres(0, 1.25, side * 1.58)),
			transparency = 1,
		})
	end
	makePart({
		name = "Ceiling",
		parent = shell,
		size = sizeM(18, 0.08, 3.06),
		cframe = CFrame.new(metres(0, 2.46, 0)),
		color = Constants.COLOR.ceiling,
		material = Enum.Material.Concrete,
	})

	for _, side in { -1, 1 } do
		local z = side * 1.53
		makePart({
			name = "Kickboard",
			parent = shell,
			size = sizeM(18, 0.9, 0.08),
			cframe = CFrame.new(metres(0, 0.45, z)),
			color = Constants.COLOR.lowWall,
			material = Enum.Material.Concrete,
		})
		makePart({
			name = "UpperWall",
			parent = shell,
			size = sizeM(18, 0.7, 0.08),
			cframe = CFrame.new(metres(0, 2.05, z)),
			color = Constants.COLOR.wall,
			material = Enum.Material.Concrete,
		})
		for i = 0, 9 do
			local x = -8.55 + i * 1.9
			makePart({
				name = "Mullion",
				parent = shell,
				size = sizeM(0.08, 0.85, 0.08),
				cframe = CFrame.new(metres(x, 1.325, z)),
				color = Constants.COLOR.wall,
				material = Enum.Material.Concrete,
				collide = false,
			})
		end
		if side < 0 then
			makePart({
				name = "Ad_Across_0_GREENPOINTSAVINGS",
				parent = shell,
				size = sizeM(1.3, 0.41, 0.04),
				cframe = CFrame.new(metres(-6.2, 2.02, z + 0.06)),
				color = Color3.fromRGB(20, 60, 43),
				collide = false,
			})
		end
		makePart({
			name = "Glass",
			parent = shell,
			size = sizeM(18, 0.85, 0.02),
			cframe = CFrame.new(metres(0, 1.325, z - side * 0.03)),
			color = Constants.COLOR.glass,
			transparency = 0.86,
			collide = false,
		})

		local spans = { { -8.85, -5.25 }, { -3.75, 3.75 }, { 5.25, 8.85 } }
		for index, span in spans do
			local a = span[1]
			local b = span[2]
			local length = b - a
			local cx = (a + b) / 2
			local color = if index % 2 == 1 then Constants.COLOR.seatOrange else Constants.COLOR.seatYellow
			makePart({
				name = "Cushion",
				parent = seats,
				size = sizeM(length, 0.09, 0.46),
				cframe = CFrame.new(metres(cx, 0.455, side * 1.25)),
				color = color,
			})
			makePart({
				name = "Back",
				parent = seats,
				size = sizeM(length, 0.5, 0.08),
				cframe = CFrame.new(metres(cx, 0.76, side * 1.47)),
				color = color,
			})
			makePart({
				name = "Riser",
				parent = seats,
				size = sizeM(length, 0.41, 0.36),
				cframe = CFrame.new(metres(cx, 0.205, side * 1.3)),
				color = Constants.COLOR.underSeat,
			})
			-- Invisible full-height lip so the player stays in the aisle.
			makePart({
				name = "SeatLip",
				parent = seats,
				size = sizeM(length, 2.2, 0.06),
				cframe = CFrame.new(metres(cx, 1.1, side * 1.02)),
				color = Constants.COLOR.underSeat,
				transparency = 1,
			})
		end

		makePart({
			name = "GrabBar",
			parent = poleFolder,
			size = sizeM(17.6, 0.04, 0.04),
			cframe = CFrame.new(metres(0, 2.02, side * 0.98)),
			color = Constants.COLOR.steel,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
			collide = false,
		})
		for _, x in { -5.3, -3.7, 3.7, 5.3 } do
			makePart({
				name = "Pole",
				parent = poleFolder,
				size = Vector3.new(Constants.meters(2.42), Constants.meters(0.045), Constants.meters(0.045)),
				cframe = CFrame.new(metres(x, 1.21, side * 0.98)) * CFrame.Angles(0, 0, math.rad(90)),
				color = Constants.COLOR.steel,
				material = Enum.Material.Metal,
				shape = Enum.PartType.Cylinder,
				collide = false,
			})
		end
	end

	local doors: { DoorLeaf } = {}
	for _, x in { -4.5, 4.5 } do
		for _, side in { -1, 1 } do
			local x0 = x + side * 0.335
			buildDoorLeaf(doorFolder, x0, -1.485, side, doors)
		end
		makePart({
			name = "DoorHeader",
			parent = doorFolder,
			size = sizeM(1.4, 0.08, 0.1),
			cframe = CFrame.new(metres(x, 2.04, -1.5)),
			color = Constants.COLOR.lowWall,
			collide = false,
		})
		makePart({
			name = "NearDoor",
			parent = doorFolder,
			size = sizeM(1.34, 2, 0.06),
			cframe = CFrame.new(metres(x, 1, 1.485)),
			color = Constants.COLOR.door,
			collide = false,
		})
		for _, dx in { -0.3, 0.3 } do
			makePart({
				name = "NearDoorWindow",
				parent = doorFolder,
				size = sizeM(0.34, 0.62, 0.03),
				cframe = CFrame.new(metres(x + dx, 1.36, 1.5)),
				color = Constants.COLOR.dark,
				transparency = 0.45,
				collide = false,
			})
		end
		for _, side in { -1, 1 } do
			makePart({
				name = "DoorSeal",
				parent = shell,
				size = sizeM(1.55, 2.5, 0.1),
				cframe = CFrame.new(metres(x, 1.25, side * 1.66)),
				transparency = 1,
			})
		end
	end

	for _, x in { -9, 9 } do
		makePart({
			name = "Bulkhead",
			parent = shell,
			size = sizeM(0.1, 2.46, 1.05),
			cframe = CFrame.new(metres(x, 1.23, -0.98)),
			color = Constants.COLOR.wall,
			material = Enum.Material.Concrete,
		})
		makePart({
			name = "Bulkhead",
			parent = shell,
			size = sizeM(0.1, 2.46, 1.05),
			cframe = CFrame.new(metres(x, 1.23, 0.98)),
			color = Constants.COLOR.wall,
			material = Enum.Material.Concrete,
		})
		makePart({
			name = "Lintel",
			parent = shell,
			size = sizeM(0.1, 0.42, 1),
			cframe = CFrame.new(metres(x, 2.25, 0)),
			color = Constants.COLOR.wall,
			material = Enum.Material.Concrete,
		})
		-- Consist wires ProximityPrompt open/close. Closed until the player opens.
		makePart({
			name = if x < 0 then "FrontGangwayDoor" else "RearGangwayDoor",
			parent = shell,
			size = sizeM(0.12, 2.15, 0.96),
			cframe = CFrame.new(metres(x, 1.08, 0)),
			color = Constants.COLOR.door,
		})
	end

	local lamps: { Lamp } = {}
	local stripIndex = 0
	for _, z in { -0.62, 0.62 } do
		for i = 0, 5 do
			local x = -7.25 + i * 2.9
			local strip = makePart({
				name = string.format("LightStrip_%02d", stripIndex),
				parent = lightFolder,
				size = sizeM(2.7, 0.04, 0.18),
				cframe = CFrame.new(metres(x, 2.38, z)),
				color = Constants.COLOR.lightOn,
				material = Enum.Material.Neon,
				collide = false,
			})
			local stripLamp: Lamp = { part = strip, light = nil }
			table.insert(lamps, stripLamp)
			stripIndex += 1
		end
	end
	for _, x in { -6, -2, 2, 6 } do
		local anchor = makePart({
			name = "CeilingLight",
			parent = lightFolder,
			size = Vector3.new(0.3, 0.3, 0.3),
			cframe = CFrame.new(metres(x, 2.2, 0)),
			color = Constants.COLOR.lightOn,
			transparency = 1,
			collide = false,
		})
		local point = Instance.new("PointLight")
		point.Name = "Glow"
		point.Color = Constants.COLOR.lamp
		point.Brightness = Constants.LAMP_BRIGHTNESS
		point.Range = Constants.meters(Constants.LAMP_RANGE_M)
		point.Shadows = true
		point.Parent = anchor
		local anchorLamp: Lamp = { part = anchor, light = point }
		table.insert(lamps, anchorLamp)
	end

	local board = Instance.new("SpawnLocation")
	board.Name = "Board"
	board.Size = Vector3.new(3, 0.4, 3)
	board.CFrame = CFrame.new(metres(0, 0.25, 0.4))
	board.Anchored = true
	board.CanCollide = false
	board.Transparency = 1
	board.Duration = 0
	board.Neutral = true
	board.Parent = car

	car.Parent = workspace

	local imported: { string } = {}
	local fallback: { string } = {}
	for _, def in Passengers.LIST do
		local note = buildPassenger(def, passengers)
		if string.find(note, "parts", 1, true) then
			table.insert(fallback, note)
		else
			table.insert(imported, note)
		end
	end
	local meshDoors, meshLamps = adoptModeledCar(car)
	if meshDoors ~= nil and meshLamps ~= nil then
		doors = meshDoors
		lamps = meshLamps
		hidePartCarVisuals(car)
		print("[Last Local] Using modeled Car_B. Part shell stays as invisible collision.")
	end

	-- One summary. Missing Models is expected until FBX import; do not warn/spam.
	if #imported > 0 and #fallback == 0 then
		print(string.format("[Last Local] Passenger meshes: %s", table.concat(imported, ", ")))
	elseif #imported > 0 then
		print(
			string.format(
				"[Last Local] Passenger meshes: %d imported, %d Part figures (%s).",
				#imported,
				#fallback,
				table.concat(fallback, ", ")
			)
		)
	else
		print(
			"[Last Local] Passenger meshes: none in ReplicatedStorage.Models — using Part figures. See README → Put your characters in the car."
		)
	end
	local riding = 0
	for _, child in passengers:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("Hidden") ~= true then
			riding += 1
		end
	end
	-- mom, dad, and the three strangers. Crowd and the far-seat extra stay hidden.
	if riding < 5 then
		warn(string.format("[Last Local] Only %d passengers are in the car; the fallback figures did not all spawn.", riding))
	end

	local built: BuiltCar = {
		model = car,
		doors = doors,
		lamps = lamps,
		passengers = passengers,
		board = board,
	}
	Consist.attach({
		model = car,
		passengers = passengers,
		spawnPassenger = buildPassenger,
	})
	return built
end

function CarBuilder.spawnPassenger(def: Passengers.PassengerDef, folder: Folder): string
	return buildPassenger(def, folder)
end

-- Two plates on the wall. Hidden until a tell is active. The player flags
-- one the same way as a passenger: look at it and hold Flag. They are not
-- crowd, so the crowd toggle leaves them alone.
function CarBuilder.addTells(folder: Folder, announceId: string, announceLabel: string, boardId: string, boardLabel: string)
	local function plate(id: string, label: string, kind: string, x: number)
		local model = Instance.new("Model")
		model.Name = id
		model:SetAttribute("PassengerId", id)
		model:SetAttribute("Label", label)
		model:SetAttribute("Anomaly", false)
		model:SetAttribute("Hidden", true)
		model:SetAttribute("Tell", kind)
		model:SetAttribute("Crowd", false)
		local part = Instance.new("Part")
		part.Name = "Sign"
		part.Anchored = true
		part.Size = sizeM(0.72, 0.28, 0.04)
		part.CFrame = CFrame.new(metres(x, 1.55, -1.36))
		part.Color = Constants.COLOR.dark
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Transparency = 1
		part:SetAttribute("PassengerId", id)
		part.Parent = model
		model.PrimaryPart = part
		model:PivotTo(part.CFrame)
		model.Parent = folder
	end
	plate(announceId, announceLabel, "wrong_announcement", 0.2)
	plate(boardId, boardLabel, "wrong_countdown", 1.15)
end

local function catalogPlate(
	folder: Folder,
	id: string,
	label: string,
	kind: string,
	x: number,
	y: number,
	z: number,
	size: Vector3,
	color: Color3,
	hidden: boolean
): Model
	local model = Instance.new("Model")
	model.Name = id
	model:SetAttribute("PassengerId", id)
	model:SetAttribute("Label", label)
	model:SetAttribute("Anomaly", false)
	model:SetAttribute("Hidden", hidden)
	model:SetAttribute("Tell", kind)
	model:SetAttribute("Crowd", false)
	local part = Instance.new("Part")
	part.Name = "Sign"
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new(metres(x, y, z))
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = not hidden
	part.Transparency = if hidden then 1 else 0
	part:SetAttribute("PassengerId", id)
	part.Parent = model
	model.PrimaryPart = part
	model:PivotTo(part.CFrame)
	model.Parent = folder
	return model
end

local function surfaceLabel(part: BasePart, text: string, textSize: number)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.MaxDistance = 80
	gui.CanvasSize = Vector2.new(256, 64)
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Constants.COLOR.cream
	label.TextScaled = false
	label.TextSize = textSize
	label.Text = text
	label.TextWrapped = true
	label.Parent = gui
end

-- Props for the expanded catalog. Close-look ones sit within NEAR_X of the seat.
function CarBuilder.addCatalogProps(folder: Folder)
	local nearX = AnomalySystem.pickNearSlot(2)

	-- Window sticker / stain (hidden until active).
	local sticker = catalogPlate(
		folder,
		AnomalySystem.STICKER_ID,
		"the window sticker",
		"sticker",
		nearX,
		1.35,
		-1.48,
		sizeM(0.28, 0.28, 0.02),
		Color3.fromRGB(240, 210, 40),
		true
	)
	sticker:SetAttribute("Catalog", "sticker")

	-- Route map (always visible; text swaps when mapstop is live).
	local map = catalogPlate(
		folder,
		AnomalySystem.MAP_ID,
		"the route map",
		"mapstop",
		-1.2,
		1.7,
		-1.4,
		sizeM(1.1, 0.55, 0.04),
		Color3.fromRGB(20, 28, 24),
		false
	)
	map:SetAttribute("Catalog", "mapstop")
	local mapPart = map.PrimaryPart
	if mapPart ~= nil then
		surfaceLabel(mapPart, "G · Hoyt–Schermerhorn → Court Sq", 14)
	end

	-- Ad that can warp (near only). Visible always; text swaps on nearword.
	local ad = catalogPlate(
		folder,
		AnomalySystem.NEARWORD_ID,
		"the warped ad",
		"nearword",
		nearX,
		2.02,
		-1.4,
		sizeM(1.0, 0.36, 0.04),
		Color3.fromRGB(20, 60, 43),
		false
	)
	ad:SetAttribute("Catalog", "nearword")
	local adPart = ad.PrimaryPart
	if adPart ~= nil then
		surfaceLabel(adPart, "GREENPOINT SAVINGS", 16)
	end

	-- Empty-car tell plate (hidden until empty is live).
	catalogPlate(
		folder,
		AnomalySystem.EMPTY_ID,
		"the empty car",
		"empty",
		0,
		1.2,
		0,
		sizeM(0.4, 0.4, 0.4),
		Constants.COLOR.dark,
		true
	)

	-- Cold-light tell: ties to a near LightStrip by name attribute for Ride.
	local light = catalogPlate(
		folder,
		AnomalySystem.LIGHT_ID,
		"the cold light",
		"lighttemp",
		2.0,
		2.35,
		-0.62,
		sizeM(0.5, 0.08, 0.2),
		Constants.COLOR.dark,
		true
	)
	light:SetAttribute("Catalog", "lighttemp")
	light:SetAttribute("StripName", "LightStrip_02")
end

return CarBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Consist</string>
          <string name="Source"><![CDATA[--!strict
-- Cars A (lead) and C (rear) plus walkable gangways. Layout matches
-- subwayCarBuilder.buildAdjacentCars / buildGangways (centres ±19.5 m).
-- Part shells are the default; Models.Car_A / Car_C are optional visuals.
-- Anomalies stay on Car B. Trestle stays out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Passengers = require(ReplicatedStorage.Shared.Passengers)

local Consist = {}

type BuiltCar = {
	model: Model,
	passengers: Folder,
	spawnPassenger: (Passengers.PassengerDef, Folder) -> string,
}

local function metres(x: number, y: number, z: number): Vector3
	local s = Constants.STUDS_PER_METER
	return Vector3.new(x * s, y * s, z * s)
end

local function sizeM(x: number, y: number, z: number): Vector3
	return metres(x, y, z)
end

local function makePart(opts: {
	name: string,
	parent: Instance,
	size: Vector3,
	cframe: CFrame,
	color: Color3?,
	material: Enum.Material?,
	transparency: number?,
	collide: boolean?,
	shape: Enum.PartType?,
}): Part
	local part = Instance.new("Part")
	part.Name = opts.name
	part.Anchored = true
	part.Size = opts.size
	part.CFrame = opts.cframe
	part.Color = opts.color or Constants.COLOR.wall
	part.Material = opts.material or Enum.Material.SmoothPlastic
	part.Transparency = opts.transparency or 0
	part.CanCollide = if opts.collide == nil then true else opts.collide
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if opts.shape ~= nil then
		part.Shape = opts.shape
	end
	part.Parent = opts.parent
	return part
end

local function tryVisualCar(name: string, parent: Model, centerX: number): boolean
	local models = ReplicatedStorage:FindFirstChild("Models")
	if models == nil then
		return false
	end
	local template = models:FindFirstChild(name) or models:FindFirstChild(string.lower(name))
	if template == nil or not template:IsA("Model") then
		return false
	end
	local clone = template:Clone()
	clone.Name = name .. "_Mesh"
	for _, desc in clone:GetDescendants() do
		if desc:IsA("BasePart") then
			desc.Anchored = true
			desc.CanCollide = false
			desc.CanTouch = false
			desc.Massless = true
		elseif desc:IsA("BaseScript") or desc:IsA("Humanoid") then
			desc:Destroy()
		end
	end
	clone.Parent = parent
	local ok = pcall(function()
		clone:PivotTo(CFrame.new(metres(centerX, 0, 0)))
	end)
	if not ok then
		clone:Destroy()
		return false
	end
	return true
end

local function buildShell(name: string, centerX: number, benchSpans: { { number } }, poleXs: { number }, lightXs: { number }, gangwayX: number, cabX: number): Model
	local car = Instance.new("Model")
	car.Name = name

	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	shell.Parent = car
	local seats = Instance.new("Folder")
	seats.Name = "Seats"
	seats.Parent = car
	local poleFolder = Instance.new("Folder")
	poleFolder.Name = "Poles"
	poleFolder.Parent = car
	local lightFolder = Instance.new("Folder")
	lightFolder.Name = "Lights"
	lightFolder.Parent = car

	makePart({
		name = "Floor",
		parent = shell,
		size = sizeM(18, 0.4, 3.06),
		cframe = CFrame.new(metres(centerX, -0.2, 0)),
		color = Constants.COLOR.floor,
		material = Enum.Material.Concrete,
	})
	for _, side in { -1, 1 } do
		makePart({
			name = "ShellWall",
			parent = shell,
			size = sizeM(18.2, 2.5, 0.08),
			cframe = CFrame.new(metres(centerX, 1.25, side * 1.58)),
			transparency = 1,
		})
	end
	makePart({
		name = "Ceiling",
		parent = shell,
		size = sizeM(18, 0.08, 3.06),
		cframe = CFrame.new(metres(centerX, 2.46, 0)),
		color = Constants.COLOR.ceiling,
		material = Enum.Material.Concrete,
	})

	for _, side in { -1, 1 } do
		local z = side * 1.53
		makePart({
			name = "Kickboard",
			parent = shell,
			size = sizeM(18, 0.9, 0.08),
			cframe = CFrame.new(metres(centerX, 0.45, z)),
			color = Constants.COLOR.lowWall,
			material = Enum.Material.Concrete,
		})
		makePart({
			name = "UpperWall",
			parent = shell,
			size = sizeM(18, 0.7, 0.08),
			cframe = CFrame.new(metres(centerX, 2.05, z)),
			color = Constants.COLOR.wall,
			material = Enum.Material.Concrete,
		})
		makePart({
			name = "Glass",
			parent = shell,
			size = sizeM(18, 0.85, 0.02),
			cframe = CFrame.new(metres(centerX, 1.325, z - side * 0.03)),
			color = Constants.COLOR.glass,
			transparency = 0.86,
			collide = false,
		})

		for index, span in benchSpans do
			local a = span[1]
			local b = span[2]
			local length = b - a
			local cx = (a + b) / 2
			local color = if index % 2 == 1 then Constants.COLOR.seatOrange else Constants.COLOR.seatYellow
			makePart({
				name = "Cushion",
				parent = seats,
				size = sizeM(length, 0.09, 0.46),
				cframe = CFrame.new(metres(cx, 0.455, side * 1.25)),
				color = color,
			})
			makePart({
				name = "Back",
				parent = seats,
				size = sizeM(length, 0.5, 0.08),
				cframe = CFrame.new(metres(cx, 0.76, side * 1.47)),
				color = color,
			})
			makePart({
				name = "Riser",
				parent = seats,
				size = sizeM(length, 0.41, 0.36),
				cframe = CFrame.new(metres(cx, 0.205, side * 1.3)),
				color = Constants.COLOR.underSeat,
			})
			makePart({
				name = "SeatLip",
				parent = seats,
				size = sizeM(length, 2.2, 0.06),
				cframe = CFrame.new(metres(cx, 1.1, side * 1.02)),
				color = Constants.COLOR.underSeat,
				transparency = 1,
			})
		end

		makePart({
			name = "GrabBar",
			parent = poleFolder,
			size = sizeM(17.6, 0.04, 0.04),
			cframe = CFrame.new(metres(centerX, 2.02, side * 0.98)),
			color = Constants.COLOR.steel,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
			collide = false,
		})
		for _, x in poleXs do
			makePart({
				name = "Pole",
				parent = poleFolder,
				size = Vector3.new(Constants.meters(2.42), Constants.meters(0.045), Constants.meters(0.045)),
				cframe = CFrame.new(metres(x, 1.21, side * 0.98)) * CFrame.Angles(0, 0, math.rad(90)),
				color = Constants.COLOR.steel,
				material = Enum.Material.Metal,
				shape = Enum.PartType.Cylinder,
				collide = false,
			})
		end
	end

	-- Gangway doorway bulkheads (opening in the aisle).
	makePart({
		name = "Bulkhead",
		parent = shell,
		size = sizeM(0.1, 2.46, 1.05),
		cframe = CFrame.new(metres(gangwayX, 1.23, -0.98)),
		color = Constants.COLOR.wall,
		material = Enum.Material.Concrete,
	})
	makePart({
		name = "Bulkhead",
		parent = shell,
		size = sizeM(0.1, 2.46, 1.05),
		cframe = CFrame.new(metres(gangwayX, 1.23, 0.98)),
		color = Constants.COLOR.wall,
		material = Enum.Material.Concrete,
	})
	makePart({
		name = "Lintel",
		parent = shell,
		size = sizeM(0.1, 0.42, 1),
		cframe = CFrame.new(metres(gangwayX, 2.25, 0)),
		color = Constants.COLOR.wall,
		material = Enum.Material.Concrete,
	})

	-- Cab bulkhead (closed end).
	makePart({
		name = "CabWall",
		parent = shell,
		size = sizeM(0.1, 2.46, 3.06),
		cframe = CFrame.new(metres(cabX, 1.23, 0)),
		color = Constants.COLOR.wall,
		material = Enum.Material.Concrete,
	})
	makePart({
		name = "CabDoor",
		parent = shell,
		size = sizeM(0.12, 1.8, 0.8),
		cframe = CFrame.new(metres(cabX, 1.0, 0)),
		color = Constants.COLOR.dark,
		collide = false,
	})

	for _, x in lightXs do
		local anchor = makePart({
			name = "CeilingLight",
			parent = lightFolder,
			size = Vector3.new(0.3, 0.3, 0.3),
			cframe = CFrame.new(metres(x, 2.2, 0)),
			color = Constants.COLOR.lightOn,
			transparency = 1,
			collide = false,
		})
		local point = Instance.new("PointLight")
		point.Name = "Glow"
		point.Color = Constants.COLOR.lamp
		point.Brightness = Constants.LAMP_BRIGHTNESS
		point.Range = Constants.meters(Constants.LAMP_RANGE_M)
		point.Shadows = true
		point.Parent = anchor
	end

	car.Parent = workspace
	return car
end

local function buildGangway(parent: Folder, centerX: number)
	local bellows = Color3.fromRGB(22, 24, 26)
	local tread = Color3.fromRGB(68, 70, 72)
	local chain = Color3.fromRGB(150, 152, 154)

	makePart({
		name = "Plate",
		parent = parent,
		size = sizeM(1.5, 0.08, 1.02),
		cframe = CFrame.new(metres(centerX, -0.02, 0)),
		color = tread,
		material = Enum.Material.Metal,
	})
	makePart({
		name = "Roof",
		parent = parent,
		size = sizeM(1.5, 0.08, 1.08),
		cframe = CFrame.new(metres(centerX, 2.22, 0)),
		color = bellows,
		collide = false,
	})
	for _, z in { -0.54, 0.54 } do
		for i = 0, 6 do
			makePart({
				name = "Pleat",
				parent = parent,
				size = sizeM(0.12, 2.2, 0.05),
				cframe = CFrame.new(metres(centerX - 0.6 + i * 0.2, 1.1, z)),
				color = bellows,
			})
		end
		makePart({
			name = "Rail",
			parent = parent,
			size = sizeM(1.48, 0.03, 0.03),
			cframe = CFrame.new(metres(centerX, 1.0, z * 0.9)),
			color = chain,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
			collide = false,
		})
		makePart({
			name = "Rail",
			parent = parent,
			size = sizeM(1.48, 0.025, 0.025),
			cframe = CFrame.new(metres(centerX, 0.55, z * 0.9)),
			color = chain,
			material = Enum.Material.Metal,
			shape = Enum.PartType.Cylinder,
			collide = false,
		})
	end
end

local closedFrames: { [BasePart]: CFrame } = {}

local function setDoorOpen(part: BasePart, open: boolean, isFront: boolean)
	local closed = closedFrames[part]
	if closed == nil then
		return
	end
	part:SetAttribute("Open", open)
	if open then
		local yaw = if isFront then 1.35 else -1.35
		-- Hinge at the −Z edge of the leaf (web pivot).
		local hinge = closed * CFrame.new(0, 0, -part.Size.Z / 2)
		part.CFrame = hinge * CFrame.Angles(0, yaw, 0) * CFrame.new(0, 0, part.Size.Z / 2)
		part.CanCollide = false
	else
		part.CFrame = closed
		part.CanCollide = true
	end
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt ~= nil then
		prompt.ActionText = if open then "Close" else "Open"
	end
end

local function wireGangwayDoor(part: BasePart, isFront: boolean)
	if part:GetAttribute("GangwayWired") == true then
		return
	end
	closedFrames[part] = part.CFrame
	part.Name = if isFront then "FrontGangwayDoor" else "RearGangwayDoor"
	part:SetAttribute("Gangway", if isFront then "front" else "rear")
	part:SetAttribute("Open", false)
	part:SetAttribute("GangwayWired", true)
	part.CanCollide = true

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GangwayPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = "Gangway door"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Constants.meters(2.8)
	prompt.RequiresLineOfSight = false
	prompt.Parent = part

	prompt.Triggered:Connect(function()
		local open = part:GetAttribute("Open") == true
		setDoorOpen(part, not open, isFront)
	end)
end

local function wireCarBDoors(carModel: Model)
	-- Prefer named Part shell doors; fall back to legacy GangwayDoor meshes.
	local front: BasePart? = nil
	local rear: BasePart? = nil
	for _, desc in carModel:GetDescendants() do
		if desc:IsA("BasePart") then
			if desc.Name == "FrontGangwayDoor" then
				front = desc
			elseif desc.Name == "RearGangwayDoor" then
				rear = desc
			end
		end
	end
	if front == nil or rear == nil then
		for _, desc in carModel:GetDescendants() do
			if desc:IsA("BasePart") and desc.Name == "GangwayDoor" then
				local x = desc.Position.X / Constants.STUDS_PER_METER
				if x < 0 and front == nil then
					front = desc
				elseif x >= 0 and rear == nil then
					rear = desc
				end
			end
		end
	end
	if front ~= nil then
		wireGangwayDoor(front, true)
	end
	if rear ~= nil then
		wireGangwayDoor(rear, false)
	end
end

function Consist.attach(car: BuiltCar)
	local carA = buildShell(
		"Car_A",
		-19.5,
		{ { -27.5, -23.5 }, { -22.5, -16.5 }, { -15.5, -11.5 } },
		{ -24.0, -15.0 },
		{ -25.5, -21.5, -17.5, -13.5 },
		-10.5,
		-28.5
	)
	local carC = buildShell(
		"Car_C",
		19.5,
		{ { 11.5, 15.5 }, { 16.5, 22.5 }, { 23.5, 27.5 } },
		{ 15.0, 24.0 },
		{ 13.5, 17.5, 21.5, 25.5 },
		10.5,
		28.5
	)

	local importedA = tryVisualCar("Car_A", carA, -19.5)
	local importedC = tryVisualCar("Car_C", carC, 19.5)
	if importedA and importedC then
		print("[Last Local] Using modeled Car_A and Car_C over Part shells.")
	elseif importedA or importedC then
		print(
			string.format(
				"[Last Local] Adjacent cars: %s mesh, %s Part shell.",
				if importedA then "Car_A" else "Car_C",
				if importedA then "Car_C" else "Car_A"
			)
		)
	else
		print("[Last Local] Car_A / Car_C Part shells (optional Models.Car_A / Car_C not present).")
	end

	local gangways = Instance.new("Folder")
	gangways.Name = "Gangways"
	gangways.Parent = workspace
	buildGangway(gangways, -9.75)
	buildGangway(gangways, 9.75)

	wireCarBDoors(car.model)

	local notes: { string } = {}
	local adjacentParts = 0
	for _, def in Passengers.ADJACENT do
		local note = car.spawnPassenger(def, car.passengers)
		table.insert(notes, note)
		if string.find(note, "parts", 1, true) then
			adjacentParts += 1
		end
	end
	if #notes == 0 then
		print("[Last Local] Adjacent passengers: none")
	elseif adjacentParts == #notes then
		print(string.format("[Last Local] Adjacent passengers: %d Part figures.", #notes))
	else
		print(string.format("[Last Local] Adjacent passengers: %s", table.concat(notes, ", ")))
	end
end

return Consist
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">MetaStore</string>
          <string name="Source"><![CDATA[--!strict
-- Player meta progression: endings archive, achievements, tapes, album, run count.
-- Uses DataStore when available; falls back to an in-memory table (Studio / offline).
-- Failed GetAsync never seeds an empty save that later SetAsync could clobber cloud data.
-- Once a key is live in memory for this session, load returns that copy (no delayed overwrite).

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local MetaStore = {}

export type EndingEntry = { count: number, discoveredAt: number }
export type TapeEntry = { signalId: string, title: string, stop: string, freq: string, transcript: string }
export type PhotoEntry = { id: string, framed: { string } }

export type Save = {
	runsCompleted: number,
	nightmareUnlocked: boolean,
	endings: { [string]: EndingEntry },
	achievements: { [string]: { unlockedAt: number } },
	tapes: { TapeEntry },
	album: { PhotoEntry },
	anomalyTypes: { [string]: boolean },
}

local memory: { [string]: Save } = {}
-- Keys where GetAsync failed: memory is session-only; skip SetAsync to avoid wiping cloud.
local cloudBlocked: { [string]: boolean } = {}
local store: GlobalDataStore? = nil

local function tryStore(): GlobalDataStore?
	if store ~= nil then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("LastLocalMeta_v1")
	end)
	if ok then
		store = result
		return store
	end
	return nil
end

function MetaStore.empty(): Save
	return {
		runsCompleted = 0,
		nightmareUnlocked = false,
		endings = {},
		achievements = {},
		tapes = {},
		album = {},
		anomalyTypes = {},
	}
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function fromRaw(raw: any): Save
	local s = MetaStore.empty()
	if typeof(raw) ~= "table" then
		return s
	end
	local t = raw :: any
	if typeof(t.runsCompleted) == "number" then
		s.runsCompleted = t.runsCompleted
	end
	s.nightmareUnlocked = t.nightmareUnlocked == true or s.runsCompleted > 0
	if typeof(t.endings) == "table" then
		s.endings = t.endings
	end
	if typeof(t.achievements) == "table" then
		s.achievements = t.achievements
	end
	if typeof(t.tapes) == "table" then
		s.tapes = t.tapes
	end
	if typeof(t.album) == "table" then
		s.album = t.album
	end
	if typeof(t.anomalyTypes) == "table" then
		s.anomalyTypes = t.anomalyTypes
	end
	return s
end

function MetaStore.load(userId: number): Save
	local k = keyFor(userId)
	-- Session copy wins: avoids a late GetAsync overwriting in-memory progress.
	local existing = memory[k]
	if existing ~= nil then
		return existing
	end
	local ds = tryStore()
	if ds ~= nil then
		local ok, raw = pcall(function()
			return ds:GetAsync(k)
		end)
		if ok then
			cloudBlocked[k] = nil
			-- nil raw = first-time player; empty save is safe to persist later.
			local s = fromRaw(raw)
			memory[k] = s
			return s
		end
		-- Read failed: session empty only; do not SetAsync until a later load succeeds.
		cloudBlocked[k] = true
		local s = MetaStore.empty()
		memory[k] = s
		return s
	end
	local s = MetaStore.empty()
	memory[k] = s
	return s
end

function MetaStore.save(userId: number, data: Save)
	local k = keyFor(userId)
	memory[k] = data
	if cloudBlocked[k] then
		return
	end
	local ds = tryStore()
	if ds == nil then
		return
	end
	pcall(function()
		ds:SetAsync(k, data)
	end)
end

function MetaStore.toJson(data: Save): string
	return HttpService:JSONEncode(data)
end

function MetaStore.recordEnding(data: Save, endingId: string, at: number)
	local existing = data.endings[endingId]
	if existing ~= nil then
		existing.count += 1
	else
		data.endings[endingId] = { count = 1, discoveredAt = at }
	end
end

function MetaStore.mergeTapes(data: Save, tapes: { TapeEntry }, maxKeep: number)
	local seen: { [string]: boolean } = {}
	for _, t in data.tapes do
		seen[t.signalId] = true
	end
	for _, t in tapes do
		if not seen[t.signalId] then
			table.insert(data.tapes, t)
			seen[t.signalId] = true
		end
	end
	while #data.tapes > maxKeep do
		table.remove(data.tapes, 1)
	end
end

function MetaStore.mergeAlbum(data: Save, photos: { PhotoEntry }, maxKeep: number)
	for _, p in photos do
		table.insert(data.album, p)
	end
	while #data.album > maxKeep do
		table.remove(data.album, 1)
	end
end

return MetaStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Ride</string>
          <string name="Source"><![CDATA[--!strict
-- Stop cycle for the G, from gameState.ts.
-- PA lines are the web game's lines (see Shared.Lines). The car stays put.
-- The tunnel and the platforms move: accel, cruise, and brake use the same
-- stretch times as the stop timer (Motion.luau).
--
-- Lighting rule (web doc, and the nightmare-bulb comment in gameState.ts):
-- the only whole-car blackout is the flicker tick, 0.16 seconds, used on the
-- silent stretch after Myrtle–Willoughby Avs and on the arrival at 21 St.
-- The doors tick opens the doors early and does not touch the lights.
-- The last stretch may dim in a straight line. Tunnel lamps are outside and
-- never write these interior lights.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AnomalySystem = require(script.Parent.AnomalySystem)
local CarBuilder = require(script.Parent.CarBuilder)
local MetaStore = require(script.Parent.MetaStore)
local Scenery = require(script.Parent.Scenery)
local TrialSpace = require(script.Parent.TrialSpace)
local WorldLight = require(script.Parent.WorldLight)
local Achievements = require(ReplicatedStorage.Shared.Achievements)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Trestle = require(ReplicatedStorage.Shared.Trestle)
local Doors = require(ReplicatedStorage.Shared.Doors)
local Dwell = require(ReplicatedStorage.Shared.Dwell)
local Hold = require(ReplicatedStorage.Shared.Hold)
local Dialogue = require(ReplicatedStorage.Shared.Dialogue)
local Haven = require(ReplicatedStorage.Shared.Haven)
local Nightmare = require(ReplicatedStorage.Shared.Nightmare)
local Practice = require(ReplicatedStorage.Shared.Practice)
local Trial = require(ReplicatedStorage.Shared.Trial)
local Evp = require(ReplicatedStorage.Shared.Evp)
local Polaroid = require(ReplicatedStorage.Shared.Polaroid)
local Sanity = require(ReplicatedStorage.Shared.Sanity)
local Restraint = require(ReplicatedStorage.Shared.Restraint)
local Endings = require(ReplicatedStorage.Shared.Endings)
local Lines = require(ReplicatedStorage.Shared.Lines)
local PsychLog = require(ReplicatedStorage.Shared.PsychLog)
local Score = require(ReplicatedStorage.Shared.Score)
local Band = require(ReplicatedStorage.Shared.Band)
local Motion = require(ReplicatedStorage.Shared.Motion)
local Route = require(ReplicatedStorage.Shared.Route)

local Ride = {}

function Ride.start(car: CarBuilder.BuiltCar)
	local ride = Instance.new("Folder")
	ride.Name = "Ride"
	ride.Parent = ReplicatedStorage

	local remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
	local flagRemote = Instance.new("RemoteEvent")
	flagRemote.Name = "Flag"
	flagRemote.Parent = remotes
	local doorsRemote = Instance.new("RemoteEvent")
	doorsRemote.Name = "Doors"
	doorsRemote.Parent = remotes
	local maskRemote = Instance.new("RemoteEvent")
	maskRemote.Name = "Mask"
	maskRemote.Parent = remotes
	local trialRemote = Instance.new("RemoteEvent")
	trialRemote.Name = "Trial"
	trialRemote.Parent = remotes
	local evpToggleRemote = Instance.new("RemoteEvent")
	evpToggleRemote.Name = "EvpToggle"
	evpToggleRemote.Parent = remotes
	local evpTuneRemote = Instance.new("RemoteEvent")
	evpTuneRemote.Name = "EvpTune"
	evpTuneRemote.Parent = remotes
	local evpRecordRemote = Instance.new("RemoteEvent")
	evpRecordRemote.Name = "EvpRecord"
	evpRecordRemote.Parent = remotes
	local evpPlayRemote = Instance.new("RemoteEvent")
	evpPlayRemote.Name = "EvpPlay"
	evpPlayRemote.Parent = remotes
	local polaroidToggleRemote = Instance.new("RemoteEvent")
	polaroidToggleRemote.Name = "PolaroidToggle"
	polaroidToggleRemote.Parent = remotes
	local polaroidSnapRemote = Instance.new("RemoteEvent")
	polaroidSnapRemote.Name = "PolaroidSnap"
	polaroidSnapRemote.Parent = remotes
	local polaroidAlbumRemote = Instance.new("RemoteEvent")
	polaroidAlbumRemote.Name = "PolaroidAlbum"
	polaroidAlbumRemote.Parent = remotes
	local holdRemote = Instance.new("RemoteEvent")
	holdRemote.Name = "Hold"
	holdRemote.Parent = remotes
	local exitRemote = Instance.new("RemoteEvent")
	exitRemote.Name = "Exit"
	exitRemote.Parent = remotes
	local gazeRemote = Instance.new("RemoteEvent")
	gazeRemote.Name = "Gaze"
	gazeRemote.Parent = remotes
	local metaStartRemote = Instance.new("RemoteEvent")
	metaStartRemote.Name = "MetaStart"
	metaStartRemote.Parent = remotes
	local metaAgainRemote = Instance.new("RemoteEvent")
	metaAgainRemote.Name = "MetaAgain"
	metaAgainRemote.Parent = remotes

	ride:SetAttribute("Phase", "menu")
	ride:SetAttribute("PaText", "")
	ride:SetAttribute("Subtitle", "")
	ride:SetAttribute("Hint", "")
	ride:SetAttribute("Feedback", "")
	ride:SetAttribute("FeedbackKind", "")
	ride:SetAttribute("NextStop", Route.stopName(2))
	ride:SetAttribute("ChapterLine", Route.chapterLine(1))
	ride:SetAttribute("DwellUntil", 0)
	ride:SetAttribute("Suspicion", 0)
	ride:SetAttribute("PeakSuspicion", 0)
	ride:SetAttribute("Sanity", Constants.SANITY_START)
	ride:SetAttribute("SanityTier", Sanity.tierOf(Constants.SANITY_START))
	ride:SetAttribute("SanityRetained", 0)
	ride:SetAttribute("Interventions", 0)
	ride:SetAttribute("Intervening", false)
	ride:SetAttribute("RestraintActive", false)
	ride:SetAttribute("RestraintProgress", 0)
	ride:SetAttribute("RestraintOK", false)
	ride:SetAttribute("ExitActive", false)
	ride:SetAttribute("ExitUntil", 0)
	ride:SetAttribute("ReportReady", false)
	ride:SetAttribute("EndingId", "")
	ride:SetAttribute("EndingTitle", "")
	ride:SetAttribute("EndingBadge", "")
	ride:SetAttribute("EndingNarrative", "")
	ride:SetAttribute("ReportStats", "")
	ride:SetAttribute("ReportPsych", "")
	ride:SetAttribute("HasRecorder", false)
	ride:SetAttribute("NightmareUnlocked", false)
	ride:SetAttribute("NightmareOn", false)
	ride:SetAttribute("PracticeOn", false)
	ride:SetAttribute("MetaArchive", "")
	ride:SetAttribute("PracticeNote", "")
	ride:SetAttribute("SegStop", 0)
	ride:SetAttribute("EvpRaised", false)
	ride:SetAttribute("EvpKhz", 120)
	ride:SetAttribute("EvpMeter", 0)
	ride:SetAttribute("EvpLocked", "")
	ride:SetAttribute("EvpStatus", "")
	ride:SetAttribute("EvpRecordT", 0)
	ride:SetAttribute("EvpTapes", "[]")
	ride:SetAttribute("EvpSaved", "")
	ride:SetAttribute("EvpPlayId", "")
	ride:SetAttribute("TapeGlance", 0)
	ride:SetAttribute("FlashGlance", 0)
	ride:SetAttribute("CameraRaised", false)
	ride:SetAttribute("AlbumOpen", false)
	ride:SetAttribute("FilmLeft", Polaroid.STARTING_FILM)
	ride:SetAttribute("PolaroidFlash", 0)
	ride:SetAttribute("PolaroidAlbum", "[]")
	ride:SetAttribute("OpenAir", 0)
	ride:SetAttribute("Band", "calm")
	ride:SetAttribute("FalseStopBonus", 0)
	ride:SetAttribute("BoardStop", "")
	ride:SetAttribute("BoardMinutes", 0)
	ride:SetAttribute("HoldAt", 0)
	ride:SetAttribute("HoldFor", 0)
	ride:SetAttribute("Held", false)
	ride:SetAttribute("StareIntervalScale", 1)
	-- 1 open, 0 closed. Client sound listens; the door leaves still ease toward this.
	ride:SetAttribute("DoorTarget", 1)
	ride:SetAttribute("ChoiceActive", false)
	ride:SetAttribute("ChoiceUntil", 0)
	ride:SetAttribute("MaskActive", false)
	ride:SetAttribute("MaskUntil", 0)
	ride:SetAttribute("MaskA", "")
	ride:SetAttribute("MaskB", "")
	ride:SetAttribute("MaskC", "")
	ride:SetAttribute("TrialActive", false)
	ride:SetAttribute("TrialUntil", 0)
	ride:SetAttribute("TrialA", "")
	ride:SetAttribute("TrialB", "")
	ride:SetAttribute("TrialC", "")
	ride:SetAttribute("TrialSlots", 0)
	ride:SetAttribute("TrialChime", 0)

	local trialSpace = TrialSpace.build()
	local carReturn = car.board.CFrame * CFrame.new(0, 3, 0)

	CarBuilder.addTells(
		car.passengers,
		AnomalySystem.ANNOUNCE_ID,
		Lines.ANNOUNCEMENT,
		AnomalySystem.COUNTDOWN_ID,
		Lines.COUNTDOWN
	)
	CarBuilder.addCatalogProps(car.passengers)

	local paToken = 0
	local subToken = 0
	local hintToken = 0
	local feedbackToken = 0

	local function showTimed(attr: string, text: string, seconds: number, tokenName: string): number
		local token = 0
		if tokenName == "pa" then
			paToken += 1
			token = paToken
		elseif tokenName == "sub" then
			subToken += 1
			token = subToken
		else
			hintToken += 1
			token = hintToken
		end
		ride:SetAttribute(attr, text)
		task.delay(seconds, function()
			local current = if tokenName == "pa" then paToken elseif tokenName == "sub" then subToken else hintToken
			if current == token then
				ride:SetAttribute(attr, "")
			end
		end)
		return token
	end

	local function showPa(text: string, seconds: number)
		local line = text
		if ride:GetAttribute("Band") == "watched" then
			line = Band.glitchLine(text)
		end
		showTimed("PaText", line, seconds, "pa")
	end

	local function showSub(text: string, seconds: number)
		showTimed("Subtitle", text, seconds, "sub")
	end

	local function showHint(text: string, seconds: number)
		showTimed("Hint", text, seconds, "hint")
	end

	local function showFeedback(kind: string, text: string, sticky: boolean)
		feedbackToken += 1
		local token = feedbackToken
		ride:SetAttribute("FeedbackKind", kind)
		ride:SetAttribute("Feedback", text)
		if not sticky then
			task.delay(2.6, function()
				if feedbackToken == token then
					ride:SetAttribute("FeedbackKind", "")
					ride:SetAttribute("Feedback", "")
				end
			end)
		end
	end

	local doorOpen = 1
	local doorTarget = 1
	local function setDoorTarget(value: number)
		doorTarget = value
		ride:SetAttribute("DoorTarget", value)
	end
	local dim = 1
	local dimFrom = 1
	local dimTo = 1
	local dimStart = 0
	local dimDuration = 1
	local dimming = false
	local forcedOff = false

	local function blackout()
		-- Flicker tick only. Callers are the two segments whose tick is "flicker".
		-- Watched / hunted lengthens the tick slightly; still not a hold blackout.
		local seconds = Constants.FLICKER_TICK_SECONDS
		local bandAttr = ride:GetAttribute("Band")
		if bandAttr == "hunted" then
			seconds *= Constants.FLICKER_HUNTED_SCALE
		elseif bandAttr == "watched" then
			seconds *= Constants.FLICKER_WATCHED_SCALE
		end
		forcedOff = true
		task.delay(seconds, function()
			forcedOff = false
		end)
	end

	local function beginDim(target: number, seconds: number)
		dimFrom = dim
		dimTo = target
		dimStart = os.clock()
		dimDuration = math.max(0.1, seconds)
		dimming = true
	end

	-- A single LightStrip can go dark on its own. That is not the door tick.
	local stripHold: { [BasePart]: boolean } = {}
	local posterOriginal: { [BasePart]: Color3 } = {}

	local function applyLights()
		local k = if forcedOff then 0 else dim
		local color = Constants.COLOR.lightOff:Lerp(Constants.COLOR.lightOn, k)
		for _, lamp in car.lamps do
			if forcedOff or stripHold[lamp.part] ~= true then
				lamp.part.Color = color
			end
			local point = lamp.light
			if point ~= nil then
				point.Brightness = Constants.LAMP_BRIGHTNESS * k
				point.Range = Constants.meters(Constants.LAMP_RANGE_M)
				point.Enabled = k > 0.03
			end
		end
	end

	local odo = 0
	local leaving, arriving = Scenery.build()
	Scenery.setName(leaving, Route.stopName(1))
	local trestlePlan: Trestle.Plan = Trestle.plan(0, false, 0, 1)
	local lastOpenAir = -1

	type Stretch = {
		start: number,
		origin: number,
		accel: number,
		cruise: number,
		brake: number,
		top: number,
		holdAt: number,
		holdFor: number,
	}
	local stretch: Stretch? = nil
	local nightmareOn = false
	local practiceOn = false
	local startChapter = 1
	local trestleBadgeChecked = false
	local anomalyTypesSeen: { [string]: boolean } = {}
	local pendingStart: { nightmare: boolean, chapter: number }? = nil
	local pendingAgain = false
	local metaUserId: number? = nil

	local function publishOpenAir(level: number)
		if math.abs(level - lastOpenAir) < 0.03 then
			return
		end
		lastOpenAir = level
		ride:SetAttribute("OpenAir", level)
		Scenery.setOpenAirLevel(level)
		WorldLight.setOpenAir(level)
		if level > 0.4 and not trestleBadgeChecked then
			trestleBadgeChecked = true
		end
	end

	local function beginStretch(seg: Route.Segment, holdAt: number, holdFor: number)
		local accel = Constants.ACCEL
		local brake = Constants.BRAKE
		local cruise = Nightmare.cruiseSeconds(seg.sliceCruise, nightmareOn)
		local top = Nightmare.topSpeed(Constants.TOP_SPEED_MPS, nightmareOn)
		-- Whichever platform is already at the doors is the one we leave.
		if math.abs(arriving.base - odo) < math.abs(leaving.base - odo) then
			local swap = leaving
			leaving = arriving
			arriving = swap
		end
		leaving.base = odo
		local dist = Motion.segmentDistance(accel, cruise, brake, top)
		arriving.base = odo + dist
		Scenery.setName(arriving, Route.stopName(seg.stop))
		-- Newtown Creek: open-air 21 St approach / departure (web gameState trestle).
		trestlePlan = Trestle.plan(seg.stop, seg.b, odo, dist)
		Scenery.setOpenAir(leaving, Trestle.leavingOpenAir(seg.stop))
		Scenery.setOpenAir(arriving, Trestle.arrivingOpenAir(seg.stop, seg.b))
		local now = workspace:GetServerTimeNow()
		stretch = {
			start = now,
			origin = odo,
			accel = accel,
			cruise = cruise,
			brake = brake,
			top = top,
			holdAt = holdAt,
			holdFor = holdFor,
		}
		ride:SetAttribute("StretchStart", now)
		ride:SetAttribute("StretchAccel", accel)
		ride:SetAttribute("StretchCruise", cruise)
		ride:SetAttribute("StretchBrake", brake)
		ride:SetAttribute("HoldAt", holdAt)
		ride:SetAttribute("HoldFor", holdFor)
		ride:SetAttribute("Held", false)
		ride:SetAttribute("StareIntervalScale", Hold.stareScale(false, Constants.HOLD_STARE_MULTIPLIER))
	end

	local slide = Constants.meters(Constants.DOOR_SLIDE_M)
	RunService.Heartbeat:Connect(function(dt: number)
		local current = stretch
		if current ~= nil then
			local elapsed = workspace:GetServerTimeNow() - current.start
			local motionT = Hold.motionTime(elapsed, current.holdAt, current.holdFor)
			odo = current.origin + Motion.distance(motionT, current.accel, current.cruise, current.brake, current.top)
		end
		local openLevel = if ride:GetAttribute("Phase") == "trial" then 0 else Trestle.outsideLevel(odo, trestlePlan)
		publishOpenAir(openLevel)
		Scenery.place(odo)
		doorOpen += (doorTarget - doorOpen) * (1 - math.exp(-7 * dt))
		for _, leaf in car.doors do
			local x = leaf.x0 + leaf.side * slide * doorOpen
			leaf.model:PivotTo(CFrame.new(x, leaf.y, leaf.z))
		end
		if dimming then
			local alpha = math.clamp((os.clock() - dimStart) / dimDuration, 0, 1)
			dim = dimFrom + (dimTo - dimFrom) * alpha
			if alpha >= 1 then
				dimming = false
			end
		end
		applyLights()
	end)

	local flagged: { [string]: boolean } = {}
	local falseFlags = 0
	local caught = false
	local suspicion = 0
	local peakSuspicion = 0
	local sanity = Constants.SANITY_START
	local bandStop = 1
	local sanSamples: { number } = {}
	local interventions = 0
	local intervening = false
	local restraintState: Restraint.State? = nil
	local restraintDone = false
	local restraintOK = false
	local restraintHeld = false
	local restraintHidden: { string } = {}
	local restraintMomRest: { [BasePart]: Color3 } = {}
	local accCorrect = 0
	local accMiss = 0
	local trialStops: { number } = {}
	local finalExit: Endings.ExitChoice = "escalators"
	local pendingExitChoice: string? = nil
	local exitEpoch = 0
	local stopHadAnomaly = false
	local stopNoticed = false
	local stopFalseAlarm = false
	local posterLive = false
	local inFinal = false
	local huntedDim = false
	local maskUsed: { [string]: boolean } = {}
	local maskLast: string? = nil
	local maskBusy = false
	local chatPlan = Dialogue.buildChatPlan(function()
		return math.random()
	end)

	local hasRecorder = false
	local evpState = Evp.newState(function()
		return math.random()
	end)
	local currentSegStop: number? = nil
	local cameraRaised = false
	local albumOpen = false
	local filmLeft = Polaroid.STARTING_FILM
	local nextShotAt = 0
	local polaroidPhotos: { Polaroid.Photo } = {}
	local photoSeq = 0
	local psychLog = PsychLog.newRide()
	local gazeTarget: string? = nil
	local gazeSince = 0
	local stareAnomalyCharged = false
	local stareParentCharged = false
	local falseStopReacted = false
	local falseStopOpen = false
	local stretchMovedM = 0
	local lastRootPos: Vector3? = nil

	local function publishSanity()
		ride:SetAttribute("Sanity", sanity)
		ride:SetAttribute("SanityTier", Sanity.tierOf(sanity))
	end

	local function applySanity(delta: number)
		local lo, hi = Sanity.bandForStop(bandStop, restraintOK, Constants.RESTRAINT_RAISE)
		sanity = Sanity.apply(sanity, delta, lo, hi)
		publishSanity()
	end

	local function sampleSanity()
		local lo, hi = Sanity.bandForStop(bandStop, restraintOK, Constants.RESTRAINT_RAISE)
		table.insert(sanSamples, Sanity.bandPosition(sanity, lo, hi))
		ride:SetAttribute("SanityRetained", Sanity.retainedPercent(sanSamples))
	end

	local function setWalkLocked(locked: boolean)
		for _, player in game:GetService("Players"):GetPlayers() do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid ~= nil then
				if locked then
					humanoid.WalkSpeed = 0
				else
					humanoid.WalkSpeed = Constants.WALK_SPEED_MPS * Constants.STUDS_PER_METER
				end
			end
		end
	end

	local function publishEvp()
		ride:SetAttribute("EvpRaised", evpState.raised)
		ride:SetAttribute("EvpKhz", evpState.khz)
		ride:SetAttribute("EvpMeter", evpState.meter)
		ride:SetAttribute("EvpLocked", evpState.lockedKind)
		ride:SetAttribute("EvpRecordT", evpState.recordT)
		ride:SetAttribute("EvpTapes", HttpService:JSONEncode(evpState.tapes))
		local riding = ride:GetAttribute("Phase") == "ride"
		ride:SetAttribute("EvpStatus", Evp.statusLine(evpState, riding == true))
	end

	local function publishCamera()
		ride:SetAttribute("CameraRaised", cameraRaised)
		ride:SetAttribute("AlbumOpen", albumOpen)
		ride:SetAttribute("FilmLeft", filmLeft)
		local slim = {}
		for _, photo in polaroidPhotos do
			table.insert(slim, { id = photo.id, stop = photo.stop })
		end
		ride:SetAttribute("PolaroidAlbum", HttpService:JSONEncode(slim))
	end

	local function handsBusy(): boolean
		return ride:GetAttribute("ChoiceActive") == true
			or ride:GetAttribute("MaskActive") == true
			or ride:GetAttribute("TrialActive") == true
			or ride:GetAttribute("Phase") == "trial"
			or ride:GetAttribute("RestraintActive") == true
			or ride:GetAttribute("Intervening") == true
			or ride:GetAttribute("ExitActive") == true
	end

	local function lowerCamera()
		cameraRaised = false
		publishCamera()
	end

	local function giveRecorder(where: string)
		if hasRecorder or ride:GetAttribute("Phase") == "end" then
			return
		end
		hasRecorder = true
		ride:SetAttribute("HasRecorder", true)
		if where == "haven" then
			showSub(Lines.DAD_RECORDER_HAVEN, 4.2)
		else
			showSub(Lines.DAD_RECORDER_TRAIN, 4.2)
		end
		showHint(Lines.RECORDER_HINT, 5)
	end

	publishEvp()
	publishCamera()

	evpToggleRemote.OnServerEvent:Connect(function(_player: Player)
		if not hasRecorder then
			showHint(Lines.RECORDER_NONE, 2.5)
			return
		end
		if evpState.raised then
			Evp.lower(evpState)
			publishEvp()
			return
		end
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" and phase ~= "haven" and phase ~= "intro" then
			return
		end
		if handsBusy() then
			showHint(Lines.RECORDER_BUSY, 2)
			return
		end
		lowerCamera()
		albumOpen = false
		Evp.raise(evpState)
		publishEvp()
		publishCamera()
	end)

	evpTuneRemote.OnServerEvent:Connect(function(_player: Player, delta: any)
		if not evpState.raised then
			return
		end
		if typeof(delta) ~= "number" then
			return
		end
		Evp.tune(evpState, math.clamp(delta, -5, 5))
		publishEvp()
	end)

	evpRecordRemote.OnServerEvent:Connect(function(_player: Player, on: any)
		if not evpState.raised then
			return
		end
		if typeof(on) ~= "boolean" then
			return
		end
		Evp.setRecording(evpState, on)
		publishEvp()
	end)

	evpPlayRemote.OnServerEvent:Connect(function(_player: Player, signalId: any)
		if typeof(signalId) ~= "string" then
			return
		end
		if not Evp.hasTape(evpState, signalId) then
			return
		end
		local sig = Evp.signalById(signalId)
		if sig == nil then
			return
		end
		ride:SetAttribute("EvpPlayId", signalId)
		showSub("Tape: " .. sig.title, 3.5)
		local phase = ride:GetAttribute("Phase")
		if (phase == "ride" or phase == "stop") and math.random() < Evp.TAPE_GLANCE_CHANCE then
			task.delay(0.8, function()
				ride:SetAttribute("TapeGlance", workspace:GetServerTimeNow())
			end)
		end
		task.delay(4, function()
			if ride:GetAttribute("EvpPlayId") == signalId then
				ride:SetAttribute("EvpPlayId", "")
			end
		end)
	end)

	polaroidToggleRemote.OnServerEvent:Connect(function(_player: Player)
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" and phase ~= "haven" and phase ~= "intro" then
			return
		end
		if cameraRaised then
			lowerCamera()
			return
		end
		if handsBusy() then
			showHint(Lines.CAMERA_BUSY, 2)
			return
		end
		if evpState.raised then
			Evp.lower(evpState)
			publishEvp()
		end
		albumOpen = false
		cameraRaised = true
		publishCamera()
	end)

	polaroidAlbumRemote.OnServerEvent:Connect(function(_player: Player)
		albumOpen = not albumOpen
		if albumOpen then
			lowerCamera()
		end
		publishCamera()
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		if handsBusy() then
			if cameraRaised then
				lowerCamera()
			end
			if evpState.raised then
				Evp.lower(evpState)
				publishEvp()
			end
			return
		end
		if not evpState.raised then
			return
		end
		local stopLabel = ""
		local stopAttr = ride:GetAttribute("NextStop")
		if typeof(stopAttr) == "string" then
			stopLabel = stopAttr
		end
		local ridingStop: number? = nil
		if ride:GetAttribute("Phase") == "ride" then
			ridingStop = currentSegStop
		end
		local tape = Evp.update(evpState, dt, ridingStop, stopLabel)
		publishEvp()
		if tape ~= nil then
			ride:SetAttribute("EvpSaved", tape.title)
			showSub("Saved to tape: " .. tape.title, 2.6)
			task.delay(2.8, function()
				if ride:GetAttribute("EvpSaved") == tape.title then
					ride:SetAttribute("EvpSaved", "")
				end
			end)
		end
	end)

	local function blinkBandTube()
		for _, lamp in car.lamps do
			if lamp.part.Name == Constants.BAND_STRIP_NAME then
				stripHold[lamp.part] = true
				lamp.part.Color = Constants.COLOR.lightOff
				local part = lamp.part
				task.delay(Constants.UNEASY_TUBE_BLINK, function()
					stripHold[part] = nil
				end)
				break
			end
		end
	end

	local function publishBand()
		local band = Band.fromSuspicion(suspicion, Constants.BAND_CALM_MAX, Constants.BAND_UNEASY_MAX, Constants.BAND_WATCHED_MAX)
		ride:SetAttribute("Band", band)
		-- Fixed route. The bonus is not used to pick a false stop.
		ride:SetAttribute("FalseStopBonus", Band.falseStopBonus(band, Constants.WATCHED_FALSE_STOP_BONUS))
		local effect = Band.light(band)
		if effect == "dim" and not inFinal then
			if not huntedDim then
				huntedDim = true
				beginDim(Band.dimTarget(Constants.HUNTED_DIM), Constants.HUNTED_DIM_SECONDS)
			end
		elseif huntedDim then
			huntedDim = false
			beginDim(Band.dimTarget(1), Constants.HUNTED_DIM_SECONDS)
		end
	end

	local maybeIntervene: () -> ()

	local function applySuspicion(delta: number)
		suspicion = Score.apply(suspicion, delta, Constants.SUSPICION_MIN, Constants.SUSPICION_MAX)
		-- Product decision: clamp at 100, never end the ride (SUSPICION_HARD_FAIL = false).
		if suspicion > peakSuspicion then
			peakSuspicion = suspicion
			ride:SetAttribute("PeakSuspicion", peakSuspicion)
		end
		ride:SetAttribute("Suspicion", suspicion)
		publishBand()
		maybeIntervene()
	end

	local function publishRestraint()
		local active = restraintState ~= nil
		ride:SetAttribute("RestraintActive", active)
		ride:SetAttribute("RestraintProgress", if restraintState ~= nil then Restraint.progress(restraintState) else 0)
		ride:SetAttribute("RestraintOK", restraintOK)
		setWalkLocked(active or intervening)
	end

	local function restoreRestraintVisuals()
		local mom = car.passengers:FindFirstChild(AnomalySystem.MOMFACE_ID)
		if mom ~= nil and mom:IsA("Model") then
			for part, color in restraintMomRest do
				part.Color = color
			end
		end
		table.clear(restraintMomRest)
		for _, id in restraintHidden do
			CarBuilder.setPassengerShown(car.passengers, id, true)
		end
		table.clear(restraintHidden)
	end

	local function endRestraint(ok: boolean, why: string)
		restraintState = nil
		restraintDone = true
		restraintOK = ok
		restraintHeld = false
		restoreRestraintVisuals()
		beginDim(1, 1.2)
		publishRestraint()
		if ok then
			applySanity(Constants.SANITY_RESTRAINT_OK)
			showSub(Lines.RESTRAINT_OK, 3.0)
		else
			applySuspicion(Constants.RESTRAINT_FAIL_SUSPICION)
			applySanity(-Constants.SANITY_RESTRAINT_FAIL)
			showSub(if why ~= "" then why else Lines.RESTRAINT_FAIL, 3.0)
		end
		ride:SetAttribute("RestraintOK", restraintOK)
	end

	local function startRestraintMoment()
		if restraintState ~= nil or restraintDone then
			return
		end
		if intervening or maskBusy or ride:GetAttribute("ChoiceActive") == true then
			return
		end
		if cameraRaised then
			cameraRaised = false
			albumOpen = false
			publishCamera()
		end
		if evpState.raised then
			Evp.lower(evpState)
			publishEvp()
		end
		restraintState = Restraint.newState(Constants.RESTRAINT_DURATION)
		publishRestraint()
		-- Keep the banner up for the full grab window (web shows 6s on a 5s wait).
		showHint(Lines.RESTRAINT_HINT, Constants.RESTRAINT_WAIT)
	end

	local function updateRestraint(dt: number)
		local state = restraintState
		if state == nil then
			return
		end
		local outcome = Restraint.tick(state, dt, restraintHeld)
		ride:SetAttribute("RestraintProgress", Restraint.progress(state))
		if outcome == "fail_wait" then
			endRestraint(false, Lines.RESTRAINT_FAIL_WAIT)
			return
		end
		if outcome == "fail_release" then
			endRestraint(false, Lines.RESTRAINT_FAIL)
			return
		end
		if outcome == "ok" then
			endRestraint(true, "Held")
			return
		end
		if outcome == "holding" then
			dim = Restraint.dimFraction(state.t)
			applyLights()
			if Restraint.shouldFireBeat(state, Restraint.BEAT_MOM) then
				local mom = car.passengers:FindFirstChild(AnomalySystem.MOMFACE_ID)
				if mom ~= nil and mom:IsA("Model") then
					for _, desc in mom:GetDescendants() do
						if desc:IsA("BasePart") and (desc.Name == "Head" or desc.Name == "Hair" or desc.Name == "Eye") then
							restraintMomRest[desc] = desc.Color
							if desc.Name == "Eye" then
								desc.Color = Color3.fromRGB(20, 20, 28)
							else
								desc.Color = Color3.fromRGB(223, 217, 206)
							end
						end
					end
				end
			end
			if Restraint.shouldFireBeat(state, Restraint.BEAT_DAD) then
				showSub(Lines.RESTRAINT_DAD, 3.2)
			end
			if Restraint.shouldFireBeat(state, Restraint.BEAT_EMPTY) then
				for _, id in { "s1", "s2", "s3", AnomalySystem.EXTRA_ID, "c1", "c2", "c3", "c4", "c5" } do
					local model = car.passengers:FindFirstChild(id)
					if model ~= nil and model:GetAttribute("Hidden") ~= true then
						table.insert(restraintHidden, id)
						CarBuilder.setPassengerShown(car.passengers, id, false)
					end
				end
			end
			if Restraint.shouldFireBeat(state, Restraint.BEAT_MOUTH) then
				showSub(Lines.RESTRAINT_MOM_MOUTH, 3.4)
			end
		end
	end

	local function triggerConcernedIntervention()
		if intervening or restraintState ~= nil then
			return
		end
		if ride:GetAttribute("ChoiceActive") == true or ride:GetAttribute("MaskActive") == true then
			return
		end
		if suspicion < Constants.INTERVENE_SUSPICION then
			return
		end
		intervening = true
		interventions += 1
		ride:SetAttribute("Intervening", true)
		ride:SetAttribute("Interventions", interventions)
		setWalkLocked(true)
		restraintHeld = false
		if cameraRaised then
			cameraRaised = false
			publishCamera()
		end
		if evpState.raised then
			Evp.lower(evpState)
			publishEvp()
		end
		showSub(Lines.INTERVENTION_DAD, 2.6)
		task.delay(2.7, function()
			if not intervening then
				return
			end
			showSub(Lines.INTERVENTION_MOM, 3.0)
		end)
		task.delay(5.9, function()
			if not intervening then
				return
			end
			showSub(Lines.INTERVENTION_YOU, 2.4)
		end)
		task.delay(8.4, function()
			if not intervening then
				return
			end
			intervening = false
			ride:SetAttribute("Intervening", false)
			setWalkLocked(restraintState ~= nil)
			applySanity(-Constants.SANITY_INTERVENTION)
			suspicion = Constants.INTERVENTION_RESET_SUSPICION
			ride:SetAttribute("Suspicion", suspicion)
			publishBand()
			-- No hard fail: intervention cools the meter; the ride continues.
		end)
	end

	maybeIntervene = function()
		-- Rojo product decision: no hard fail at suspicion 100. Intervention
		-- cools the meter at INTERVENE_SUSPICION; the ride always continues.
		if Constants.SUSPICION_HARD_FAIL then
			return
		end
		if suspicion >= Constants.INTERVENE_SUSPICION then
			triggerConcernedIntervention()
		end
	end

	holdRemote.OnServerEvent:Connect(function(player: Player, held: any)
		if typeof(held) ~= "boolean" then
			return
		end
		if player.Character == nil then
			return
		end
		if restraintState == nil then
			restraintHeld = false
			return
		end
		restraintHeld = held
	end)

	exitRemote.OnServerEvent:Connect(function(player: Player, choice: any)
		if ride:GetAttribute("ExitActive") ~= true then
			return
		end
		-- Single-player slice: ignore Exit from anyone not in the ride.
		if player.Character == nil then
			return
		end
		if typeof(choice) ~= "string" then
			return
		end
		pendingExitChoice = choice
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		if restraintState ~= nil then
			updateRestraint(dt)
		end
	end)

	polaroidSnapRemote.OnServerEvent:Connect(function(
		_player: Player,
		px: any,
		py: any,
		pz: any,
		lx: any,
		ly: any,
		lz: any
	)
		if not cameraRaised then
			return
		end
		if typeof(px) ~= "number" or typeof(py) ~= "number" or typeof(pz) ~= "number" then
			return
		end
		if typeof(lx) ~= "number" or typeof(ly) ~= "number" or typeof(lz) ~= "number" then
			return
		end
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" and phase ~= "haven" and phase ~= "intro" then
			return
		end
		if handsBusy() then
			showHint(Lines.CAMERA_BUSY, 2)
			return
		end
		local now = os.clock()
		if now < nextShotAt then
			return
		end
		if filmLeft <= 0 then
			showHint(Lines.CAMERA_OUT_OF_FILM, 2.5)
			return
		end

		filmLeft = Polaroid.clampFilm(filmLeft - 1)
		nextShotAt = now + Polaroid.SHUTTER_COOLDOWN
		ride:SetAttribute("PolaroidFlash", workspace:GetServerTimeNow())

		local camPos = Vector3.new(px, py, pz)
		local lookDir = Vector3.new(lx, ly, lz)
		local framed: { string } = {}
		local liveIds: { string } = {}

		-- Poster tell has no mesh: any shot while it is live frames it.
		if posterLive then
			table.insert(liveIds, "poster_changed")
			table.insert(framed, "poster_changed")
		end
		for _, id in {
			AnomalySystem.ANNOUNCE_ID,
			AnomalySystem.COUNTDOWN_ID,
			AnomalySystem.EXTRA_ID,
			AnomalySystem.STICKER_ID,
			AnomalySystem.MAP_ID,
			AnomalySystem.NEARWORD_ID,
			AnomalySystem.LIGHT_ID,
			AnomalySystem.EMPTY_ID,
			AnomalySystem.MOVED_ID,
			AnomalySystem.FACETURN_ID,
			AnomalySystem.MOMFACE_ID,
		} do
			local model = car.passengers:FindFirstChild(id)
			if
				model ~= nil
				and model:IsA("Model")
				and model:GetAttribute("Anomaly") == true
				and model:GetAttribute("Hidden") ~= true
			then
				table.insert(liveIds, id)
				local at = model:GetPivot().Position
				if Polaroid.inFrame(camPos, lookDir, at, Constants.STUDS_PER_METER) then
					table.insert(framed, id)
				end
			end
		end

		photoSeq += 1
		local stopLabel = ""
		local stopAttr = ride:GetAttribute("NextStop")
		if typeof(stopAttr) == "string" then
			stopLabel = stopAttr
		end
		local photo: Polaroid.Photo = {
			id = string.format("p%d", photoSeq),
			stop = stopLabel,
			framed = framed,
			developed = false,
		}
		table.insert(polaroidPhotos, 1, photo)
		while #polaroidPhotos > 16 do
			table.remove(polaroidPhotos)
		end

		-- Privately marks the stop as noticed; no on-screen Caught (web photo path).
		if phase == "ride" and Polaroid.photoCatches(framed, liveIds) then
			caught = true
			stopNoticed = true
			for _, id in framed do
				anomalyTypesSeen[id] = true
				local kind = if id == AnomalySystem.EXTRA_ID
					then "extra"
					elseif id == AnomalySystem.MOVED_ID then "moved"
					elseif id == AnomalySystem.FACETURN_ID then "faceturn"
					elseif id == AnomalySystem.MOMFACE_ID then "momface"
					else id
				PsychLog.markCaught(psychLog, kind, stopLabel)
			end
			anomalyTypesSeen["photo"] = true
			applySuspicion(Score.flagDelta(true, true, Constants.FALSE_ALARM_SUSPICION, Constants.CORRECT_FLAG_SUSPICION))
		end

		if phase == "ride" or phase == "stop" then
			local bandAttr = ride:GetAttribute("Band")
			local band = if typeof(bandAttr) == "string" then bandAttr else "calm"
			if Polaroid.flashWatched(band) then
				applySuspicion(Polaroid.FLASH_WATCH_SUSPICION)
				showHint(Lines.CAMERA_FLASH_WATCH, 2.5)
			elseif math.random() < Polaroid.FLASH_GLANCE_CHANCE then
				ride:SetAttribute("FlashGlance", workspace:GetServerTimeNow())
			end
		end

		publishCamera()
	end)

	publishBand()

	task.spawn(function()
		while ride.Parent ~= nil do
			task.wait(Constants.UNEASY_TUBE_EVERY)
			if ride:GetAttribute("Band") == "uneasy" and ride:GetAttribute("Phase") == "ride" then
				blinkBandTube()
			end
		end
	end)

	local function playerNearDoors(): boolean
		local range = Constants.meters(Constants.FALSE_STOP_DOOR_RANGE_M)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
			if root ~= nil and root:IsA("BasePart") then
				for _, leaf in car.doors do
					local part = leaf.model.PrimaryPart
					if part ~= nil and (part.Position - root.Position).Magnitude <= range then
						return true
					end
				end
			end
		end
		return false
	end

	-- True when the player stands near an open door leaf during a false-stop dwell.
	local function playerReactedAtFalseStop(): boolean
		return falseStopReacted
	end

	-- Passenger, on purpose. The player cannot close doors or dispatch.
	-- EARLY_DEPARTURE_SUSPICION stays unused; no fail state.
	local function playerAskedToDepartEarly(): boolean
		return false
	end

	local function parentsAlert(): boolean
		local bandAttr = ride:GetAttribute("Band")
		if bandAttr == "watched" or bandAttr == "hunted" then
			return true
		end
		local scale = ride:GetAttribute("StareIntervalScale")
		if typeof(scale) == "number" and scale > 1 and (bandAttr == "uneasy" or bandAttr == "watched" or bandAttr == "hunted") then
			return true
		end
		return false
	end

	local function anomalyKindForId(passengerId: string): string?
		local model = car.passengers:FindFirstChild(passengerId)
		if model == nil or not model:IsA("Model") then
			return nil
		end
		if model:GetAttribute("Hidden") == true then
			return nil
		end
		local tell = model:GetAttribute("Tell")
		if typeof(tell) == "string" then
			return tell
		end
		if model:GetAttribute("Anomaly") == true then
			if passengerId == AnomalySystem.EXTRA_ID then
				return "extra"
			end
			if passengerId == AnomalySystem.MOVED_ID then
				return "moved"
			end
			if passengerId == AnomalySystem.FACETURN_ID then
				return "faceturn"
			end
			if passengerId == AnomalySystem.MOMFACE_ID then
				return "momface"
			end
			return "extra"
		end
		return nil
	end

	local function processGaze(dt: number)
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" then
			return
		end
		local id = gazeTarget
		if id == nil then
			return
		end
		gazeSince += dt
		local scaleAttr = ride:GetAttribute("StareIntervalScale")
		local scale = if typeof(scaleAttr) == "number" then scaleAttr else 1
		local anomalyNeed = Constants.STARE_ANOMALY_SECONDS / math.max(1, scale)
		local parentNeed = Constants.STARE_PARENT_SECONDS / math.max(1, scale)
		if id == "mom" or id == "dad" then
			if not stareParentCharged and gazeSince >= parentNeed then
				stareParentCharged = true
				applySuspicion(Score.stareDelta(true, Constants.STARE_PARENT_SUSPICION))
				showHint(Lines.STARE_PARENT, 2.2)
			end
			return
		end
		if not parentsAlert() or stareAnomalyCharged then
			return
		end
		local kind = anomalyKindForId(id)
		if kind == nil then
			return
		end
		if gazeSince >= anomalyNeed then
			stareAnomalyCharged = true
			applySuspicion(Score.stareDelta(true, Constants.STARE_ANOMALY_SUSPICION))
			showHint(Lines.STARE_CAUGHT, 2.4)
			local stopLabel = ""
			local stopAttr = ride:GetAttribute("NextStop")
			if typeof(stopAttr) == "string" then
				stopLabel = stopAttr
			end
			PsychLog.markSeen(psychLog, kind, stopLabel)
		end
	end

	RunService.Heartbeat:Connect(function(dt: number)
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
			if root ~= nil and root:IsA("BasePart") then
				if lastRootPos ~= nil then
					stretchMovedM += (root.Position - lastRootPos).Magnitude / Constants.STUDS_PER_METER
				end
				lastRootPos = root.Position
			end
		end
		if falseStopOpen and not falseStopReacted and playerNearDoors() then
			falseStopReacted = true
			showHint(Lines.FALSE_STOP_REACT, 2.4)
		end
		processGaze(dt)
	end)

	local function beginDwell(seconds: number)
		ride:SetAttribute("DwellUntil", workspace:GetServerTimeNow() + seconds)
	end

	local function endDwell()
		ride:SetAttribute("DwellUntil", 0)
	end

	local function resolveDeparture(elapsedOpen: number)
		suspicion = Dwell.departureSuspicion(
			suspicion,
			elapsedOpen,
			Constants.MIN_DWELL_SECONDS,
			playerAskedToDepartEarly(),
			Constants.EARLY_DEPARTURE_SUSPICION,
			Constants.SUSPICION_MIN,
			Constants.SUSPICION_MAX
		)
		ride:SetAttribute("Suspicion", suspicion)
	end

	local function setTell(id: string, active: boolean)
		local model = car.passengers:FindFirstChild(id)
		if model == nil or not model:IsA("Model") then
			return
		end
		model:SetAttribute("Anomaly", active)
		model:SetAttribute("Hidden", not active)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and desc.Name ~= "Root" then
				desc.Transparency = if active then 0 else 1
				desc.CanQuery = active
				desc.Color = if active then Constants.COLOR.warn else Constants.COLOR.dark
			end
		end
	end

	local lighttempStrip: BasePart? = nil
	local lighttempOriginal: Color3? = nil
	local movedHome: CFrame? = nil
	local emptyHidden: { string } = {}
	local faceturnRest: { [BasePart]: CFrame } = {}
	local momfaceRest: { [BasePart]: Color3 } = {}

	local function setPlateText(id: string, text: string)
		local model = car.passengers:FindFirstChild(id)
		if model == nil then
			return
		end
		for _, desc in model:GetDescendants() do
			if desc:IsA("TextLabel") and desc.Name == "Text" then
				desc.Text = text
				return
			end
		end
	end

	local function setCatalogHidden(id: string, active: boolean, color: Color3?)
		local model = car.passengers:FindFirstChild(id)
		if model == nil or not model:IsA("Model") then
			return
		end
		model:SetAttribute("Anomaly", active)
		model:SetAttribute("Hidden", not active)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and desc.Name ~= "Root" then
				desc.Transparency = if active then 0 else 1
				desc.CanQuery = active
				if color ~= nil and active then
					desc.Color = color
				elseif not active then
					desc.Color = Constants.COLOR.dark
				end
			end
		end
	end

	local function setCatalogVisible(id: string, active: boolean)
		local model = car.passengers:FindFirstChild(id)
		if model == nil or not model:IsA("Model") then
			return
		end
		model:SetAttribute("Anomaly", active)
		model:SetAttribute("Hidden", false)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and desc.Name ~= "Root" then
				desc.CanQuery = true
			end
		end
	end

	local function clearCatalog()
		setCatalogHidden(AnomalySystem.STICKER_ID, false, nil)
		setCatalogHidden(AnomalySystem.LIGHT_ID, false, nil)
		setCatalogHidden(AnomalySystem.EMPTY_ID, false, nil)
		setCatalogVisible(AnomalySystem.MAP_ID, false)
		setPlateText(AnomalySystem.MAP_ID, Lines.MAP_NORMAL)
		setCatalogVisible(AnomalySystem.NEARWORD_ID, false)
		setPlateText(AnomalySystem.NEARWORD_ID, Lines.AD_NORMAL)
		if lighttempStrip ~= nil and lighttempOriginal ~= nil then
			lighttempStrip.Color = lighttempOriginal
			stripHold[lighttempStrip] = nil
		end
		lighttempStrip = nil
		lighttempOriginal = nil
		local moved = car.passengers:FindFirstChild(AnomalySystem.MOVED_ID)
		if moved ~= nil and moved:IsA("Model") then
			moved:SetAttribute("Anomaly", false)
			if movedHome ~= nil then
				moved:PivotTo(movedHome)
			end
		end
		movedHome = nil
		for _, id in emptyHidden do
			CarBuilder.setPassengerShown(car.passengers, id, true)
		end
		table.clear(emptyHidden)
		local s2 = car.passengers:FindFirstChild(AnomalySystem.FACETURN_ID)
		if s2 ~= nil and s2:IsA("Model") then
			s2:SetAttribute("Anomaly", false)
			for part, cf in faceturnRest do
				part.CFrame = cf
			end
		end
		table.clear(faceturnRest)
		local mom = car.passengers:FindFirstChild(AnomalySystem.MOMFACE_ID)
		if mom ~= nil and mom:IsA("Model") then
			mom:SetAttribute("Anomaly", false)
			for part, color in momfaceRest do
				part.Color = color
			end
		end
		table.clear(momfaceRest)
	end

	local function applyLighttemp()
		local stripName = "LightStrip_02"
		local lightModel = car.passengers:FindFirstChild(AnomalySystem.LIGHT_ID)
		if lightModel ~= nil then
			local named = lightModel:GetAttribute("StripName")
			if typeof(named) == "string" then
				stripName = named
			end
		end
		for _, lamp in car.lamps do
			if lamp.part.Name == stripName then
				lighttempStrip = lamp.part
				lighttempOriginal = lamp.part.Color
				stripHold[lamp.part] = true
				lamp.part.Color = Constants.LIGHTTEMP_COLOR
				break
			end
		end
		setCatalogHidden(AnomalySystem.LIGHT_ID, true, Constants.LIGHTTEMP_COLOR)
	end

	local function applySticker()
		setCatalogHidden(AnomalySystem.STICKER_ID, true, Color3.fromRGB(240, 210, 40))
	end

	local function applyNearword()
		setCatalogVisible(AnomalySystem.NEARWORD_ID, true)
		setPlateText(AnomalySystem.NEARWORD_ID, Lines.AD_WARP)
	end

	local function applyMapstop()
		setCatalogVisible(AnomalySystem.MAP_ID, true)
		setPlateText(AnomalySystem.MAP_ID, Lines.MAP_HOLLOW)
	end

	local function applyMoved()
		local model = car.passengers:FindFirstChild(AnomalySystem.MOVED_ID)
		if model == nil or not model:IsA("Model") then
			return
		end
		movedHome = model:GetPivot()
		model:SetAttribute("Anomaly", true)
		local pivot = model:GetPivot()
		local at = pivot.Position
		-- Keep facing; only slide along the car X (web s3 → far doors).
		model:PivotTo(CFrame.new(Constants.meters(Constants.MOVED_FAR_X), at.Y, at.Z) * (pivot - pivot.Position))
	end

	local function applyEmpty()
		for _, id in { "s1", "s2", "s3", AnomalySystem.EXTRA_ID, "c1", "c2", "c3", "c4", "c5" } do
			local model = car.passengers:FindFirstChild(id)
			if model ~= nil and model:GetAttribute("Hidden") ~= true then
				table.insert(emptyHidden, id)
				CarBuilder.setPassengerShown(car.passengers, id, false)
			end
		end
		setCatalogHidden(AnomalySystem.EMPTY_ID, true, Constants.COLOR.warn)
	end

	local function applyFaceturn()
		local model = car.passengers:FindFirstChild(AnomalySystem.FACETURN_ID)
		if model == nil or not model:IsA("Model") then
			return
		end
		model:SetAttribute("Anomaly", true)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and (desc.Name == "Head" or desc.Name == "Hair" or desc.Name == "Eye") then
				faceturnRest[desc] = desc.CFrame
				desc.CFrame = desc.CFrame * CFrame.Angles(0, 0, math.rad(55))
			end
		end
	end

	local function applyMomface()
		local model = car.passengers:FindFirstChild(AnomalySystem.MOMFACE_ID)
		if model == nil or not model:IsA("Model") then
			return
		end
		model:SetAttribute("Anomaly", true)
		for _, desc in model:GetDescendants() do
			if desc:IsA("BasePart") and (desc.Name == "Head" or desc.Name == "Hair" or desc.Name == "Eye") then
				momfaceRest[desc] = desc.Color
				if desc.Name == "Eye" then
					desc.Color = Color3.fromRGB(20, 20, 28)
				else
					desc.Color = Color3.fromRGB(223, 217, 206)
				end
			end
		end
	end

	local function applyCatalog(kind: string)
		if kind == "lighttemp" then
			applyLighttemp()
		elseif kind == "sticker" then
			applySticker()
		elseif kind == "nearword" then
			applyNearword()
		elseif kind == "mapstop" then
			applyMapstop()
		elseif kind == "moved" then
			applyMoved()
		elseif kind == "empty" then
			applyEmpty()
		elseif kind == "faceturn" then
			applyFaceturn()
		elseif kind == "momface" then
			applyMomface()
		end
	end

	local function clearTells()
		setTell(AnomalySystem.ANNOUNCE_ID, false)
		setTell(AnomalySystem.COUNTDOWN_ID, false)
		clearCatalog()
		ride:SetAttribute("BoardStop", "")
		ride:SetAttribute("BoardMinutes", 0)
	end

	local function anomalyLive(): boolean
		if posterLive then
			return true
		end
		for _, id in {
			AnomalySystem.ANNOUNCE_ID,
			AnomalySystem.COUNTDOWN_ID,
			AnomalySystem.EXTRA_ID,
			AnomalySystem.STICKER_ID,
			AnomalySystem.MAP_ID,
			AnomalySystem.NEARWORD_ID,
			AnomalySystem.LIGHT_ID,
			AnomalySystem.EMPTY_ID,
			AnomalySystem.MOVED_ID,
			AnomalySystem.FACETURN_ID,
			AnomalySystem.MOMFACE_ID,
		} do
			local model = car.passengers:FindFirstChild(id)
			if model ~= nil and model:GetAttribute("Anomaly") == true and model:GetAttribute("Hidden") ~= true then
				return true
			end
		end
		return false
	end

	local function clearExtra()
		CarBuilder.setPassengerShown(car.passengers, AnomalySystem.EXTRA_ID, false)
	end

	local function stopWord(kind: string): (string, string)
		if kind == "noticed" then
			return "caught", Lines.CAUGHT
		end
		if kind == "missed" then
			return "missed", Lines.MISSED
		end
		if kind == "false" then
			return "false", Lines.FALSE_FLAG
		end
		return "clean", Lines.CLEAN
	end

	local pendingDoorChoice: string? = nil
	local choiceEpoch = 0
	local pendingMaskChoice: string? = nil
	local maskEpoch = 0
	local pendingTrialChoice: number? = nil
	local trialEpoch = 0

	doorsRemote.OnServerEvent:Connect(function(_player: Player, choice: any)
		if ride:GetAttribute("ChoiceActive") ~= true then
			return
		end
		if typeof(choice) ~= "string" then
			return
		end
		if choice ~= "stay" and choice ~= "off" then
			return
		end
		pendingDoorChoice = choice
	end)

	maskRemote.OnServerEvent:Connect(function(_player: Player, choice: any)
		if ride:GetAttribute("MaskActive") ~= true then
			return
		end
		if typeof(choice) ~= "string" then
			return
		end
		if choice ~= "A" and choice ~= "B" and choice ~= "C" then
			return
		end
		pendingMaskChoice = choice
	end)

	trialRemote.OnServerEvent:Connect(function(_player: Player, choice: any)
		if ride:GetAttribute("TrialActive") ~= true then
			return
		end
		if typeof(choice) ~= "number" then
			return
		end
		if choice ~= 0 and choice ~= 1 and choice ~= 2 then
			return
		end
		pendingTrialChoice = choice
	end)

	local function waitForDoorChoice(seconds: number): string
		choiceEpoch += 1
		local epoch = choiceEpoch
		pendingDoorChoice = nil
		ride:SetAttribute("ChoiceActive", true)
		ride:SetAttribute("ChoiceUntil", workspace:GetServerTimeNow() + seconds)
		local deadline = os.clock() + seconds
		while os.clock() < deadline and pendingDoorChoice == nil and epoch == choiceEpoch do
			task.wait(0.05)
		end
		ride:SetAttribute("ChoiceActive", false)
		ride:SetAttribute("ChoiceUntil", 0)
		return Doors.normalize(pendingDoorChoice)
	end

	local function clearMaskUi()
		ride:SetAttribute("MaskActive", false)
		ride:SetAttribute("MaskUntil", 0)
		ride:SetAttribute("MaskA", "")
		ride:SetAttribute("MaskB", "")
		ride:SetAttribute("MaskC", "")
	end

	local function waitForMaskChoice(seconds: number, answers: { { text: string, val: string } }): string?
		maskEpoch += 1
		local epoch = maskEpoch
		pendingMaskChoice = nil
		ride:SetAttribute("MaskA", answers[1].text)
		ride:SetAttribute("MaskB", answers[2].text)
		ride:SetAttribute("MaskC", answers[3].text)
		ride:SetAttribute("MaskActive", true)
		ride:SetAttribute("MaskUntil", workspace:GetServerTimeNow() + seconds)
		local deadline = os.clock() + seconds
		while os.clock() < deadline and pendingMaskChoice == nil and epoch == maskEpoch do
			if ride:GetAttribute("Phase") ~= "ride" then
				break
			end
			task.wait(0.05)
		end
		local picked = pendingMaskChoice
		clearMaskUi()
		if picked == nil then
			return nil
		end
		local index = if picked == "A" then 1 elseif picked == "B" then 2 else 3
		return answers[index].val
	end

	local function clearTrialUi()
		ride:SetAttribute("TrialActive", false)
		ride:SetAttribute("TrialUntil", 0)
		ride:SetAttribute("TrialA", "")
		ride:SetAttribute("TrialB", "")
		ride:SetAttribute("TrialC", "")
		ride:SetAttribute("TrialSlots", 0)
	end

	local function waitForTrialChoice(seconds: number, items: { Trial.ChoiceItem }): number?
		trialEpoch += 1
		local epoch = trialEpoch
		pendingTrialChoice = nil
		ride:SetAttribute("TrialA", items[1].text)
		ride:SetAttribute("TrialB", if items[2] then items[2].text else "")
		ride:SetAttribute("TrialC", if items[3] then items[3].text else "")
		ride:SetAttribute("TrialSlots", #items)
		ride:SetAttribute("TrialActive", true)
		if seconds > 0 then
			ride:SetAttribute("TrialUntil", workspace:GetServerTimeNow() + seconds)
		else
			ride:SetAttribute("TrialUntil", 0)
		end
		local deadline = if seconds > 0 then os.clock() + seconds else math.huge
		while os.clock() < deadline and pendingTrialChoice == nil and epoch == trialEpoch do
			if ride:GetAttribute("Phase") ~= "trial" then
				break
			end
			task.wait(0.05)
		end
		local picked = pendingTrialChoice
		clearTrialUi()
		return picked
	end

	local segToken = 0

	local function runTrial(token: number, stopName: string, stopNumber: number): boolean
		table.insert(trialStops, stopNumber)
		ride:SetAttribute("Phase", "trial")
		clearMaskUi()
		TrialSpace.setVisible(trialSpace.model, true)
		TrialSpace.teleportPlayers(trialSpace.spawn)
		showHint(Lines.TRIAL_HINT, Constants.TRIAL_HINT_SECONDS)

		local state = Trial.start(stopName)
		local rng = function()
			return math.random()
		end
		local clean = false

		while token == segToken do
			local roundState, view = Trial.round(state, rng)
			state = roundState
			TrialSpace.applyRound(trialSpace, view.signs, view.boardDoors)

			local cycleAt = os.clock()
			local events = Trial.cycleEvents(state, rng)
			local eventDone: { [number]: boolean } = {}
			ride:SetAttribute("TrialChime", workspace:GetServerTimeNow())

			local conn = RunService.Heartbeat:Connect(function(dt: number)
				if ride:GetAttribute("Phase") ~= "trial" then
					return
				end
				local elapsed = os.clock() - cycleAt
				if elapsed >= Constants.TRIAL_CYCLE then
					cycleAt = os.clock()
					events = Trial.cycleEvents(state, rng)
					eventDone = {}
					ride:SetAttribute("TrialChime", workspace:GetServerTimeNow())
					elapsed = 0
				end
				for i, event in events do
					if eventDone[i] ~= true and elapsed >= event.at then
						eventDone[i] = true
						local opening = trialSpace.openings[event.index + 1]
						if opening ~= nil then
							if event.kind == "flick" then
								TrialSpace.flick(opening, os.clock() + Constants.TRIAL_FLICK_SECONDS)
							elseif event.kind == "open" then
								TrialSpace.setDoorTarget(opening, 1)
							else
								TrialSpace.setDoorTarget(opening, 0)
							end
						end
					end
				end
				TrialSpace.step(trialSpace, dt, os.clock())
			end)

			local picked = waitForTrialChoice(view.windowSeconds, view.items)
			conn:Disconnect()
			if token ~= segToken then
				break
			end

			task.wait(0.7)
			if token ~= segToken then
				break
			end
			local result = Trial.applyPick(state, picked)
			state = result.state
			if result.subtitle ~= "" then
				showSub(result.subtitle, 3.0)
				task.wait(1.2)
			end
			if result.kind == "exit" then
				clean = result.clean == true
				break
			end
		end

		clearTrialUi()
		TrialSpace.setVisible(trialSpace.model, false)
		TrialSpace.teleportPlayers(carReturn)
		applySuspicion(Constants.TRIAL_EXIT_SUSPICION)
		applySanity(-Constants.TRIAL_SANITY)
		ride:SetAttribute("Phase", "stop")
		if clean then
			showSub(Lines.MOM_TRIAL_CLEAN, 3.4)
		else
			showSub(Lines.MOM_TRIAL_ROUGH, 3.4)
		end
		task.wait(3.6)
		if token ~= segToken then
			return false
		end
		showSub(Lines.DAD_TRIAL_SIT, 2.6)
		task.wait(2.8)
		return token == segToken
	end

	local function runMaskCheck(token: number)
		if maskBusy or token ~= segToken then
			return
		end
		if ride:GetAttribute("Phase") ~= "ride" then
			return
		end
		if ride:GetAttribute("ChoiceActive") == true then
			return
		end
		if ride:GetAttribute("RestraintActive") == true or ride:GetAttribute("Intervening") == true then
			return
		end
		local bandAttr = ride:GetAttribute("Band")
		local bandName = if typeof(bandAttr) == "string" then bandAttr else "calm"
		local pool = Dialogue.maskPoolForBand(bandName, suspicion, Constants.MASK_NEED_SUSPICION)
		local line = Dialogue.pickMask(pool, maskUsed, maskLast, function()
			return math.random()
		end)
		if line == nil then
			return
		end
		maskBusy = true
		maskUsed[line.line] = true
		maskLast = line.line
		showSub(Dialogue.maskPrompt(line.who, line.line), Constants.MASK_PROMPT_SECONDS)
		local answers = Dialogue.shuffleAnswers(line.calm, line.off[1], line.off[2], function()
			return math.random()
		end)
		local val = waitForMaskChoice(Constants.MASK_CHOICE_SECONDS, answers)
		if token ~= segToken then
			maskBusy = false
			return
		end
		if val == nil then
			applySuspicion(Constants.MASK_TIMEOUT_SUSPICION)
			applySanity(-Constants.MASK_TIMEOUT_SANITY)
			showSub(Dialogue.maskHesitate(line.who), 2.6)
		elseif val == "calm" then
			showSub(Dialogue.youAnswer(line.calm, line.who), 2.4)
		else
			applySuspicion(Constants.MASK_FAIL_SUSPICION)
			applySanity(-Constants.MASK_FAIL_SANITY)
			showSub(Dialogue.maskOdd(line.who), 2.8)
		end
		maskBusy = false
	end

	-- Single-car slice: one shared gaze (same as Flag / Meta). Only the
	-- ride owner (metaUserId, else first player) may update it. The id must
	-- name a real passenger model that is not Hidden.
	gazeRemote.OnServerEvent:Connect(function(player: Player, passengerId: any)
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" and phase ~= "haven" then
			gazeTarget = nil
			gazeSince = 0
			return
		end
		local owner = metaUserId
		if owner == nil then
			local list = Players:GetPlayers()
			if #list > 0 then
				owner = list[1].UserId
			end
		end
		if owner == nil or player.UserId ~= owner then
			return
		end
		local id: string? = nil
		if typeof(passengerId) == "string" and passengerId ~= "" then
			local model = car.passengers:FindFirstChild(passengerId)
			if model ~= nil and model:IsA("Model") and model:GetAttribute("Hidden") ~= true then
				id = passengerId
			end
		end
		if id ~= gazeTarget then
			gazeTarget = id
			gazeSince = 0
		end
	end)

	flagRemote.OnServerEvent:Connect(function(player: Player, passengerId: any)
		if typeof(passengerId) ~= "string" then
			return
		end
		if ride:GetAttribute("Phase") ~= "ride" then
			return
		end
		if ride:GetAttribute("RestraintActive") == true or ride:GetAttribute("Intervening") == true then
			return
		end
		if flagged[passengerId] then
			return
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root == nil or not root:IsA("BasePart") then
			return
		end
		local model = car.passengers:FindFirstChild(passengerId)
		if model == nil or not model:IsA("Model") then
			return
		end
		if model:GetAttribute("Hidden") == true then
			return
		end
		local offset = model:GetPivot().Position - root.Position
		local horizontal = Vector3.new(offset.X, 0, offset.Z)
		-- In the car. The client crosshair picks who; this only rejects a flag
		-- fired from outside the car. Body facing lags the camera, so it is
		-- not used as a second gaze test.
		if horizontal.Magnitude > Constants.meters(Constants.FLAG_RANGE_M) then
			return
		end

		flagged[passengerId] = true
		local labelAttr = model:GetAttribute("Label")
		local label = if typeof(labelAttr) == "string" then labelAttr else passengerId
		local tellKind = model:GetAttribute("Tell")
		local isTell = typeof(tellKind) == "string"
		local marked = model:GetAttribute("Anomaly") == true
		local verdict = AnomalySystem.verdict(marked and not isTell, isTell, marked)
		local live = anomalyLive()
		if verdict == "noticed" then
			caught = true
			stopNoticed = true
			local catchId = if isTell and typeof(tellKind) == "string" then tellKind else "extra"
			if isTell and typeof(tellKind) == "string" then
				anomalyTypesSeen[tellKind] = true
			elseif marked then
				anomalyTypesSeen["extra"] = true
			end
			local stopLabel = ""
			local stopAttr = ride:GetAttribute("NextStop")
			if typeof(stopAttr) == "string" then
				stopLabel = stopAttr
			end
			PsychLog.markCaught(psychLog, catchId, stopLabel)
			showFeedback("caught", Lines.CAUGHT, false)
		else
			falseFlags += 1
			showFeedback("false", Lines.falseFlag(label), false)
			if not live then
				stopFalseAlarm = true
			end
		end
		applySuspicion(Score.flagDelta(verdict == "noticed", live, Constants.FALSE_ALARM_SUSPICION, Constants.CORRECT_FLAG_SUSPICION))
	end)

	local function tapeIds(): { string }
		local ids = {}
		for _, tape in evpState.tapes do
			table.insert(ids, tape.signalId)
		end
		return ids
	end

	local function waitForExitChoice(seconds: number): Endings.ExitChoice
		exitEpoch += 1
		local epoch = exitEpoch
		pendingExitChoice = nil
		ride:SetAttribute("ExitActive", true)
		ride:SetAttribute("ExitUntil", workspace:GetServerTimeNow() + seconds)
		local deadline = os.clock() + seconds
		while os.clock() < deadline and pendingExitChoice == nil and epoch == exitEpoch do
			task.wait(0.05)
		end
		ride:SetAttribute("ExitActive", false)
		ride:SetAttribute("ExitUntil", 0)
		return Endings.normalizeExit(pendingExitChoice)
	end

	local function publishReport(def: Endings.EndingDefinition, summary: Endings.EndingSummary)
		ride:SetAttribute("EndingId", def.id)
		ride:SetAttribute("EndingTitle", def.title)
		ride:SetAttribute("EndingBadge", def.badge)
		ride:SetAttribute("EndingNarrative", def.narrative)
		local restraintLine = if summary.restraintOK then "held" else "failed / skipped"
		local modeLine = if practiceOn
			then "Mode             PRACTICE (nothing saved)"
			elseif nightmareOn then "Mode             NIGHTMARE"
			else "Mode             Standard"
		local stats = table.concat({
			modeLine,
			"Sanity Retained  " .. tostring(summary.sanPct) .. "%",
			"Peak Suspicion   " .. tostring(summary.peak),
			"Anomaly Accuracy " .. tostring(summary.accPct) .. "%  (" .. tostring(accCorrect) .. "/" .. tostring(
				accCorrect + accMiss
			) .. ")",
			"Interventions    " .. tostring(summary.interventions),
			"Trials           " .. tostring(#summary.trialStops),
			"Restraint        " .. restraintLine,
			"Tapes            " .. tostring(#summary.tapes),
			"Exit             " .. summary.exit,
			"False flags      " .. tostring(falseFlags),
		}, "\n")
		ride:SetAttribute("ReportStats", stats)
		ride:SetAttribute("ReportPsych", PsychLog.formatReport(psychLog))
		ride:SetAttribute("ReportReady", true)
	end

	local function formatArchive(data: MetaStore.Save): string
		local endingCount = 0
		for _ in data.endings do
			endingCount += 1
		end
		local lines = {
			"CASE FILES",
			"Runs " .. tostring(data.runsCompleted),
			"Endings " .. tostring(endingCount),
			"Achievements " .. tostring(Achievements.count(data.achievements)),
			"Tapes " .. tostring(#data.tapes),
			"Album " .. tostring(#data.album),
		}
		for _, id in Achievements.IDS do
			if Achievements.has(data.achievements, id) then
				table.insert(lines, "• " .. Achievements.definition(id).title)
			end
		end
		for id, entry in data.endings do
			table.insert(lines, "◇ " .. id .. " ×" .. tostring(entry.count))
		end
		return table.concat(lines, "\n")
	end

	local function refreshMetaPublish()
		local uid = metaUserId
		if uid == nil then
			local list = Players:GetPlayers()
			if #list > 0 then
				uid = list[1].UserId
				metaUserId = uid
			end
		end
		if uid == nil then
			ride:SetAttribute("NightmareUnlocked", false)
			ride:SetAttribute("MetaArchive", "CASE FILES\n(no player yet)")
			return
		end
		local data = MetaStore.load(uid)
		ride:SetAttribute("NightmareUnlocked", data.nightmareUnlocked or data.runsCompleted > 0)
		ride:SetAttribute("MetaArchive", formatArchive(data))
	end

	-- Single-car slice: one shared ride. Progress belongs to metaUserId
	-- (whoever fired MetaStart / MetaAgain). Fallback is first player only.
	local function persistMeta(def: Endings.EndingDefinition)
		if Practice.offRecord(practiceOn, false) then
			return
		end
		local uid = metaUserId
		if uid == nil then
			local list = Players:GetPlayers()
			if #list == 0 then
				return
			end
			uid = list[1].UserId
			metaUserId = uid
		end
		local data = MetaStore.load(uid)
		data.runsCompleted += 1
		data.nightmareUnlocked = true
		MetaStore.recordEnding(data, def.id, os.time())
		local tapes: { MetaStore.TapeEntry } = {}
		for _, tape in evpState.tapes do
			table.insert(tapes, {
				signalId = tape.signalId,
				title = tape.title,
				stop = tape.stop,
				freq = tape.freq,
				transcript = tape.transcript,
			})
		end
		MetaStore.mergeTapes(data, tapes, Constants.META_TAPE_ARCHIVE_MAX)
		local album: { MetaStore.PhotoEntry } = {}
		for _, photo in polaroidPhotos do
			table.insert(album, { id = photo.id, framed = photo.framed })
		end
		MetaStore.mergeAlbum(data, album, Constants.META_ALBUM_ARCHIVE_MAX)
		for id in anomalyTypesSeen do
			data.anomalyTypes[id] = true
		end
		local now = os.time()
		if peakSuspicion == 0 then
			Achievements.unlock(data.achievements, "iron_composure", now, false)
		end
		if def.id ~= "civilian_extraction" then
			Achievements.unlock(data.achievements, "loop_breaker", now, false)
		end
		if accCorrect > 0 then
			Achievements.unlock(data.achievements, "first_anomaly", now, false)
		end
		if anomalyTypesSeen["photo"] == true then
			Achievements.unlock(data.achievements, "photo_evidence", now, false)
		end
		if #evpState.tapes >= 3 then
			Achievements.unlock(data.achievements, "tuning_pro", now, false)
		end
		for _, tape in evpState.tapes do
			if string.sub(tape.signalId, 1, 8) == "station-" then
				Achievements.unlock(data.achievements, "broadcaster_lore", now, false)
				break
			end
		end
		if trestleBadgeChecked then
			Achievements.unlock(data.achievements, "trestle_cross", now, false)
		end
		local documented = 0
		for _ in data.anomalyTypes do
			documented += 1
		end
		if documented >= 6 then
			Achievements.unlock(data.achievements, "master_archivist", now, false)
		end
		MetaStore.save(uid, data)
		refreshMetaPublish()
	end

	local function finishScore()
		local miss = if caught then 0 else 1
		local kind = if caught then "caught" else "missed"
		local word = if caught then Lines.CAUGHT else Lines.MISSED
		showFeedback(kind, word, true)
		showSub(Lines.scoreLine(miss, falseFlags), 8)
	end

	local function endGameAtCourtSq()
		sampleSanity()
		finalExit = waitForExitChoice(Constants.EXIT_CHOICE_SECONDS)
		showSub(Endings.exitLine(finalExit), 3.0)
		task.wait(3.2)
		local summary: Endings.EndingSummary = {
			peak = peakSuspicion,
			interventions = interventions,
			trialStops = trialStops,
			sanPct = Sanity.retainedPercent(sanSamples),
			accPct = Endings.accuracyPercent(accCorrect, accMiss),
			restraintOK = restraintOK,
			tapes = tapeIds(),
			exit = finalExit,
		}
		-- No hard fail at suspicion 100: resolveEnding never invents one.
		local def = Endings.resolve(summary)
		finishScore()
		publishReport(def, summary)
		persistMeta(def)
		ride:SetAttribute("Phase", "end")
		ride:SetAttribute("NextStop", Route.stopName(13))
	end

	-- One named tube, on and off. stripHold keeps applyLights from painting
	-- that tube. No other lamp is touched, and forcedOff is not set.
	local function blinkOneStrip(token: number, seconds: number)
		local deadline = os.clock() + seconds
		task.spawn(function()
			local dark = false
			while token == segToken and os.clock() < deadline do
				dark = not dark
				for _, lamp in car.lamps do
					if lamp.part.Name == Constants.HOLD_STRIP_NAME then
						if dark then
							stripHold[lamp.part] = true
							lamp.part.Color = Constants.COLOR.lightOff
						else
							stripHold[lamp.part] = nil
						end
						break
					end
				end
				task.wait(Constants.HOLD_BLINK)
			end
			for _, lamp in car.lamps do
				if lamp.part.Name == Constants.HOLD_STRIP_NAME then
					stripHold[lamp.part] = nil
					break
				end
			end
		end)
	end

	local function runSegment(seg: Route.Segment)
		segToken += 1
		local token = segToken
		currentSegStop = seg.stop
		ride:SetAttribute("SegStop", seg.stop)
		ride:SetAttribute("Phase", "ride")
		ride:SetAttribute("NextStop", Route.stopName(seg.stop))
		ride:SetAttribute("ChapterLine", Route.chapterLine(seg.stop))
		CarBuilder.setCrowd(car.passengers, seg.crowd)
		clearExtra()
		setDoorTarget(0)

		if not seg.b then
			sampleSanity()
		end
		bandStop = seg.stop
		applySanity(Nightmare.driftDelta(Sanity.driftForStop(seg.stop), nightmareOn))

		local cruiseLen = Nightmare.cruiseSeconds(seg.sliceCruise, nightmareOn)
		local length = Constants.ACCEL + cruiseLen + Constants.BRAKE
		inFinal = seg.final
		if seg.final and huntedDim then
			huntedDim = false
		end
		local held = Hold.applies(seg.stop, seg.b, seg.final, Constants.HOLD_STOP_A, Constants.HOLD_STOP_B)
			and Hold.placed(Constants.HOLD_AT, Constants.HOLD_SECONDS, Constants.ACCEL, cruiseLen)
		local holdAt = if held then Constants.HOLD_AT else 0
		local holdFor = if held then Constants.HOLD_SECONDS else 0
		beginStretch(seg, holdAt, holdFor)
		if seg.final then
			beginDim(Constants.FINAL_DIM, length)
		end

		local picked = AnomalySystem.pick(seg.stop, seg.b, {
			posterStop = Constants.ANOMALY_POSTER_STOP,
			extraStop = Constants.ANOMALY_EXTRA_STOP,
			announceStop = Constants.ANOMALY_ANNOUNCE_STOP,
			countdownStop = Constants.ANOMALY_COUNTDOWN_STOP,
			lighttempStop = Constants.ANOMALY_LIGHTTEMP_STOP,
			stickerStop = Constants.ANOMALY_STICKER_STOP,
			nearwordStop = Constants.ANOMALY_NEARWORD_STOP,
			mapstopStop = Constants.ANOMALY_MAPSTOP_STOP,
			movedStop = Constants.ANOMALY_MOVED_STOP,
			emptyStop = Constants.ANOMALY_EMPTY_STOP,
			faceturnStop = if Constants.ANOMALY_FACETURN_STOP > 0 then Constants.ANOMALY_FACETURN_STOP else nil,
			momfaceStop = if Constants.ANOMALY_MOMFACE_STOP > 0 then Constants.ANOMALY_MOMFACE_STOP else nil,
		})
		stopHadAnomaly = picked ~= nil
		stopNoticed = false
		stopFalseAlarm = false
		posterLive = false
		stareAnomalyCharged = false
		stareParentCharged = false
		gazeSince = 0
		stretchMovedM = 0
		lastRootPos = nil
		if picked ~= nil then
			PsychLog.markSeen(psychLog, picked, Route.stopName(seg.stop))
		end
		clearCatalog()
		local wrongCountdown = picked == "wrong_countdown"
		setTell(AnomalySystem.COUNTDOWN_ID, wrongCountdown)
		setTell(AnomalySystem.ANNOUNCE_ID, false)
		ride:SetAttribute("BoardStop", Route.stopName(seg.stop))
		ride:SetAttribute(
			"BoardMinutes",
			AnomalySystem.boardMinutes(Constants.COUNTDOWN_MINUTES, Constants.WRONG_COUNTDOWN_MINUTES, wrongCountdown)
		)

		if not seg.silent then
			task.delay(Constants.NEXT_STOP_AT, function()
				if token ~= segToken then
					return
				end
				local actual = Route.stopName(seg.stop)
				local announced = actual
				if picked == "wrong_announcement" then
					announced = AnomalySystem.wrongStop(
						actual,
						Route.stopName(Constants.WRONG_ANNOUNCE_STOP),
						Route.stopName(Constants.WRONG_ANNOUNCE_FALLBACK_STOP)
					)
					setTell(AnomalySystem.ANNOUNCE_ID, true)
					task.delay(Constants.NEXT_STOP_FOR, function()
						if token ~= segToken then
							return
						end
						setTell(AnomalySystem.ANNOUNCE_ID, false)
					end)
				end
				showPa(Lines.nextStop(announced), Constants.NEXT_STOP_FOR)
			end)
		end
		if seg.kind == "haven" then
			local cueAt = math.max(Constants.NEXT_STOP_AT + 0.5, length - Haven.APPROACH_LEAD)
			task.delay(cueAt, function()
				if token ~= segToken or ride:GetAttribute("Phase") ~= "ride" then
					return
				end
				if ride:GetAttribute("MaskActive") == true then
					return
				end
				showSub(Lines.MOM_HAVEN_CUE, 3.2)
			end)
		end
		if Haven.shouldTrainHandoff(hasRecorder, seg.stop, seg.b) then
			task.delay(Haven.TRAIN_HANDOFF_AT, function()
				if token ~= segToken or ride:GetAttribute("Phase") ~= "ride" then
					return
				end
				giveRecorder("train")
			end)
		end
		local chatIndex = seg.chat
		if chatIndex ~= nil then
			local exchange = Dialogue.chatFor(chatPlan, chatIndex)
			task.delay(Constants.CHAT_AT_1, function()
				if token ~= segToken or ride:GetAttribute("Phase") ~= "ride" then
					return
				end
				if ride:GetAttribute("MaskActive") == true or ride:GetAttribute("ChoiceActive") == true then
					return
				end
				-- Hunted: swap in a band-tuned parent exchange.
				local bandAttr = ride:GetAttribute("Band")
				local use = exchange
				if bandAttr == "hunted" then
					use = Dialogue.huntedChat(function()
						return math.random()
					end)
				end
				if use == nil then
					return
				end
				local first = use[1]
				local second = use[2]
				showSub(Dialogue.chatLine(first.who, first.line), Constants.CHAT_LINE_SECONDS)
				task.delay(Constants.CHAT_AT_2 - Constants.CHAT_AT_1, function()
					if token ~= segToken or ride:GetAttribute("Phase") ~= "ride" then
						return
					end
					if ride:GetAttribute("MaskActive") == true or ride:GetAttribute("ChoiceActive") == true then
						return
					end
					showSub(Dialogue.chatLine(second.who, second.line), Constants.CHAT_LINE_SECONDS)
				end)
			end)
		end
		local maskTimes = seg.masks
		if maskTimes ~= nil then
			for _, at in maskTimes do
				task.delay(at, function()
					if token ~= segToken then
						return
					end
					runMaskCheck(token)
				end)
			end
		end
		if picked == "poster_changed" then
			task.delay(8, function()
				if token ~= segToken then
					return
				end
				for _, desc in car.model:GetDescendants() do
					if desc:IsA("BasePart") and string.sub(desc.Name, 1, 3) == "Ad_" and desc.Transparency < 0.5 then
						posterOriginal[desc] = desc.Color
						desc.Color = Color3.fromRGB(120, 36, 32)
						posterLive = true
						break
					end
				end
			end)
		end
		if picked == "extra" then
			task.delay(Constants.EXTRA_APPEAR_AT, function()
				if token ~= segToken then
					return
				end
				CarBuilder.setPassengerShown(car.passengers, AnomalySystem.EXTRA_ID, true)
			end)
		end
		if
			picked == "lighttemp"
			or picked == "sticker"
			or picked == "nearword"
			or picked == "mapstop"
			or picked == "moved"
			or picked == "empty"
			or picked == "faceturn"
			or picked == "momface"
		then
			task.delay(Constants.CATALOG_APPEAR_AT, function()
				if token ~= segToken then
					return
				end
				applyCatalog(picked)
			end)
		end
		if not seg.b and seg.stop == 5 then
			task.delay(9, function()
				if token ~= segToken then
					return
				end
				for _, lamp in car.lamps do
					if lamp.part.Name == "LightStrip_04" then
						stripHold[lamp.part] = true
						lamp.part.Color = Constants.COLOR.lightOff
						task.delay(0.15, function()
							stripHold[lamp.part] = nil
						end)
						break
					end
				end
			end)
		end
		if seg.final then
			local lastAt = math.max(Constants.NEXT_STOP_AT + Constants.NEXT_STOP_FOR + 0.4, length - 9)
			task.delay(lastAt, function()
				if token ~= segToken then
					return
				end
				showPa(Lines.LAST_PA, 5)
			end)
		end
		if held then
			local rawEffect = if seg.stop == Constants.HOLD_STOP_B then Constants.HOLD_EFFECT_B else Constants.HOLD_EFFECT_A
			local effect = Hold.plan(rawEffect)
			task.delay(holdAt, function()
				if token ~= segToken then
					return
				end
				ride:SetAttribute("Held", true)
				ride:SetAttribute("StareIntervalScale", Hold.stareScale(true, Constants.HOLD_STARE_MULTIPLIER))
				if effect == "dim" then
					beginDim(Hold.dimTarget(Constants.HOLD_DIM), Constants.HOLD_SECONDS)
				else
					blinkOneStrip(token, Constants.HOLD_SECONDS)
				end
				local tell = if seg.stop == Constants.HOLD_TELL_STOP then Hold.tell(Constants.HOLD_TELL) else nil
				if tell == "wrong_countdown" and picked ~= "wrong_countdown" then
					setTell(AnomalySystem.COUNTDOWN_ID, true)
					stopHadAnomaly = true
					ride:SetAttribute("BoardMinutes", AnomalySystem.boardMinutes(Constants.COUNTDOWN_MINUTES, Constants.WRONG_COUNTDOWN_MINUTES, true))
				end
				task.delay(Constants.HOLD_SECONDS, function()
					if token ~= segToken then
						return
					end
					ride:SetAttribute("Held", false)
					ride:SetAttribute("StareIntervalScale", Hold.stareScale(false, Constants.HOLD_STARE_MULTIPLIER))
					if effect == "dim" then
						beginDim(1, Constants.HOLD_RECOVER)
					end
					if tell == "wrong_countdown" and picked ~= "wrong_countdown" then
						setTell(AnomalySystem.COUNTDOWN_ID, false)
						ride:SetAttribute(
							"BoardMinutes",
							AnomalySystem.boardMinutes(Constants.COUNTDOWN_MINUTES, Constants.WRONG_COUNTDOWN_MINUTES, false)
						)
					end
				end)
			end)
		end
		if seg.restraint == true then
			task.delay(Constants.RESTRAINT_START_AT, function()
				if token ~= segToken then
					return
				end
				if ride:GetAttribute("Phase") ~= "ride" then
					return
				end
				startRestraintMoment()
			end)
		end
		task.wait(Hold.wallDuration(length, held, holdFor))
		-- Web waits for the restraint to finish before arrival.
		if token == segToken and seg.restraint == true and not restraintDone then
			if restraintState == nil then
				startRestraintMoment()
			end
			local deadline = os.clock() + Constants.RESTRAINT_DURATION + Constants.RESTRAINT_WAIT + 2
			while token == segToken and restraintState ~= nil and os.clock() < deadline do
				task.wait(0.05)
			end
			if token == segToken and restraintState ~= nil then
				endRestraint(false, Lines.RESTRAINT_FAIL_WAIT)
			end
		end
	end

	local function at(t0: number, t: number)
		local remain = t - (os.clock() - t0)
		if remain > 0 then
			task.wait(remain)
		end
	end

	local function arrive(seg: Route.Segment)
		segToken += 1
		local token = segToken
		maskEpoch += 1
		clearMaskUi()
		maskBusy = false
		currentSegStop = nil
		ride:SetAttribute("SegStop", 0)
		if evpState.raised then
			-- Carriers only while moving; keep the recorder up but clear the lock.
			publishEvp()
		end
		ride:SetAttribute("Phase", "stop")
		if stopHadAnomaly then
			if stopNoticed then
				accCorrect += 1
			else
				accMiss += 1
			end
		end
		local kind = Score.result(stopHadAnomaly, stopNoticed, stopFalseAlarm)
		applySuspicion(Score.endDelta(kind, Constants.CLEAN_STOP_SUSPICION, Constants.DECAY_SUSPICION))
		if kind == "clean" then
			local still = stretchMovedM < Constants.SITTING_STILL_MOVE_M
			applySuspicion(Score.sittingStillDelta(still, Constants.SITTING_STILL_SUSPICION))
		end
		stretchMovedM = 0
		lastRootPos = nil
		stareAnomalyCharged = false
		stareParentCharged = false
		gazeSince = 0
		falseStopReacted = false
		falseStopOpen = false
		local feedbackKind, word = stopWord(kind)
		showFeedback(feedbackKind, word, false)
		clearTells()
		clearExtra()
		ride:SetAttribute("Held", false)
		ride:SetAttribute("StareIntervalScale", Hold.stareScale(false, Constants.HOLD_STARE_MULTIPLIER))
		for part, color in posterOriginal do
			part.Color = color
			posterOriginal[part] = nil
		end
		local t0 = os.clock()

		if seg.tick == "flicker" then
			blackout()
		end

		if seg.final then
			at(t0, 2.3)
			setDoorTarget(1)
			-- Doors stay open. There is no departure, so the penalty is not applied.
			beginDwell(Constants.MIN_DWELL_SECONDS)
			task.delay(Constants.MIN_DWELL_SECONDS, function()
				if token ~= segToken then
					return
				end
				endDwell()
			end)
			at(t0, 3.4)
			showSub(Lines.MOM_ARRIVE, 4)
			at(t0, 6.6)
			endGameAtCourtSq()
			return
		end

		if seg.paLie ~= nil then
			at(t0, 0.2)
			local lie = seg.paLie
			if lie ~= nil then
				showPa(lie, 5)
			end
		elseif not seg.silent and seg.kind ~= "false" then
			at(t0, 0.9)
			showPa(Lines.thisIs(Route.stopName(seg.stop)), 3)
		end

		local openAt = 0.35 + (if seg.tick == "doors" then 1.15 else 1.95)
		at(t0, openAt)
		setDoorTarget(1)
		local openedAt = os.clock()
		if seg.kind == "false" then
			falseStopOpen = true
		end

		-- Minimum dwell still runs while the player chooses Stay / Step off.
		beginDwell(Constants.MIN_DWELL_SECONDS)
		task.delay(Constants.MIN_DWELL_SECONDS, function()
			if token ~= segToken then
				return
			end
			endDwell()
		end)
		showHint(Lines.DOOR_PROMPT, Constants.DOOR_CHOICE_SECONDS)
		local picked = waitForDoorChoice(Constants.DOOR_CHOICE_SECONDS)
		if token ~= segToken then
			return
		end
		endDwell()
		if seg.kind == "false" then
			falseStopOpen = false
			applySuspicion(Score.falseStopDelta(playerReactedAtFalseStop(), Constants.FALSE_STOP_REACT_SUSPICION))
		end
		local outcome = Doors.resolve(
			seg.kind,
			seg.forgiving,
			picked,
			{
				realOff = Constants.STEP_OFF_REAL_SUSPICION,
				refuseHaven = Constants.REFUSE_HAVEN_SUSPICION,
				falseOff = Constants.FALSE_STOP_STEP_OFF_SUSPICION,
			},
			Lines.MOM_REAL_OFF,
			Lines.MOM_REFUSE_HAVEN,
			Lines.MOM_FALSE_FORGIVING,
			Lines.HAVEN_STUB,
			Lines.TRIAL_STUB
		)
		if outcome.suspicionDelta ~= 0 then
			applySuspicion(outcome.suspicionDelta)
		end
		if outcome.mode == "haven" then
			ride:SetAttribute("Phase", "haven")
			local h0 = os.clock()
			at(h0, Haven.MOM_STAND_AT)
			if token ~= segToken then
				return
			end
			showSub(Lines.MOM_HAVEN_STAND, 2.6)
			at(h0, Haven.DAD_STOPS_AT)
			if token ~= segToken then
				return
			end
			showSub(Lines.DAD_HAVEN_STOPS, 2.8)
			at(h0, Haven.RECORDER_AT)
			if token ~= segToken then
				return
			end
			giveRecorder("haven")
			at(h0, Haven.SANITY_AT)
			if token ~= segToken then
				return
			end
			applySanity(Constants.SANITY_HAVEN)
			showSub(Lines.HAVEN_BOARD, 2.0)
			at(h0, Haven.DEPART_AT)
			if token ~= segToken then
				return
			end
			ride:SetAttribute("Phase", "stop")
		elseif outcome.mode == "trial" then
			local ok = runTrial(token, Route.stopName(seg.stop), seg.stop)
			if not ok or token ~= segToken then
				return
			end
		else
			if outcome.line ~= "" then
				showSub(outcome.line, math.max(2.5, outcome.holdSeconds))
			end
			if outcome.holdSeconds > 0 then
				task.wait(outcome.holdSeconds)
			end
		end
		if token ~= segToken then
			return
		end
		-- A PA lie keeps doors open at least PA_LIE_HOLD from arrival before leave.
		local lieHold = if seg.paLie ~= nil then Constants.PA_LIE_HOLD else nil
		if lieHold ~= nil then
			local remainLie = lieHold - (os.clock() - t0)
			if remainLie > 0 then
				task.wait(remainLie)
			end
		end
		resolveDeparture(os.clock() - openedAt)
		showPa(Lines.STAND_CLEAR, 3)
		task.wait(1.4)
		setDoorTarget(0)
		task.wait(1.2)
	end

	metaStartRemote.OnServerEvent:Connect(function(player: Player, nightmare: any, chapter: any)
		if ride:GetAttribute("Phase") ~= "menu" then
			return
		end
		if pendingStart ~= nil then
			return
		end
		metaUserId = player.UserId
		local ch = if typeof(chapter) == "number" then Practice.normalizeChapter(chapter) else 1
		local data = MetaStore.load(player.UserId)
		local unlocked = data.nightmareUnlocked or data.runsCompleted > 0
		if ch > 1 and not unlocked then
			ch = 1
		end
		local nm = nightmare == true and unlocked
		pendingStart = { nightmare = nm, chapter = ch }
	end)

	metaAgainRemote.OnServerEvent:Connect(function(player: Player)
		if ride:GetAttribute("Phase") ~= "end" or ride:GetAttribute("ReportReady") ~= true then
			return
		end
		metaUserId = player.UserId
		pendingAgain = true
	end)

	Players.PlayerAdded:Connect(function(player: Player)
		if metaUserId == nil then
			metaUserId = player.UserId
			refreshMetaPublish()
		end
	end)
	for _, player in Players:GetPlayers() do
		if metaUserId == nil then
			metaUserId = player.UserId
		end
	end
	refreshMetaPublish()

	local function clearReport()
		ride:SetAttribute("ReportReady", false)
		ride:SetAttribute("EndingId", "")
		ride:SetAttribute("EndingTitle", "")
		ride:SetAttribute("EndingBadge", "")
		ride:SetAttribute("EndingNarrative", "")
		ride:SetAttribute("ReportStats", "")
		ride:SetAttribute("ReportPsych", "")
	end

	local function resetRunState()
		table.clear(flagged)
		falseFlags = 0
		caught = false
		suspicion = 0
		peakSuspicion = 0
		sanity = Constants.SANITY_START
		bandStop = 1
		table.clear(sanSamples)
		interventions = 0
		intervening = false
		restraintState = nil
		restraintDone = false
		restraintOK = false
		restraintHeld = false
		table.clear(restraintHidden)
		table.clear(restraintMomRest)
		accCorrect = 0
		accMiss = 0
		table.clear(trialStops)
		finalExit = "escalators"
		pendingExitChoice = nil
		stopHadAnomaly = false
		stopNoticed = false
		stopFalseAlarm = false
		posterLive = false
		inFinal = false
		huntedDim = false
		table.clear(maskUsed)
		maskLast = nil
		maskBusy = false
		chatPlan = Dialogue.buildChatPlan(function()
			return math.random()
		end)
		hasRecorder = false
		evpState = Evp.newState(function()
			return math.random()
		end)
		currentSegStop = nil
		cameraRaised = false
		albumOpen = false
		filmLeft = Polaroid.STARTING_FILM
		nextShotAt = 0
		table.clear(polaroidPhotos)
		photoSeq = 0
		trestleBadgeChecked = false
		table.clear(anomalyTypesSeen)
		psychLog = PsychLog.newRide()
		gazeTarget = nil
		gazeSince = 0
		stareAnomalyCharged = false
		stareParentCharged = false
		falseStopReacted = false
		falseStopOpen = false
		stretchMovedM = 0
		lastRootPos = nil
		stretch = nil
		odo = 0
		lastOpenAir = -1
		publishOpenAir(0)
		setDoorTarget(1)
		doorOpen = 1
		clearCatalog()
		clearTells()
		clearExtra()
		clearMaskUi()
		clearTrialUi()
		ride:SetAttribute("Suspicion", 0)
		ride:SetAttribute("PeakSuspicion", 0)
		publishSanity()
		ride:SetAttribute("SanityRetained", 0)
		ride:SetAttribute("Interventions", 0)
		ride:SetAttribute("Intervening", false)
		ride:SetAttribute("RestraintActive", false)
		ride:SetAttribute("RestraintProgress", 0)
		ride:SetAttribute("RestraintOK", false)
		ride:SetAttribute("ExitActive", false)
		ride:SetAttribute("ExitUntil", 0)
		ride:SetAttribute("HasRecorder", false)
		ride:SetAttribute("SegStop", 0)
		ride:SetAttribute("EvpRaised", false)
		ride:SetAttribute("EvpKhz", 120)
		ride:SetAttribute("EvpMeter", 0)
		ride:SetAttribute("EvpLocked", "")
		ride:SetAttribute("EvpStatus", "")
		ride:SetAttribute("EvpRecordT", 0)
		ride:SetAttribute("EvpTapes", "[]")
		ride:SetAttribute("EvpSaved", "")
		ride:SetAttribute("EvpPlayId", "")
		ride:SetAttribute("CameraRaised", false)
		ride:SetAttribute("AlbumOpen", false)
		ride:SetAttribute("FilmLeft", Polaroid.STARTING_FILM)
		ride:SetAttribute("PolaroidAlbum", "[]")
		ride:SetAttribute("Band", "calm")
		ride:SetAttribute("FalseStopBonus", 0)
		ride:SetAttribute("BoardStop", "")
		ride:SetAttribute("BoardMinutes", 0)
		ride:SetAttribute("Held", false)
		ride:SetAttribute("ChoiceActive", false)
		ride:SetAttribute("MaskActive", false)
		ride:SetAttribute("TrialActive", false)
		ride:SetAttribute("PaText", "")
		ride:SetAttribute("Subtitle", "")
		ride:SetAttribute("Hint", "")
		ride:SetAttribute("Feedback", "")
		ride:SetAttribute("FeedbackKind", "")
		ride:SetAttribute("NightmareOn", nightmareOn)
		ride:SetAttribute("PracticeOn", practiceOn)
		ride:SetAttribute(
			"PracticeNote",
			if practiceOn then Lines.META_PRACTICE_NOTE else ""
		)
		publishBand()
		publishEvp()
		publishCamera()
		publishRestraint()
		clearReport()
	end

	local function runIntro()
		ride:SetAttribute("Phase", "intro")
		doorOpen = 1
		setDoorTarget(1)
		local openedAt = os.clock()
		beginDwell(Constants.MIN_DWELL_SECONDS)
		task.delay(Constants.MIN_DWELL_SECONDS, function()
			if ride:GetAttribute("Phase") == "intro" then
				endDwell()
			end
		end)
		task.wait(1.2)
		showPa(Lines.INTRO_PA, 4)
		task.wait(1.3)
		showHint(Lines.HINT, 7)
		task.wait(3.5)
		showSub(Lines.DAD_BOARD, 2.8)
		task.wait(3)
		showPa(Lines.STAND_CLEAR, 3)
		task.wait(1.4)
		resolveDeparture(os.clock() - openedAt)
		setDoorTarget(0)
		task.wait(1.2)
	end

	local function runPracticeBoard()
		ride:SetAttribute("Phase", "intro")
		doorOpen = 1
		setDoorTarget(1)
		local originStop = if startChapter == 3 then 10 elseif startChapter == 2 then 5 else 1
		ride:SetAttribute("NextStop", Route.stopName(originStop + 1))
		ride:SetAttribute("ChapterLine", Route.chapterLine(originStop))
		Scenery.setName(leaving, Route.stopName(originStop))
		showPa(Lines.INTRO_PA, 2.5)
		showSub(Lines.META_PRACTICE_NOTE, 3.0)
		if startChapter >= 2 then
			giveRecorder("practice")
		end
		task.wait(2.2)
		showPa(Lines.STAND_CLEAR, 2)
		task.wait(1.2)
		setDoorTarget(0)
		task.wait(1.0)
	end

	task.spawn(function()
		while ride.Parent ~= nil do
			pendingStart = nil
			pendingAgain = false
			clearReport()
			ride:SetAttribute("NightmareOn", false)
			ride:SetAttribute("PracticeOn", false)
			ride:SetAttribute("PracticeNote", "")
			ride:SetAttribute("Phase", "menu")
			ride:SetAttribute("Hint", Lines.META_HINT)
			refreshMetaPublish()
			while pendingStart == nil and ride.Parent ~= nil do
				task.wait(0.1)
			end
			if ride.Parent == nil or pendingStart == nil then
				break
			end
			local choice = pendingStart
			pendingStart = nil
			nightmareOn = choice.nightmare
			startChapter = choice.chapter
			practiceOn = Practice.isPractice(startChapter)
			resetRunState()
			if practiceOn then
				runPracticeBoard()
			else
				runIntro()
			end
			local from = Practice.startIndex(startChapter)
			for i = from, #Route.SEGMENTS do
				local seg = Route.SEGMENTS[i]
				runSegment(seg)
				arrive(seg)
				if seg.final then
					break
				end
			end
			local deadline = os.clock() + Constants.META_REPORT_IDLE_SECONDS
			while ride.Parent ~= nil and not pendingAgain and os.clock() < deadline do
				task.wait(0.1)
			end
			pendingAgain = false
		end
	end)
end

return Ride
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Scenery</string>
          <string name="Source"><![CDATA[--!strict
-- The tunnel and the two platforms. The car stays in place (players are in
-- it). Scenery streams toward +X as the odometer rises, which is the web
-- game's FORWARD_X = -1: something still ahead sits at negative X.
--
-- Tunnel lamps are Neon parts with no PointLight. They cannot light the
-- car, so a lamp passing a window does not flicker the interior. The only
-- lights that fill the car are the ceiling lamps in CarBuilder.
--
-- Near 21 St the Newtown Creek trestle replaces the tunnel loop: steel
-- bents, rain strips, dusk fog, open-air platforms (setOpenAir).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)

local Scenery = {}

export type Station = {
	model: Model,
	base: number,
	labels: { TextLabel },
	wall: BasePart?,
	trim: BasePart?,
}

type Piece = {
	part: BasePart,
	base: number,
	y: number,
	z: number,
	period: number,
	rotation: CFrame,
	tunnel: boolean?,
}

local pieces: { Piece } = {}
local stations: { Station } = {}
local trestleSteel: { Piece } = {}
local trestleFolder: Folder? = nil
local rainParts: { BasePart } = {}
local openAirLevel = 0

local WALL = Color3.fromRGB(24, 26, 24)
local PIER = Color3.fromRGB(36, 39, 36)
local LAMP = Color3.fromRGB(255, 216, 150)
local PLATFORM = Color3.fromRGB(141, 138, 130)
local YELLOW = Color3.fromRGB(227, 195, 65)
local COLUMN = Color3.fromRGB(45, 72, 56)
local TRIM = Color3.fromRGB(63, 122, 82)
local BED = Color3.fromRGB(18, 18, 16)
local STEEL = Color3.fromRGB(42, 46, 51)
local RUST = Color3.fromRGB(58, 42, 36)
local WATER = Color3.fromRGB(7, 9, 18)
local SKY = Color3.fromRGB(12, 16, 34)
local HAZE = Color3.fromRGB(255, 153, 68)

local LOOP = 84
local BENT_SPACING = 9
local BENT_WRAP = 90

local function metres(x: number, y: number, z: number): Vector3
	return Vector3.new(x, y, z) * Constants.STUDS_PER_METER
end

local function loopX(base: number, odo: number, period: number): number
	local rel = (base - odo) % period
	if rel < 0 then
		rel += period
	end
	if rel > period / 2 then
		rel -= period
	end
	return -rel
end

local function trackPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Parent = parent
	return part
end

local function addLoop(
	parent: Instance,
	name: string,
	count: number,
	spacing: number,
	length: number,
	y: number,
	z: number,
	height: number,
	depth: number,
	color: Color3,
	material: Enum.Material?
)
	local period = count * spacing
	for i = 0, count - 1 do
		local part = trackPart(parent, name, metres(length, height, depth), CFrame.new(metres(0, y, z)), color, material)
		table.insert(pieces, {
			part = part,
			base = i * spacing,
			y = part.Position.Y,
			z = part.Position.Z,
			period = period,
			rotation = CFrame.identity,
			tunnel = true,
		})
	end
end

local function addSign(model: Model, labels: { TextLabel }, x: number)
	local part = trackPart(model, "Sign", metres(3.6, 0.42, 0.08), CFrame.new(metres(x, 1.72, -2.22)), Color3.fromRGB(8, 8, 8))
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Name"
		gui.Face = face
		gui.LightInfluence = 0
		gui.MaxDistance = 140
		gui.CanvasSize = Vector2.new(480, 72)
		gui.Parent = part
		local label = Instance.new("TextLabel")
		label.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
		label.BorderSizePixel = 0
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Constants.COLOR.cream
		label.TextScaled = true
		label.Text = ""
		label.Parent = gui
		table.insert(labels, label)
	end
end

local function buildStation(): Station
	local model = Instance.new("Model")
	model.Name = "Station"
	local labels: { TextLabel } = {}

	local wall = trackPart(model, "Wall", metres(44, 3.2, 0.16), CFrame.new(metres(0, 1.35, -2.55)), Color3.fromRGB(42, 48, 44))
	local trim = trackPart(model, "Trim", metres(44, 0.16, 0.06), CFrame.new(metres(0, 2.35, -2.46)), TRIM)
	trackPart(model, "Floor", metres(44, 0.16, 0.9), CFrame.new(metres(0, -0.08, -2.05)), PLATFORM, Enum.Material.Concrete)
	trackPart(model, "Edge", metres(44, 0.04, 0.14), CFrame.new(metres(0, 0.02, -1.68)), YELLOW)
	for x = -20, 20, 5 do
		trackPart(model, "Column", metres(0.18, 3.1, 0.18), CFrame.new(metres(x, 1.5, -2.15)), COLUMN)
	end
	for x = -15, 15, 10 do
		addSign(model, labels, x)
	end
	-- Neon only. A PointLight here would wash the car when the platform arrives.
	for x = -18, 18, 6 do
		local lamp = trackPart(model, "PlatformLamp", metres(1.4, 0.06, 0.14), CFrame.new(metres(x, 2.85, -2.0)), LAMP)
		lamp.Material = Enum.Material.Neon
	end

	local root = trackPart(model, "Root", Vector3.new(0.2, 0.2, 0.2), CFrame.new(), WALL)
	root.Transparency = 1
	model.PrimaryPart = root
	model.Parent = workspace
	return {
		model = model,
		base = 0,
		labels = labels,
		wall = wall,
		trim = trim,
	}
end

local function buildTrestle()
	local folder = Instance.new("Folder")
	folder.Name = "Trestle"
	folder.Parent = workspace
	trestleFolder = folder

	-- Dusk dome stand-in: large inverted shell (Part), not a skybox art pass.
	local dome = trackPart(folder, "Sky", metres(160, 80, 160), CFrame.new(metres(0, 20, 0)), SKY)
	dome.Transparency = 0.35
	dome.Material = Enum.Material.SmoothPlastic
	dome.Shape = Enum.PartType.Ball
	local haze = trackPart(folder, "Haze", metres(120, 4, 120), CFrame.new(metres(0, -2, 0)), HAZE)
	haze.Transparency = 0.7

	local water = trackPart(folder, "Water", metres(200, 0.2, 200), CFrame.new(metres(0, -12, 0)), WATER)
	water.Material = Enum.Material.Glass
	water.Transparency = 0.15

	-- Simple skyline slabs (far silhouettes).
	for i = 0, 11 do
		local ang = i / 12 * math.pi * 2
		local h = 8 + (i % 5) * 3
		local slab = trackPart(
			folder,
			"Tower",
			metres(4, h, 4),
			CFrame.new(metres(math.sin(ang) * 55, h / 2 - 4, math.cos(ang) * 55)),
			Color3.fromRGB(8, 9, 14)
		)
		slab.Transparency = 0.05
	end

	-- Continuous guard rails.
	for _, z in { -2.45, 2.45 } do
		trackPart(folder, "Guard", metres(80, 0.07, 0.07), CFrame.new(metres(0, 0.85, z)), STEEL, Enum.Material.Metal)
	end

	-- Rain strips just outside the windows (opacity driven by open-air level).
	for _, z in { -1.6, 1.6 } do
		local strip = trackPart(folder, "Rain", metres(40, 0.85, 0.02), CFrame.new(metres(0, 1.325, z)), Color3.fromRGB(180, 190, 210))
		strip.Transparency = 1
		strip.Material = Enum.Material.Glass
		table.insert(rainParts, strip)
	end

	local bentCount = BENT_WRAP / BENT_SPACING
	for i = 0, bentCount - 1 do
		local base = i * BENT_SPACING
		for _, z in { -2.6, 2.6 } do
			local leg = trackPart(folder, "BentLeg", metres(0.35, 12, 0.35), CFrame.new(metres(0, -6.6, z)), STEEL, Enum.Material.Metal)
			table.insert(trestleSteel, {
				part = leg,
				base = base,
				y = leg.Position.Y,
				z = leg.Position.Z,
				period = BENT_WRAP,
				rotation = CFrame.identity,
			})
			local brace = trackPart(folder, "BentBrace", metres(0.12, 7, 0.12), CFrame.new(metres(0, -4.5, z)), RUST, Enum.Material.Metal)
			table.insert(trestleSteel, {
				part = brace,
				base = base,
				y = brace.Position.Y,
				z = brace.Position.Z,
				period = BENT_WRAP,
				rotation = CFrame.Angles(math.rad(if z < 0 then -28 else 28), 0, 0),
			})
			local post = trackPart(folder, "RailPost", metres(0.08, 1.3, 0.08), CFrame.new(metres(0, 0.2, z * 0.94)), STEEL, Enum.Material.Metal)
			table.insert(trestleSteel, {
				part = post,
				base = base,
				y = post.Position.Y,
				z = post.Position.Z,
				period = BENT_WRAP,
				rotation = CFrame.identity,
			})
		end
		local beam = trackPart(folder, "BentBeam", metres(0.4, 0.5, 5.6), CFrame.new(metres(0, -0.75, 0)), STEEL, Enum.Material.Metal)
		table.insert(trestleSteel, {
			part = beam,
			base = base,
			y = beam.Position.Y,
			z = beam.Position.Z,
			period = BENT_WRAP,
			rotation = CFrame.identity,
		})
	end

	folder.Parent = workspace
end

function Scenery.setName(station: Station, name: string)
	for _, label in station.labels do
		label.Text = name
	end
end

function Scenery.build(): (Station, Station)
	local tunnel = Instance.new("Folder")
	tunnel.Name = "Tunnel"
	tunnel.Parent = workspace

	local chunks = 3
	local spacing = LOOP / chunks
	local length = spacing + 1.2
	for _, z in { -2.9, 2.9 } do
		addLoop(tunnel, "Wall", chunks, spacing, length, 1.35, z, 4.4, 0.28, WALL)
	end
	addLoop(tunnel, "Ceiling", chunks, spacing, length, 3.45, 0, 0.18, 6.4, WALL)
	addLoop(tunnel, "Bed", chunks, spacing, length, -0.62, 0, 0.16, 6.4, BED, Enum.Material.Concrete)

	for _, z in { -2.05, 2.15 } do
		addLoop(tunnel, "Rail", chunks, spacing, length, -0.28, z - 0.28, 0.06, 0.06, Constants.COLOR.steel, Enum.Material.Metal)
		addLoop(tunnel, "Rail", chunks, spacing, length, -0.28, z + 0.28, 0.06, 0.06, Constants.COLOR.steel, Enum.Material.Metal)
	end

	local tieCount = LOOP / 2
	for i = 0, tieCount - 1 do
		local base = i * 2
		for _, z in { -2.05, 2.15 } do
			local part = trackPart(tunnel, "Tie", metres(0.28, 0.06, 0.9), CFrame.new(metres(0, -0.36, z)), PIER)
			table.insert(pieces, {
				part = part,
				base = base,
				y = part.Position.Y,
				z = part.Position.Z,
				period = LOOP,
				rotation = CFrame.identity,
				tunnel = true,
			})
		end
	end

	local pierCount = 28
	for i = 0, pierCount - 1 do
		local base = i * (LOOP / pierCount)
		-- Platform side sits behind the station wall so a stop hides the piers.
		for _, z in { -2.78, 2.55 } do
			local part = trackPart(tunnel, "Pier", metres(0.28, 3.3, 0.24), CFrame.new(metres(0, 1.2, z)), PIER, Enum.Material.Concrete)
			table.insert(pieces, {
				part = part,
				base = base,
				y = part.Position.Y,
				z = part.Position.Z,
				period = LOOP,
				rotation = CFrame.identity,
				tunnel = true,
			})
		end
	end

	local lampCount = 12
	local lampSpacing = LOOP / lampCount
	for i = 0, lampCount - 1 do
		local base = i * lampSpacing
		for index, z in { -2.72, 2.42 } do
			local part = trackPart(tunnel, "TunnelLight", metres(0.55, 0.1, 0.16), CFrame.new(metres(0, 2.15, z)), LAMP)
			part.Material = Enum.Material.Neon
			-- Stagger one wall so the two rows don't pass the windows in step.
			local stagger = if index == 2 then lampSpacing / 2 else 0
			table.insert(pieces, {
				part = part,
				base = base + stagger,
				y = part.Position.Y,
				z = part.Position.Z,
				period = LOOP,
				rotation = CFrame.identity,
				tunnel = true,
			})
		end
	end

	buildTrestle()

	local leaving = buildStation()
	leaving.model.Name = "StationLeaving"
	local arriving = buildStation()
	arriving.model.Name = "StationArriving"
	leaving.base = 0
	arriving.base = 4000
	table.insert(stations, leaving)
	table.insert(stations, arriving)
	Scenery.place(0)
	return leaving, arriving
end

-- Web setOpenAir: hide tiled back wall / trim on elevated platforms.
function Scenery.setOpenAir(station: Station, on: boolean)
	local wall = station.wall
	local trim = station.trim
	if wall ~= nil then
		wall.Transparency = if on then 1 else 0
	end
	if trim ~= nil then
		trim.Transparency = if on then 1 else 0
	end
end

function Scenery.setOpenAirLevel(level: number)
	openAirLevel = math.clamp(level, 0, 1)
end

function Scenery.place(odo: number)
	local hideTunnel = openAirLevel > 0.35
	local showTrestle = openAirLevel > 0.05
	for _, piece in pieces do
		local x = Constants.meters(loopX(piece.base, odo, piece.period))
		piece.part.CFrame = CFrame.new(x, piece.y, piece.z) * piece.rotation
		if piece.tunnel == true then
			piece.part.Transparency = if hideTunnel then 1 else 0
			if piece.part.Material == Enum.Material.Neon then
				piece.part.Color = if hideTunnel then Color3.fromRGB(12, 10, 8) else LAMP
			end
		end
	end
	for _, station in stations do
		local x = Constants.meters(-(station.base - odo))
		station.model:PivotTo(CFrame.new(x, 0, 0))
	end

	local folder = trestleFolder
	if folder ~= nil then
		for _, child in folder:GetChildren() do
			if child:IsA("BasePart") and child.Name ~= "Rain" and not string.find(child.Name, "Bent", 1, true) and child.Name ~= "RailPost" then
				if not showTrestle then
					child.Transparency = 1
				elseif child.Name == "Sky" then
					child.Transparency = 0.35
				elseif child.Name == "Haze" then
					child.Transparency = 0.7
				elseif child.Name == "Water" then
					child.Transparency = 0.15
				else
					child.Transparency = 0.05
				end
			end
		end
	end
	for _, piece in trestleSteel do
		local x = Constants.meters(loopX(piece.base, odo, piece.period))
		piece.part.CFrame = CFrame.new(x, piece.y, piece.z) * piece.rotation
		piece.part.Transparency = if showTrestle then 0 else 1
	end
	for _, rain in rainParts do
		-- ~0.55 opacity * outside level (web rainMats).
		rain.Transparency = if showTrestle then 1 - 0.55 * openAirLevel else 1
	end
end

return Scenery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">TrialSpace</string>
          <string name="Source"><![CDATA[--!strict
-- Parts-built False Stop Trial room (trialBuilder.ts shaped for Rojo).
-- Three openings with lying signs and lights that flick on the chime.

local Constants = require(game:GetService("ReplicatedStorage").Shared.Constants)

local TrialSpace = {}

export type Opening = {
	index: number,
	lamp: BasePart,
	light: PointLight,
	signLabel: TextLabel,
	interior: BasePart,
	leaves: { { part: BasePart, x0: number, side: number } },
	flickUntil: number,
	openAmt: number,
	target: number,
}

export type Built = {
	model: Model,
	spawn: CFrame,
	openings: { Opening },
	tileParts: { BasePart },
}

local ORIGIN = CFrame.new(0, 480, 0)
local S = Constants.STUDS_PER_METER

local function part(
	name: string,
	parent: Instance,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	collide: boolean?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = if collide == nil then true else collide
	p.CanQuery = false
	p.CanTouch = false
	p.Parent = parent
	return p
end

function TrialSpace.build(): Built
	local model = Instance.new("Model")
	model.Name = "TrialSpace"
	model.Parent = workspace

	local tile = Color3.fromRGB(210, 205, 190)
	local floorC = Color3.fromRGB(106, 104, 96)
	local ceilC = Color3.fromRGB(58, 60, 56)
	local yellow = Color3.fromRGB(227, 195, 65)
	local dark = Color3.fromRGB(5, 5, 5)

	part("Floor", model, Vector3.new(12 * S, 0.3, 14 * S), ORIGIN * CFrame.new(0, -0.15, -3 * S), floorC)
	part("Ceil", model, Vector3.new(12 * S, 0.3, 14 * S), ORIGIN * CFrame.new(0, 3.6 * S, -3 * S), ceilC)
	part("LeftWall", model, Vector3.new(0.3, 3.7 * S, 14 * S), ORIGIN * CFrame.new(-6 * S, 1.8 * S, -3 * S), tile)
	part("RightWall", model, Vector3.new(0.3, 3.7 * S, 14 * S), ORIGIN * CFrame.new(6 * S, 1.8 * S, -3 * S), tile)
	part("BackWall", model, Vector3.new(12 * S, 3.7 * S, 0.3), ORIGIN * CFrame.new(0, 1.8 * S, 4 * S), tile)

	for _, span in { { -6, -3.8 }, { -2.2, -0.8 }, { 0.8, 2.2 }, { 3.8, 6 } } do
		local a, b = span[1], span[2]
		part(
			"Divider",
			model,
			Vector3.new((b - a) * S, 3.7 * S, 0.6),
			ORIGIN * CFrame.new(((a + b) / 2) * S, 1.8 * S, -7 * S),
			tile
		)
	end
	part("Safety", model, Vector3.new(12 * S, 0.2, 0.6 * S), ORIGIN * CFrame.new(0, 0.1, -6.3 * S), yellow)

	local openings: { Opening } = {}
	local tileParts: { BasePart } = {}

	for i, x in { -3, 0, 3 } do
		local index = i - 1
		part("Arch_" .. index, model, Vector3.new(1.6 * S, 1.3 * S, 0.6), ORIGIN * CFrame.new(x * S, 3.0 * S, -7 * S), tile)
		part("Void_" .. index, model, Vector3.new(1.6 * S, 2.4 * S, 0.8 * S), ORIGIN * CFrame.new(x * S, 1.2 * S, -7.5 * S), dark, false)

		local lamp = part(
			"Lamp_" .. index,
			model,
			Vector3.new(1.2 * S, 0.12, 0.12),
			ORIGIN * CFrame.new(x * S, 3.32 * S, -6.85 * S),
			Color3.fromRGB(255, 242, 214),
			false
		)
		lamp.Material = Enum.Material.Neon
		local light = Instance.new("PointLight")
		light.Brightness = 1.2
		light.Range = 5.5 * S
		light.Color = Color3.fromRGB(255, 240, 208)
		light.Parent = lamp

		local signBack = part(
			"SignBack_" .. index,
			model,
			Vector3.new(2.3 * S, 0.58 * S, 0.08),
			ORIGIN * CFrame.new(x * S, 2.92 * S, -6.8 * S),
			Color3.fromRGB(17, 19, 17),
			false
		)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 50
		gui.Parent = signBack
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextScaled = true
		label.Text = ""
		label.Parent = gui

		local interior = part(
			"Interior_" .. index,
			model,
			Vector3.new(1.6 * S, 2.4 * S, 0.6 * S),
			ORIGIN * CFrame.new(x * S, 1.2 * S, -7.6 * S),
			Color3.fromRGB(216, 160, 96),
			false
		)
		interior.Transparency = 1

		local leaves = {}
		for _, side in { -1, 1 } do
			local leaf = part(
				"Leaf_" .. index .. "_" .. side,
				model,
				Vector3.new(0.8 * S, 2.4 * S, 0.08),
				ORIGIN * CFrame.new((x + side * 0.4) * S, 1.2 * S, -6.95 * S),
				Color3.fromRGB(154, 160, 156),
				false
			)
			leaf.Transparency = 1
			table.insert(leaves, { part = leaf, x0 = (x + side * 0.4) * S, side = side })
		end

		table.insert(openings, {
			index = index,
			lamp = lamp,
			light = light,
			signLabel = label,
			interior = interior,
			leaves = leaves,
			flickUntil = -1,
			openAmt = 0,
			target = 0,
		})
	end

	local spawn = ORIGIN * CFrame.new(0, 1.2 * S, 1.5 * S) * CFrame.Angles(0, math.pi, 0)
	model:SetAttribute("Active", false)
	TrialSpace.setVisible(model, false)

	return {
		model = model,
		spawn = spawn,
		openings = openings,
		tileParts = tileParts,
	}
end

function TrialSpace.setVisible(model: Model, visible: boolean)
	model:SetAttribute("Active", visible)
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") then
			local isDoorish = desc.Name:find("Interior_", 1, true) ~= nil or desc.Name:find("Leaf_", 1, true) ~= nil
			local isDecor = desc.Name:find("Lamp_", 1, true) ~= nil
				or desc.Name:find("SignBack_", 1, true) ~= nil
				or desc.Name:find("Void_", 1, true) ~= nil
			if visible then
				if not isDoorish then
					desc.Transparency = 0
				end
				desc.CanCollide = not isDecor and not isDoorish
			else
				desc.Transparency = 1
				desc.CanCollide = false
			end
		elseif desc:IsA("PointLight") or desc:IsA("SurfaceGui") then
			desc.Enabled = visible
		end
	end
end

function TrialSpace.applyRound(built: Built, signs: { string }, boardDoors: boolean)
	for _, opening in built.openings do
		local text = signs[opening.index + 1] or ""
		opening.signLabel.Text = text
		opening.openAmt = 0
		opening.target = 0
		opening.flickUntil = -1
		local showDoor = boardDoors and opening.index ~= 1
		opening.interior.Transparency = if showDoor then 0 else 1
		for _, leaf in opening.leaves do
			leaf.part.Transparency = if showDoor then 0 else 1
			leaf.part.CFrame = ORIGIN * CFrame.new(leaf.x0, 1.2 * S, -6.95 * S)
		end
		opening.lamp.Color = Color3.fromRGB(255, 242, 214)
		opening.light.Brightness = 1.2
		opening.light.Enabled = true
	end
end

function TrialSpace.flick(opening: Opening, untilClock: number)
	opening.flickUntil = untilClock
end

function TrialSpace.setDoorTarget(opening: Opening, target: number)
	opening.target = target
end

function TrialSpace.step(built: Built, dt: number, now: number)
	for _, opening in built.openings do
		local off = now < opening.flickUntil
		opening.lamp.Color = if off then Color3.fromRGB(17, 17, 17) else Color3.fromRGB(255, 242, 214)
		opening.light.Brightness = if off then 0 else 1.2
		opening.openAmt += (opening.target - opening.openAmt) * (1 - math.exp(-9 * dt))
		for _, leaf in opening.leaves do
			if leaf.part.Transparency < 1 then
				leaf.part.CFrame = ORIGIN
					* CFrame.new(leaf.x0 + leaf.side * 0.75 * S * opening.openAmt, 1.2 * S, -6.95 * S)
			end
		end
	end
end

function TrialSpace.teleportPlayers(cf: CFrame)
	local Players = game:GetService("Players")
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root ~= nil and root:IsA("BasePart") then
			root.CFrame = cf
		end
	end
end

return TrialSpace
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">WorldLight</string>
          <string name="Source"><![CDATA[--!strict
-- Night lighting matched to the web game's scene setup (App.tsx and
-- subwayCarBuilder.setupLighting / gameState.applyLighting).
--
-- Web: background 0x030403, fog 0x040504 from 9 m to 30 m, ACES exposure 1.05,
-- ambient white at 0.15, hemisphere 0xfff3dc / 0x5a5850 at 0.65 then scaled
-- in applyLighting, point lights 0xfff0d4 at intensity 0.55. Roblox's default
-- Future exposure plus SmoothPlastic turns that same paint white, which is
-- what the Studio playtest showed. Exposure is pulled down and the fill is
-- kept low so the ceiling pools stay local.
--
-- This only touches the Lighting service. It never writes the car lamps.
-- The flicker tick and the slow dim still own those. A Held At Signal
-- pause does not come through here: one strip or a slow dim stays on the
-- car lamps, and this service never blacks the car out.
--
-- Lighting.Technology is a place property only (default.project.json Future).
-- Runtime writes need RobloxScript and abort server init before Ride.start.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Trestle = require(ReplicatedStorage.Shared.Trestle)

local WorldLight = {}

local applying = false
local openAir = 0

local function killDefaultSky()
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end
end

local function atmosphere(): Atmosphere
	local existing = Lighting:FindFirstChild("TunnelAir")
	if existing ~= nil and existing:IsA("Atmosphere") then
		return existing
	end
	if existing ~= nil then
		existing:Destroy()
	end
	local air = Instance.new("Atmosphere")
	air.Name = "TunnelAir"
	air.Parent = Lighting
	return air
end

local function grade(): ColorCorrectionEffect
	local existing = Lighting:FindFirstChild("CarGrade")
	if existing ~= nil and existing:IsA("ColorCorrectionEffect") then
		return existing
	end
	if existing ~= nil then
		existing:Destroy()
	end
	local effect = Instance.new("ColorCorrectionEffect")
	effect.Name = "CarGrade"
	effect.Parent = Lighting
	return effect
end

local function bloom(): BloomEffect
	local existing = Lighting:FindFirstChild("LampBloom")
	if existing ~= nil and existing:IsA("BloomEffect") then
		return existing
	end
	if existing ~= nil then
		existing:Destroy()
	end
	local effect = Instance.new("BloomEffect")
	effect.Name = "LampBloom"
	effect.Parent = Lighting
	return effect
end

function WorldLight.apply()
	if applying then
		return
	end
	applying = true

	killDefaultSky()

	-- Do not write Lighting.Technology (place property / RobloxScript only).
	-- Brightness 0 and midnight kill the sun. Scales at 0 kill the skybox fill.
	Lighting.Brightness = 0
	Lighting.ClockTime = 0
	Lighting.GeographicLatitude = 0
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.ExposureCompensation = -0.85
	-- Web ambient is 0.15 white, which is a dim fill, not a white wash.
	Lighting.Ambient = Color3.fromRGB(12, 11, 10)
	Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
	-- App.tsx: fog 0x040504, near 9 m, far 30 m. Trestle outside lerps to sodium dusk.
	local k = openAir
	local tunnelFog = Color3.fromRGB(Trestle.TUNNEL_FOG_RGB[1], Trestle.TUNNEL_FOG_RGB[2], Trestle.TUNNEL_FOG_RGB[3])
	local trestleFog = Color3.fromRGB(Trestle.FOG_RGB[1], Trestle.FOG_RGB[2], Trestle.FOG_RGB[3])
	Lighting.FogColor = tunnelFog:Lerp(trestleFog, k)
	Lighting.FogStart = Trestle.TUNNEL_FOG_START + (Trestle.OPEN_FOG_START - Trestle.TUNNEL_FOG_START) * k
	Lighting.FogEnd = Trestle.TUNNEL_FOG_END + (Trestle.OPEN_FOG_END - Trestle.TUNNEL_FOG_END) * k

	local air = atmosphere()
	air.Density = 0.45 - 0.12 * k
	air.Offset = 0
	air.Color = tunnelFog:Lerp(trestleFog, k)
	air.Decay = Color3.fromRGB(3, 4, 3):Lerp(Color3.fromRGB(40, 24, 16), k)
	air.Glare = 0.05 * k
	air.Haze = 1.1 + 0.4 * k

	local correction = grade()
	correction.Brightness = -0.05
	correction.Contrast = 0.16
	correction.Saturation = -0.14
	correction.TintColor = Color3.fromRGB(206, 222, 198)

	-- Only the hottest pixels (the tubes) bloom. Walls stay matte.
	local glow = bloom()
	glow.Enabled = true
	glow.Intensity = 0.12
	glow.Size = 14
	glow.Threshold = 1.45

	applying = false
end

-- 0 = tunnel murk, 1 = Newtown Creek open air (web trestleOutside).
function WorldLight.setOpenAir(level: number)
	local nextLevel = math.clamp(level, 0, 1)
	if math.abs(nextLevel - openAir) < 0.02 then
		return
	end
	openAir = nextLevel
	local ok, err = pcall(WorldLight.apply)
	if not ok then
		warn("[WorldLight] setOpenAir apply failed: ", err)
	end
end

function WorldLight.bind()
	-- Never let a restricted Lighting write abort server init before Ride.
	local ok, err = pcall(WorldLight.apply)
	if not ok then
		warn("[WorldLight] bind apply failed: ", err)
	end
	Lighting.Changed:Connect(function(property: string)
		if
			property == "Brightness"
			or property == "Ambient"
			or property == "OutdoorAmbient"
			or property == "ClockTime"
			or property == "ExposureCompensation"
			or property == "EnvironmentDiffuseScale"
		then
			local reOk, reErr = pcall(WorldLight.apply)
			if not reOk then
				warn("[WorldLight] re-apply failed: ", reErr)
			end
		end
	end)
	Lighting.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Sky") or child:IsA("SunRaysEffect") then
			child:Destroy()
		end
	end)
end

return WorldLight
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
