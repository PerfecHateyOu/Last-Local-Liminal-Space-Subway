	local cross = Instance.new("Frame")
	cross.Name = "Crosshair"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(5, 5)
	cross.BackgroundColor3 = Constants.COLOR.cream
	cross.BackgroundTransparency = 0.15
	cross.BorderSizePixel = 0
	cross.Active = false
	cross.Parent = gui
	corner(cross, 3)

	local function textOf(name: string): string
		local value = ride:GetAttribute(name)
		if typeof(value) == "string" then
			return value
		end
		return ""
	end

	local function refresh()
		local stopName = textOf("NextStop")
		nextName.Text = stopName
		nextLabel.Visible = stopName ~= ""
		local chapterLine = textOf("ChapterLine")
		local character = Players.LocalPlayer.Character
		local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
		if root ~= nil and root:IsA("BasePart") then
			local xMetres = root.Position.X / Constants.STUDS_PER_METER
			chapter.Text = Route.withCarLabel(chapterLine, Route.carLabel(xMetres))
		else
			chapter.Text = chapterLine
		end

		local susAttr = ride:GetAttribute("Suspicion")
		local sus = if typeof(susAttr) == "number" then susAttr else 0
		local band = textOf("Band")
		if band == "" then
			band = "calm"
		end
		susValue.Text = Lines.suspicionMeter(sus, band)
		local ratio = math.clamp(sus / 100, 0, 1)
		susBarFill.Size = UDim2.fromScale(ratio, 1)
		if band == "hunted" then
			susValue.TextColor3 = Color3.fromRGB(220, 96, 72)
			susBarFill.BackgroundColor3 = Color3.fromRGB(220, 96, 72)
		elseif band == "watched" or band == "uneasy" then
			susValue.TextColor3 = Constants.COLOR.warn
			susBarFill.BackgroundColor3 = Constants.COLOR.warn
		else
			susValue.TextColor3 = Constants.COLOR.cream
			susBarFill.BackgroundColor3 = Constants.COLOR.gLine
		end

		local sanAttr = ride:GetAttribute("Sanity")
		local san = if typeof(sanAttr) == "number" then sanAttr else 100
		local tier = textOf("SanityTier")
		if tier == "" then
			tier = "high"
		end
		sanValue.Text = Lines.sanityMeter(san, tier)
		local sanRatio = math.clamp(san / 100, 0, 1)
		sanBarFill.Size = UDim2.fromScale(sanRatio, 1)
		if tier == "critical" then
			sanValue.TextColor3 = Color3.fromRGB(220, 96, 72)
			sanBarFill.BackgroundColor3 = Color3.fromRGB(220, 96, 72)
		elseif tier == "low" then
			sanValue.TextColor3 = Constants.COLOR.warn
			sanBarFill.BackgroundColor3 = Constants.COLOR.warn
		elseif tier == "medium" then
			sanValue.TextColor3 = Color3.fromRGB(210, 190, 140)
			sanBarFill.BackgroundColor3 = Color3.fromRGB(180, 160, 90)
		else
			sanValue.TextColor3 = Constants.COLOR.cream
			sanBarFill.BackgroundColor3 = Constants.COLOR.gLine
		end

		local boardStop = textOf("BoardStop")
		local minutesValue = ride:GetAttribute("BoardMinutes")
		local minutes = if typeof(minutesValue) == "number" then minutesValue else nil
		boardCard.Visible = boardStop ~= "" and minutes ~= nil
		boardName.Text = boardStop
		boardMinutes.Text = if minutes ~= nil then Lines.minutesLabel(minutes) else ""

		local paText = textOf("PaText")
		pa.Text = paText
		pa.Visible = paText ~= ""

		local hintText = textOf("Hint")
		hint.Text = hintText
		hint.Visible = hintText ~= ""

		local subText = textOf("Subtitle")
		subtitle.Text = subText
		subtitle.Visible = subText ~= ""

		local feedbackText = textOf("Feedback")
		feedback.Text = feedbackText
		feedback.Visible = feedbackText ~= ""
		local kind = textOf("FeedbackKind")
		if kind == "caught" then
			feedback.TextColor3 = Constants.COLOR.gLine
		elseif kind == "false" or kind == "missed" then
			feedback.TextColor3 = Constants.COLOR.warn
		else
			feedback.TextColor3 = Constants.COLOR.cream
		end

		local reportReady = ride:GetAttribute("ReportReady") == true
		if reportFrame ~= nil then
			reportFrame.Visible = reportReady
		end
		if reportReady then
			if reportBadge ~= nil then
				reportBadge.Text = textOf("EndingBadge")
			end
			if reportTitle ~= nil then
				reportTitle.Text = textOf("EndingTitle")
			end
			if reportNarrative ~= nil then
				reportNarrative.Text = textOf("EndingNarrative")
			end
			if reportStats ~= nil then
				reportStats.Text = textOf("ReportStats")
			end
			if reportPsych ~= nil then
				reportPsych.Text = textOf("ReportPsych")
			end
		end
	end

	RunService.Heartbeat:Connect(function()
		local chapterLine = textOf("ChapterLine")
		local character = Players.LocalPlayer.Character
		local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
		if root ~= nil and root:IsA("BasePart") then
			local xMetres = root.Position.X / Constants.STUDS_PER_METER
			chapter.Text = Route.withCarLabel(chapterLine, Route.carLabel(xMetres))
		end

		local deadline = ride:GetAttribute("DwellUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			dwellCard.Visible = false
			return
		end
		local remain = deadline - workspace:GetServerTimeNow()
		if remain <= 0 then
			dwellCard.Visible = false
			return
		end
		dwellCard.Visible = true
		dwellCount.Text = Lines.dwellCountdown(remain)
	end)

	ride.AttributeChanged:Connect(function(name: string)
		if name == "Feedback" and textOf("Feedback") ~= "" then
			buttonScale.Scale = 1.08
			task.delay(0.18, function()
				buttonScale.Scale = 1
			end)
		end
		refresh()
	end)
	refresh()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Mask</string>
            <string name="Source"><![CDATA[--!strict
-- Parent mask check UI. Server owns validation; this only fires Remotes.Mask
-- while MaskActive is true. Timeout on the server counts as hesitation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Mask = {}

function Mask.start(
	buttonA: TextButton,
	buttonB: TextButton,
	buttonC: TextButton,
	setVisible: (boolean) -> (),
	setCountdown: (string) -> (),
	setLabels: (string, string, string) -> ()
)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local maskRemote = remotes:WaitForChild("Mask") :: RemoteEvent
	local sent = false

	local function active(): boolean
		return ride:GetAttribute("MaskActive") == true
	end

	local function pick(slot: string)
		if not active() or sent then
			return
		end
		sent = true
		maskRemote:FireServer(slot)
	end

	buttonA.MouseButton1Click:Connect(function()
		pick("A")
	end)
	buttonB.MouseButton1Click:Connect(function()
		pick("B")
	end)
	buttonC.MouseButton1Click:Connect(function()
		pick("C")
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.KeypadOne then
			pick("A")
		elseif input.KeyCode == Enum.KeyCode.Two or input.KeyCode == Enum.KeyCode.KeypadTwo then
			pick("B")
		elseif input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.KeypadThree then
			pick("C")
		end
	end)

	local function textOf(name: string): string
		local value = ride:GetAttribute(name)
		if typeof(value) == "string" then
			return value
		end
		return ""
	end

	local function refresh()
		local on = active()
		setVisible(on)
		if not on then
			sent = false
			setCountdown("")
			setLabels("", "", "")
			return
		end
		setLabels(textOf("MaskA"), textOf("MaskB"), textOf("MaskC"))
		local deadline = ride:GetAttribute("MaskUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			setCountdown("")
			return
		end
		local remain = math.ceil(deadline - workspace:GetServerTimeNow())
		if remain < 1 then
			remain = 1
		end
		setCountdown(tostring(remain) .. "s · hesitate raises suspicion")
	end

	ride.AttributeChanged:Connect(function(name: string)
		if
			name == "MaskActive"
			or name == "MaskUntil"
			or name == "MaskA"
			or name == "MaskB"
			or name == "MaskC"
		then
			refresh()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if active() then
			refresh()
		end
	end)
	refresh()
end

return Mask
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Meta</string>
            <string name="Source"><![CDATA[--!strict
-- Start menu: nightmare toggle, chapter/practice, archive, play again.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Lines = require(ReplicatedStorage.Shared.Lines)

local Meta = {}

function Meta.start(
	setMenuVisible: (boolean) -> (),
	setNightmareLabel: (string, boolean) -> (),
	setArchiveText: (string) -> (),
	setArchiveVisible: (boolean) -> (),
	againButton: TextButton
)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local startRemote = remotes:WaitForChild("MetaStart") :: RemoteEvent
	local againRemote = remotes:WaitForChild("MetaAgain") :: RemoteEvent

	local nightmare = false
	local archiveOpen = false
	local sent = false
	local wasMenu = false

	local function menuOn(): boolean
		return ride:GetAttribute("Phase") == "menu"
	end

	local function reportOn(): boolean
		return ride:GetAttribute("ReportReady") == true
	end

	local function unlocked(): boolean
		return ride:GetAttribute("NightmareUnlocked") == true
	end

	local function refresh()
		local on = menuOn()
		setMenuVisible(on)
		-- Only clear the start latch when re-entering the menu, not on every
		-- attribute tick while still Phase == menu (that re-armed duplicate starts).
		if on and not wasMenu then
			sent = false
		end
		wasMenu = on
		if unlocked() then
			setNightmareLabel(
				"[N]  " .. Lines.META_NIGHTMARE .. if nightmare then " · ON" else " · off",
				true
			)
		else
			setNightmareLabel("[N]  " .. Lines.META_NIGHTMARE_LOCKED, false)
			nightmare = false
		end
		local arch = ride:GetAttribute("MetaArchive")
		if typeof(arch) == "string" then
			setArchiveText(arch)
		else
			setArchiveText("")
		end
		setArchiveVisible(on and archiveOpen)
		againButton.Visible = reportOn()
	end

	local function fireStart(chapter: number)
		if not menuOn() or sent then
			return
		end
		if chapter > 1 and not unlocked() then
			return
		end
		sent = true
		startRemote:FireServer(unlocked() and nightmare, chapter)
	end

	againButton.MouseButton1Click:Connect(function()
		if reportOn() then
			againRemote:FireServer()
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if menuOn() then
			if input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.KeypadOne then
				fireStart(1)
			elseif input.KeyCode == Enum.KeyCode.Two or input.KeyCode == Enum.KeyCode.KeypadTwo then
				fireStart(2)
			elseif input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.KeypadThree then
				fireStart(3)
			elseif input.KeyCode == Enum.KeyCode.N then
				if unlocked() then
					nightmare = not nightmare
					refresh()
				end
			elseif input.KeyCode == Enum.KeyCode.Tab then
				archiveOpen = not archiveOpen
				refresh()
			end
		elseif
			reportOn()
			and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter)
		then
			againRemote:FireServer()
		end
	end)

	local gui = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("LastLocalHud")
	local menu = gui:WaitForChild("MetaMenu")
	menu:WaitForChild("StartCh1").MouseButton1Click:Connect(function()
		fireStart(1)
	end)
	menu:WaitForChild("StartCh2").MouseButton1Click:Connect(function()
		fireStart(2)
	end)
	menu:WaitForChild("StartCh3").MouseButton1Click:Connect(function()
		fireStart(3)
	end)
	menu:WaitForChild("Nightmare").MouseButton1Click:Connect(function()
		if unlocked() then
			nightmare = not nightmare
			refresh()
		end
	end)
	menu:WaitForChild("Archive").MouseButton1Click:Connect(function()
		archiveOpen = not archiveOpen
		refresh()
	end)

	ride.AttributeChanged:Connect(function(name: string)
		if
			name == "Phase"
			or name == "NightmareUnlocked"
			or name == "MetaArchive"
			or name == "ReportReady"
		then
			refresh()
		end
	end)
	refresh()
end

return Meta
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Polaroid</string>
            <string name="Source"><![CDATA[--!strict
-- Polaroid viewfinder, shutter, and minimal album strip.
-- Server owns film, framed catches, and flash suspicion; this draws UI and fires remotes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local Constants = require(ReplicatedStorage.Shared.Constants)

local Polaroid = {}

local function corner(parent: Instance, radius: number)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius)
	ui.Parent = parent
end

local function parseAlbum(raw: string): { { id: string, stop: string } }
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or typeof(data) ~= "table" then
		return {}
	end
	local out = {}
	for _, item in data do
		if typeof(item) == "table" and typeof(item.id) == "string" then
			table.insert(out, {
				id = item.id,
				stop = if typeof(item.stop) == "string" then item.stop else "",
			})
		end
	end
	return out
end

function Polaroid.start(cameraButton: TextButton, albumButton: TextButton)
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local toggleRemote = remotes:WaitForChild("PolaroidToggle") :: RemoteEvent
	local snapRemote = remotes:WaitForChild("PolaroidSnap") :: RemoteEvent
	local albumRemote = remotes:WaitForChild("PolaroidAlbum") :: RemoteEvent

	local gui = playerGui:WaitForChild("LastLocalHud") :: ScreenGui

	local viewfinder = Instance.new("Frame")
	viewfinder.Name = "PolaroidViewfinder"
	viewfinder.Size = UDim2.fromScale(1, 1)
	viewfinder.BackgroundTransparency = 1
	viewfinder.BorderSizePixel = 0
	viewfinder.Visible = false
	viewfinder.Parent = gui

	local vignette = Instance.new("Frame")
	vignette.Name = "Vignette"
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.BackgroundColor3 = Color3.new(0, 0, 0)
	vignette.BackgroundTransparency = 0.55
	vignette.BorderSizePixel = 0
	vignette.Parent = viewfinder

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.48)
	frame.Size = UDim2.fromScale(0.42, 0.55)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Parent = viewfinder

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(230, 220, 200)
	stroke.Transparency = 0.15
	stroke.Parent = frame

	local filmLabel = Instance.new("TextLabel")
	filmLabel.Name = "Film"
	filmLabel.AnchorPoint = Vector2.new(0.5, 1)
	filmLabel.Position = UDim2.new(0.5, 0, 1, -18)
	filmLabel.Size = UDim2.fromOffset(160, 22)
	filmLabel.BackgroundTransparency = 1
	filmLabel.Font = Enum.Font.Code
	filmLabel.Text = "FILM 8"
	filmLabel.TextSize = 14
	filmLabel.TextColor3 = Constants.COLOR.cream
	filmLabel.Parent = viewfinder

	local snapHint = Instance.new("TextLabel")
	snapHint.BackgroundTransparency = 1
	snapHint.Font = Enum.Font.Gotham
	snapHint.Text = "SPACE · SNAP"
	snapHint.TextSize = 12
	snapHint.TextColor3 = Color3.fromRGB(200, 196, 186)
	snapHint.AnchorPoint = Vector2.new(0.5, 1)
	snapHint.Position = UDim2.new(0.5, 0, 1, -42)
	snapHint.Size = UDim2.fromOffset(160, 18)
	snapHint.Parent = viewfinder

	local flashOverlay = Instance.new("Frame")
	flashOverlay.Name = "Flash"
	flashOverlay.Size = UDim2.fromScale(1, 1)
	flashOverlay.BackgroundColor3 = Color3.fromRGB(255, 248, 230)
	flashOverlay.BackgroundTransparency = 1
	flashOverlay.BorderSizePixel = 0
	flashOverlay.ZIndex = 20
	flashOverlay.Parent = gui

	local albumPanel = Instance.new("Frame")
	albumPanel.Name = "PolaroidAlbum"
	albumPanel.AnchorPoint = Vector2.new(0.5, 1)
	albumPanel.Position = UDim2.new(0.5, 0, 1, -140)
	albumPanel.Size = UDim2.fromOffset(420, 88)
	albumPanel.BackgroundColor3 = Color3.fromRGB(16, 14, 12)
	albumPanel.BackgroundTransparency = 0.08
	albumPanel.BorderSizePixel = 0
	albumPanel.Visible = false
	albumPanel.Parent = gui
	corner(albumPanel, 8)

	local albumTitle = Instance.new("TextLabel")
	albumTitle.BackgroundTransparency = 1
	albumTitle.Font = Enum.Font.GothamBold
	albumTitle.Text = "ALBUM"
	albumTitle.TextSize = 11
	albumTitle.TextColor3 = Color3.fromRGB(180, 176, 166)
	albumTitle.Position = UDim2.fromOffset(12, 6)
	albumTitle.Size = UDim2.new(1, -24, 0, 16)
	albumTitle.TextXAlignment = Enum.TextXAlignment.Left
	albumTitle.Parent = albumPanel

	local strip = Instance.new("Frame")
	strip.Name = "Strip"
	strip.Position = UDim2.fromOffset(10, 28)
	strip.Size = UDim2.new(1, -20, 0, 50)
	strip.BackgroundTransparency = 1
	strip.Parent = albumPanel

	local stripLayout = Instance.new("UIListLayout")
	stripLayout.FillDirection = Enum.FillDirection.Horizontal
	stripLayout.Padding = UDim.new(0, 8)
	stripLayout.SortOrder = Enum.SortOrder.LayoutOrder
	stripLayout.Parent = strip

	local emptyLabel = Instance.new("TextLabel")
	emptyLabel.Name = "Empty"
	emptyLabel.BackgroundTransparency = 1
	emptyLabel.Font = Enum.Font.Gotham
	emptyLabel.Text = "No prints yet."
	emptyLabel.TextSize = 12
	emptyLabel.TextColor3 = Color3.fromRGB(150, 146, 136)
	emptyLabel.Size = UDim2.fromScale(1, 1)
	emptyLabel.Parent = strip

	local function cameraRaised(): boolean
		return ride:GetAttribute("CameraRaised") == true
	end

	local function albumOpen(): boolean
		return ride:GetAttribute("AlbumOpen") == true
	end

	local function refreshFilm()
		local left = ride:GetAttribute("FilmLeft")
		local n = if typeof(left) == "number" then left else 0
		filmLabel.Text = string.format("FILM %d", n)
		cameraButton.Text = if cameraRaised() then "CAM·" else "CAM"
	end

	local function refreshAlbum()
		local raw = ride:GetAttribute("PolaroidAlbum")
		local photos = parseAlbum(if typeof(raw) == "string" then raw else "[]")
		for _, child in strip:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		emptyLabel.Visible = #photos == 0
		for i, photo in photos do
			if i > 6 then
				break
			end
			local cell = Instance.new("Frame")
			cell.Name = photo.id
			cell.Size = UDim2.fromOffset(44, 48)
			cell.BackgroundColor3 = Color3.fromRGB(210, 200, 180)
			cell.BackgroundTransparency = 0.15
			cell.BorderSizePixel = 0
			cell.LayoutOrder = i
			cell.Parent = strip
			corner(cell, 2)
			local undeveloped = Instance.new("Frame")
			undeveloped.Size = UDim2.new(1, -6, 1, -10)
			undeveloped.Position = UDim2.fromOffset(3, 3)
			undeveloped.BackgroundColor3 = Color3.fromRGB(40, 38, 34)
			undeveloped.BorderSizePixel = 0
			undeveloped.Parent = cell
		end
	end

	local function refresh()
		viewfinder.Visible = cameraRaised()
		albumPanel.Visible = albumOpen()
		refreshFilm()
		refreshAlbum()
		cameraButton.Visible = true
		albumButton.Visible = true
	end

	local function fireSnap()
		if not cameraRaised() then
			return
		end
		local camera = workspace.CurrentCamera
		if camera == nil then
			return
		end
		local look = camera.CFrame.LookVector
		local pos = camera.CFrame.Position
		snapRemote:FireServer(pos.X, pos.Y, pos.Z, look.X, look.Y, look.Z)
	end

	cameraButton.MouseButton1Click:Connect(function()
		toggleRemote:FireServer()
	end)
	albumButton.MouseButton1Click:Connect(function()
		albumRemote:FireServer()
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.C then
			toggleRemote:FireServer()
		elseif input.KeyCode == Enum.KeyCode.P then
			albumRemote:FireServer()
		elseif cameraRaised() and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return) then
			fireSnap()
		end
	end)

	local flashUntil = 0
	ride.AttributeChanged:Connect(function(name: string)
		if name == "PolaroidFlash" then
			local stamp = ride:GetAttribute("PolaroidFlash")
			if typeof(stamp) == "number" and stamp > 0 then
				flashUntil = os.clock() + 0.22
				flashOverlay.BackgroundTransparency = 0.15
			end
		elseif
			name == "CameraRaised"
			or name == "AlbumOpen"
			or name == "FilmLeft"
			or name == "PolaroidAlbum"
		then
			refresh()
		end
	end)

	RunService.RenderStepped:Connect(function()
		if os.clock() < flashUntil then
			local u = (flashUntil - os.clock()) / 0.22
			flashOverlay.BackgroundTransparency = 0.15 + (1 - math.clamp(u, 0, 1)) * 0.85
		else
			flashOverlay.BackgroundTransparency = 1
		end
	end)

	refresh()
end

return Polaroid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Sway</string>
            <string name="Source"><![CDATA[--!strict
-- Subtle view motion while the train is moving. The body stays where the
-- walk code put it. Bob stays at or under BOB_Y_M (2.2 cm) and roll under
-- one degree, both times speed/top speed, so a station is still.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Hold = require(ReplicatedStorage.Shared.Hold)
local Motion = require(ReplicatedStorage.Shared.Motion)

local Sway = {}

local function sample(): (number, number)
	local ride = ReplicatedStorage:FindFirstChild("Ride")
	if ride == nil then
		return 0, 0
	end
	local start = ride:GetAttribute("StretchStart")
	local accel = ride:GetAttribute("StretchAccel")
	local cruise = ride:GetAttribute("StretchCruise")
	local brake = ride:GetAttribute("StretchBrake")
	if typeof(start) ~= "number" or typeof(accel) ~= "number" or typeof(cruise) ~= "number" or typeof(brake) ~= "number" then
		return 0, 0
	end
	local top = Constants.TOP_SPEED_MPS
	local elapsed = workspace:GetServerTimeNow() - start
	local holdAt = ride:GetAttribute("HoldAt")
	local holdFor = ride:GetAttribute("HoldFor")
	local at = if typeof(holdAt) == "number" then holdAt else 0
	local span = if typeof(holdFor) == "number" then holdFor else 0
	local motionT = Hold.motionTime(elapsed, at, span)
	if not Hold.moving(elapsed, at, span) then
		return 0, 0
	end
	local velocity = Motion.speed(motionT, accel, cruise, brake, top)
	local fraction = if top > 0 then math.clamp(velocity / top, 0, 1) else 0
	local pitch = 0
	if motionT >= 0 and motionT < accel and accel > 0 then
		pitch = math.sin(math.clamp(motionT / accel, 0, 1) * math.pi)
	elseif brake > 0 and motionT > accel + cruise and motionT < accel + cruise + brake then
		local u = (motionT - accel - cruise) / brake
		pitch = -math.sin(math.clamp(u, 0, 1) * math.pi)
	end
	return fraction, pitch
end

function Sway.start()
	RunService:BindToRenderStep("LastLocalSway", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		if camera == nil then
			return
		end
		local fraction, pitchBias = sample()
		local now = os.clock()
		local bobY = (math.sin(now * 1.5) * 0.72 + math.sin(now * 2.7) * 0.28) * Constants.BOB_Y_M * fraction
		local bobZ = math.sin(now * 0.85) * Constants.BOB_X_M * fraction
		local lurch = pitchBias * 0.012 * fraction
		local roll = math.rad(math.sin(now * 0.7) * Constants.ROLL_DEG * fraction)
		local pitch = math.rad(pitchBias * Constants.PITCH_DEG)
		-- Assigning CFrame forces CameraType to Scriptable, which drops
		-- LockFirstPerson and leaves the camera on the avatar. Capture the
		-- type, nudge the view, then put the type back so the next frame's
		-- camera script still sits in the head.
		local cameraType = camera.CameraType
		local offset = Vector3.new(Constants.meters(lurch), Constants.meters(bobY), Constants.meters(bobZ))
		camera.CFrame = CFrame.new(offset) * (camera.CFrame * CFrame.Angles(pitch, 0, roll))
		if cameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = cameraType
		end
	end)
end

return Sway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">TrialChoice</string>
            <string name="Source"><![CDATA[--!strict
-- False Stop Trial pick UI. Server owns validation; fires Remotes.Trial with 0/1/2.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local TrialChoice = {}

function TrialChoice.start(
	buttonA: TextButton,
	buttonB: TextButton,
	buttonC: TextButton,
	setVisible: (boolean) -> (),
	setCountdown: (string) -> (),
	setLabels: (string, string, string, number) -> ()
)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local trialRemote = remotes:WaitForChild("Trial") :: RemoteEvent
	local sent = false

	local function active(): boolean
		return ride:GetAttribute("TrialActive") == true
	end

	local function slots(): number
		local value = ride:GetAttribute("TrialSlots")
		if typeof(value) == "number" then
			return value
		end
		return 0
	end

	local function pick(val: number)
		if not active() or sent then
			return
		end
		sent = true
		trialRemote:FireServer(val)
	end

	buttonA.MouseButton1Click:Connect(function()
		pick(0)
	end)
	buttonB.MouseButton1Click:Connect(function()
		if slots() == 2 then
			pick(2)
		else
			pick(1)
		end
	end)
	buttonC.MouseButton1Click:Connect(function()
		pick(2)
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.KeypadOne then
			pick(0)
		elseif input.KeyCode == Enum.KeyCode.Two or input.KeyCode == Enum.KeyCode.KeypadTwo then
			if slots() == 2 then
				pick(2)
			else
				pick(1)
			end
		elseif input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.KeypadThree then
			if slots() >= 3 then
				pick(2)
			end
		end
	end)

	local function textOf(name: string): string
		local value = ride:GetAttribute(name)
		if typeof(value) == "string" then
			return value
		end
		return ""
	end

	local function refresh()
		local on = active()
		setVisible(on)
		if not on then
			sent = false
			setCountdown("")
			setLabels("", "", "", 0)
			return
		end
		local n = slots()
		setLabels(textOf("TrialA"), textOf("TrialB"), textOf("TrialC"), n)
		local deadline = ride:GetAttribute("TrialUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			setCountdown("Watch the lights · signs lie")
			return
		end
		local remain = math.ceil(deadline - workspace:GetServerTimeNow())
		if remain < 1 then
			remain = 1
		end
		setCountdown(tostring(remain) .. "s · watch the lights")
	end

	ride.AttributeChanged:Connect(function(name: string)
		if
			name == "TrialActive"
			or name == "TrialUntil"
			or name == "TrialA"
			or name == "TrialB"
			or name == "TrialC"
			or name == "TrialSlots"
		then
			refresh()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if active() then
			refresh()
		end
	end)
	refresh()
end

return TrialChoice
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Walk</string>
            <string name="Source"><![CDATA[--!strict
-- First person, and the standing-passenger keep-out.
-- Roblox walks the character. This pushes the root back to the 0.75 m circle
-- if physics lets it inside (the solid cylinder should already stop it).
-- A shove smaller than a tenth of a stud is left alone so the two don't jitter.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local KeepOut = require(ReplicatedStorage.Shared.KeepOut)

local Walk = {}

local function circles(): { KeepOut.Circle }
	local list: { KeepOut.Circle } = {}
	local car = workspace:FindFirstChild("SubwayCar")
	if car == nil then
		return list
	end
	local folder = car:FindFirstChild("Passengers")
	if folder == nil then
		return list
	end
	local radius = KeepOut.radiusStuds()
	for _, child in folder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("Standing") == true and child:GetAttribute("Hidden") ~= true then
			local pos = child:GetPivot().Position
			table.insert(list, { x = pos.X, z = pos.Z, r = radius })
		end
	end
	return list
end

local function conceal(character: Model)
	local function hide(inst: Instance)
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("Decal") then
			inst.Transparency = 1
		end
	end
	for _, descendant in character:GetDescendants() do
		hide(descendant)
	end
	character.DescendantAdded:Connect(hide)
end

local function lockView(player: Player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
end

local function hideCore()
	task.spawn(function()
		for _ = 1, 20 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			end)
			if ok then
				return
			end
			task.wait(0.25)
		end
	end)
end

function Walk.start()
	local player = Players.LocalPlayer
	lockView(player)
	hideCore()
	local function onCharacter(character: Model)
		lockView(player)
		conceal(character)
	end
	local existing = player.Character
	if existing ~= nil then
		onCharacter(existing)
	end
	player.CharacterAdded:Connect(onCharacter)

	local lastX: number? = nil
	local lastZ: number? = nil

	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root == nil or not root:IsA("BasePart") then
			lastX = nil
			lastZ = nil
			return
		end
		local x = root.Position.X
		local z = root.Position.Z
		local prevX = if lastX ~= nil then lastX else x
		local prevZ = if lastZ ~= nil then lastZ else z
		local nx, nz = KeepOut.pushOut(x, z, circles(), prevX, prevZ)
		local dx = nx - x
		local dz = nz - z
		if dx * dx + dz * dz > 0.08 * 0.08 then
			root.CFrame = CFrame.new(nx, root.Position.Y, nz) * root.CFrame.Rotation
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			lastX = nx
			lastZ = nz
		else
			lastX = x
			lastZ = z
		end

		if root.Position.Y < -15 then
			local car = workspace:FindFirstChild("SubwayCar")
			local board = car and car:FindFirstChild("Board")
			if board ~= nil and board:IsA("BasePart") then
				root.CFrame = board.CFrame + Vector3.new(0, 5, 0)
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
end

return Walk
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="58">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-50</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>