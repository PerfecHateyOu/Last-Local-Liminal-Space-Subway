      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict

local Hud = require(script.Hud)
local Flag = require(script.Flag)
local Walk = require(script.Walk)
local Sway = require(script.Sway)

Hud.start()
Flag.start(Hud.flagButton())
Walk.start()
Sway.start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Flag</string>
            <string name="Source"><![CDATA[--!strict
-- Hold Flag (F, or the button) while the crosshair is on a passenger.
-- The hold is 0.7 seconds, the web game's CFG.flagHold. It only fills
-- during a ride, which is when the web game counts a flag.
-- The server decides caught vs false flag. This script does not.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Hud = require(script.Parent.Hud)

local Flag = {}

local function passengerFromHit(inst: Instance): string?
	local found: string? = nil
	local hidden = false
	local current: Instance? = inst
	while current ~= nil and current ~= workspace do
		local id = current:GetAttribute("PassengerId")
		if typeof(id) == "string" then
			found = id
		end
		if current:GetAttribute("Hidden") == true then
			hidden = true
		end
		current = current.Parent
	end
	if hidden then
		return nil
	end
	return found
end

local function gazeId(): string?
	local camera = workspace.CurrentCamera
	if camera == nil then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = Players.LocalPlayer.Character
	if character ~= nil then
		params.FilterDescendantsInstances = { character }
	end
	local result = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * Constants.meters(Constants.FLAG_RANGE_M), params)
	if result == nil then
		return nil
	end
	return passengerFromHit(result.Instance)
end

function Flag.start(button: TextButton)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local flagRemote = remotes:WaitForChild("Flag") :: RemoteEvent

	local keyDown = false
	local buttonDown = false
	local locked = false
	local progress = 0
	local currentId: string? = nil

	local function holding(): boolean
		return keyDown or buttonDown
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F then
			keyDown = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.F then
			keyDown = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			buttonDown = false
		end
	end)

	button.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			buttonDown = true
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local riding = ride:GetAttribute("Phase") == "ride"
		local down = holding()
		if not down then
			locked = false
			progress = 0
			currentId = nil
			Hud.setProgress(0, false)
			return
		end
		if not riding or locked then
			Hud.setProgress(if locked then 1 else 0, riding)
			return
		end

		local id = gazeId()
		if id == nil or id ~= currentId then
			currentId = id
			progress = 0
		end
		if currentId == nil then
			Hud.setProgress(0, true)
			return
		end
		progress += dt
		local ratio = math.clamp(progress / Constants.FLAG_HOLD, 0, 1)
		Hud.setProgress(ratio, true)
		if progress >= Constants.FLAG_HOLD and currentId ~= nil then
			locked = true
			flagRemote:FireServer(currentId)
		end
	end)
end

return Flag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen text. The words come from the server (Shared.Lines). This file
-- only places them: the amber PA line, the station card, the flag button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Lines = require(ReplicatedStorage.Shared.Lines)

local Hud = {}

local flagButton: TextButton? = nil
local progressFill: Frame? = nil

local function corner(parent: Instance, radius: number)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius)
	ui.Parent = parent
end

local function label(parent: Instance, text: string, size: number, color: Color3): TextLabel
	local ui = Instance.new("TextLabel")
	ui.BackgroundTransparency = 1
	ui.Font = Enum.Font.GothamMedium
	ui.Text = text
	ui.TextSize = size
	ui.TextColor3 = color
	ui.TextXAlignment = Enum.TextXAlignment.Left
	ui.TextYAlignment = Enum.TextYAlignment.Center
	ui.TextWrapped = true
	ui.Parent = parent
	return ui
end

function Hud.flagButton(): TextButton
	assert(flagButton ~= nil, "Hud.start must run first")
	return flagButton
end

function Hud.setProgress(ratio: number, holding: boolean)
	local fill = progressFill
	local button = flagButton
	if fill == nil or button == nil then
		return
	end
	local clamped = math.clamp(ratio, 0, 1)
	fill.Size = UDim2.fromScale(clamped, 1)
	fill.BackgroundTransparency = if clamped > 0 then 0 else 1
	if holding and clamped > 0 then
		button.BackgroundColor3 = Color3.fromRGB(28, 46, 22)
	else
		button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	end
end

function Hud.start()
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local ride = ReplicatedStorage:WaitForChild("Ride")

	local gui = Instance.new("ScreenGui")
	gui.Name = "LastLocalHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local card = Instance.new("Frame")
	card.Name = "Station"
	card.AnchorPoint = Vector2.new(0, 0)
	card.Position = UDim2.fromOffset(12, 10)
	card.Size = UDim2.new(0.62, 0, 0, 58)
	card.BackgroundColor3 = Color3.new(0, 0, 0)
	card.BackgroundTransparency = 0.35
	card.BorderSizePixel = 0
	card.Parent = gui
	corner(card, 10)

	local badge = Instance.new("TextLabel")
	badge.Name = "Line"
	badge.BackgroundColor3 = Constants.COLOR.gLine
	badge.TextColor3 = Color3.new(0, 0, 0)
	badge.Font = Enum.Font.GothamBold
	badge.Text = "G"
	badge.TextSize = 16
	badge.AnchorPoint = Vector2.new(0, 0)
	badge.Position = UDim2.fromOffset(8, 8)
	badge.Size = UDim2.fromOffset(26, 26)
	badge.Parent = card
	corner(badge, 13)

	local nextLabel = label(card, Lines.NEXT_LABEL, 14, Color3.fromRGB(180, 176, 166))
	nextLabel.Position = UDim2.fromOffset(42, 6)
	nextLabel.Size = UDim2.fromOffset(48, 20)

	local nextName = label(card, "", 16, Constants.COLOR.cream)
	nextName.Name = "NextStop"
	nextName.Font = Enum.Font.GothamBold
	nextName.Position = UDim2.fromOffset(92, 6)
	nextName.Size = UDim2.new(1, -100, 0, 20)

	local chapter = label(card, "", 11, Color3.fromRGB(210, 206, 196))
	chapter.Name = "Chapter"
	chapter.Font = Enum.Font.Gotham
	chapter.Position = UDim2.fromOffset(42, 30)
	chapter.Size = UDim2.new(1, -50, 0, 20)

	local pa = Instance.new("TextLabel")
	pa.Name = "PA"
	pa.AnchorPoint = Vector2.new(0.5, 0)
	pa.Position = UDim2.new(0.5, 0, 0, 78)
	pa.Size = UDim2.new(0.92, 0, 0, 28)
	pa.AutomaticSize = Enum.AutomaticSize.Y
	pa.BackgroundColor3 = Constants.COLOR.paBg
	pa.BackgroundTransparency = 0.05
	pa.BorderSizePixel = 0
	pa.Font = Enum.Font.GothamBold
	pa.TextColor3 = Constants.COLOR.warn
	pa.TextSize = 18
	pa.TextWrapped = true
	pa.Text = ""
	pa.Visible = false
	pa.Parent = gui
	corner(pa, 6)

	local hint = Instance.new("TextLabel")
	hint.Name = "Hint"
	hint.AnchorPoint = Vector2.new(0.5, 0)
	hint.Position = UDim2.new(0.5, 0, 0, 120)
	hint.Size = UDim2.new(0.9, 0, 0, 28)
	hint.AutomaticSize = Enum.AutomaticSize.Y
	hint.BackgroundColor3 = Color3.new(0, 0, 0)
	hint.BackgroundTransparency = 0.25
	hint.BorderSizePixel = 0
	hint.Font = Enum.Font.Gotham
	hint.TextColor3 = Constants.COLOR.cream
	hint.TextSize = 14
	hint.TextWrapped = true
	hint.Text = ""
	hint.Visible = false
	hint.Parent = gui
	corner(hint, 6)

	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.AnchorPoint = Vector2.new(0.5, 1)
	subtitle.Position = UDim2.new(0.5, 0, 1, -118)
	subtitle.Size = UDim2.new(0.9, 0, 0, 48)
	subtitle.BackgroundColor3 = Color3.new(0, 0, 0)
	subtitle.BackgroundTransparency = 0.25
	subtitle.BorderSizePixel = 0
	subtitle.Font = Enum.Font.Gotham
	subtitle.TextColor3 = Constants.COLOR.cream
	subtitle.TextSize = 16
	subtitle.TextWrapped = true
	subtitle.Text = ""
	subtitle.Visible = false
	subtitle.Parent = gui
	corner(subtitle, 6)

	local feedback = Instance.new("TextLabel")
	feedback.Name = "Feedback"
	feedback.AnchorPoint = Vector2.new(0.5, 1)
	feedback.Position = UDim2.new(0.5, 0, 1, -172)
	feedback.Size = UDim2.new(0.86, 0, 0, 32)
	feedback.BackgroundTransparency = 1
	feedback.Font = Enum.Font.GothamBold
	feedback.TextColor3 = Constants.COLOR.cream
	feedback.TextSize = 20
	feedback.TextWrapped = true
	feedback.Text = ""
	feedback.Visible = false
	feedback.Parent = gui

	local strip = label(gui, "[F] FLAG   ·   [WASD] WALK", 13, Color3.fromRGB(220, 216, 206))
	strip.AnchorPoint = Vector2.new(0, 1)
	strip.Position = UDim2.new(0, 14, 1, -18)
	strip.Size = UDim2.fromOffset(220, 22)
	strip.Font = Enum.Font.Code

	local barBack = Instance.new("Frame")
	barBack.Name = "FlagBar"
	barBack.AnchorPoint = Vector2.new(1, 1)
	barBack.Position = UDim2.new(1, -16, 1, -112)
	barBack.Size = UDim2.fromOffset(88, 6)
	barBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	barBack.BorderSizePixel = 0
	barBack.Parent = gui
	corner(barBack, 3)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Constants.COLOR.gLine
	fill.BorderSizePixel = 0
	fill.Parent = barBack
	corner(fill, 3)
	progressFill = fill

	local button = Instance.new("TextButton")
	button.Name = "Flag"
	button.AnchorPoint = Vector2.new(1, 1)
	button.Position = UDim2.new(1, -16, 1, -16)
	button.Size = UDim2.fromOffset(88, 88)
	button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	button.BackgroundTransparency = 0.15
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.Text = "FLAG"
	button.TextColor3 = Constants.COLOR.cream
	button.TextSize = 16
	button.TextYAlignment = Enum.TextYAlignment.Top
	button.Parent = gui
	corner(button, 44)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 22)
	pad.Parent = button
	local hold = label(button, "hold to catch", 11, Color3.fromRGB(210, 206, 196))
	hold.AnchorPoint = Vector2.new(0.5, 0)
	hold.Position = UDim2.new(0.5, 0, 0, 28)
	hold.Size = UDim2.new(1, -8, 0, 28)
	hold.TextXAlignment = Enum.TextXAlignment.Center
	hold.Font = Enum.Font.Gotham
	local buttonScale = Instance.new("UIScale")
	buttonScale.Parent = button
	flagButton = button

	local dwellCard = Instance.new("Frame")
	dwellCard.Name = "Dwell"
	dwellCard.AnchorPoint = Vector2.new(0.5, 1)
	dwellCard.Position = UDim2.new(0.5, 0, 1, -214)
	dwellCard.Size = UDim2.fromOffset(280, 54)
	dwellCard.BackgroundColor3 = Color3.new(0, 0, 0)
	dwellCard.BackgroundTransparency = 0.35
	dwellCard.BorderSizePixel = 0
	dwellCard.Visible = false
	dwellCard.Parent = gui
	corner(dwellCard, 10)

	local dwellTitle = label(dwellCard, Lines.MIN_DWELL, 13, Constants.COLOR.warn)
	dwellTitle.Name = "Title"
	dwellTitle.Font = Enum.Font.GothamBold
	dwellTitle.Position = UDim2.fromOffset(12, 4)
	dwellTitle.Size = UDim2.new(1, -24, 0, 18)

	local dwellCount = label(dwellCard, "", 22, Constants.COLOR.cream)
	dwellCount.Name = "Countdown"
	dwellCount.Font = Enum.Font.GothamBold
	dwellCount.Position = UDim2.fromOffset(12, 22)
	dwellCount.Size = UDim2.new(1, -24, 0, 28)

	local boardCard = Instance.new("Frame")
	boardCard.Name = "CountdownBoard"
	boardCard.AnchorPoint = Vector2.new(1, 0)
	boardCard.Position = UDim2.new(1, -12, 0, 10)
	boardCard.Size = UDim2.fromOffset(168, 58)
	boardCard.BackgroundColor3 = Color3.new(0, 0, 0)
	boardCard.BackgroundTransparency = 0.35
	boardCard.BorderSizePixel = 0
	boardCard.Visible = false
	boardCard.Parent = gui
	corner(boardCard, 10)

	local boardNext = label(boardCard, Lines.NEXT_LABEL, 13, Color3.fromRGB(180, 176, 166))
	boardNext.Position = UDim2.fromOffset(10, 6)
	boardNext.Size = UDim2.new(1, -20, 0, 16)

	local boardName = label(boardCard, "", 15, Constants.COLOR.cream)
	boardName.Name = "Stop"
	boardName.Font = Enum.Font.GothamBold
	boardName.Position = UDim2.fromOffset(10, 22)
	boardName.Size = UDim2.new(1, -20, 0, 16)

	local boardMinutes = label(boardCard, "", 13, Constants.COLOR.warn)
	boardMinutes.Name = "Minutes"
	boardMinutes.Font = Enum.Font.GothamBold
	boardMinutes.Position = UDim2.fromOffset(10, 38)
	boardMinutes.Size = UDim2.new(1, -20, 0, 16)

	local cross = Instance.new("Frame")
	cross.Name = "Crosshair"
	cross.AnchorPoint = Vector2.new(0.5, 0.5)
	cross.Position = UDim2.fromScale(0.5, 0.5)
	cross.Size = UDim2.fromOffset(5, 5)
	cross.BackgroundColor3 = Constants.COLOR.cream
	cross.BackgroundTransparency = 0.15
	cross.BorderSizePixel = 0
	cross.Active = false
	cross.Parent = gui
	corner(cross, 3)

	local function textOf(name: string): string
		local value = ride:GetAttribute(name)
		if typeof(value) == "string" then
			return value
		end
		return ""
	end

	local function refresh()
		local stopName = textOf("NextStop")
		nextName.Text = stopName
		nextLabel.Visible = stopName ~= ""
		chapter.Text = textOf("ChapterLine")

		local boardStop = textOf("BoardStop")
		local minutesValue = ride:GetAttribute("BoardMinutes")
		local minutes = if typeof(minutesValue) == "number" then minutesValue else nil
		boardCard.Visible = boardStop ~= "" and minutes ~= nil
		boardName.Text = boardStop
		boardMinutes.Text = if minutes ~= nil then Lines.minutesLabel(minutes) else ""

		local paText = textOf("PaText")
		pa.Text = paText
		pa.Visible = paText ~= ""

		local hintText = textOf("Hint")
		hint.Text = hintText
		hint.Visible = hintText ~= ""

		local subText = textOf("Subtitle")
		subtitle.Text = subText
		subtitle.Visible = subText ~= ""

		local feedbackText = textOf("Feedback")
		feedback.Text = feedbackText
		feedback.Visible = feedbackText ~= ""
		local kind = textOf("FeedbackKind")
		if kind == "caught" then
			feedback.TextColor3 = Constants.COLOR.gLine
		elseif kind == "false" or kind == "missed" then
			feedback.TextColor3 = Constants.COLOR.warn
		else
			feedback.TextColor3 = Constants.COLOR.cream
		end
	end

	RunService.Heartbeat:Connect(function()
		local deadline = ride:GetAttribute("DwellUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			dwellCard.Visible = false
			return
		end
		local remain = deadline - workspace:GetServerTimeNow()
		if remain <= 0 then
			dwellCard.Visible = false
			return
		end
		dwellCard.Visible = true
		dwellCount.Text = Lines.dwellCountdown(remain)
	end)

	ride.AttributeChanged:Connect(function(name: string)
		if name == "Feedback" and textOf("Feedback") ~= "" then
			buttonScale.Scale = 1.08
			task.delay(0.18, function()
				buttonScale.Scale = 1
			end)
		end
		refresh()
	end)
	refresh()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Sway</string>
            <string name="Source"><![CDATA[--!strict
-- Subtle view motion while the train is moving. The body stays where the
-- walk code put it. Bob stays at or under BOB_Y_M (2.2 cm) and roll under
-- one degree, both times speed/top speed, so a station is still.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Motion = require(ReplicatedStorage.Shared.Motion)

local Sway = {}

local function sample(): (number, number)
	local ride = ReplicatedStorage:FindFirstChild("Ride")
	if ride == nil then
		return 0, 0
	end
	local start = ride:GetAttribute("StretchStart")
	local accel = ride:GetAttribute("StretchAccel")
	local cruise = ride:GetAttribute("StretchCruise")
	local brake = ride:GetAttribute("StretchBrake")
	if typeof(start) ~= "number" or typeof(accel) ~= "number" or typeof(cruise) ~= "number" or typeof(brake) ~= "number" then
		return 0, 0
	end
	local top = Constants.TOP_SPEED_MPS
	local t = workspace:GetServerTimeNow() - start
	local velocity = Motion.speed(t, accel, cruise, brake, top)
	local fraction = if top > 0 then math.clamp(velocity / top, 0, 1) else 0
	local pitch = 0
	if t >= 0 and t < accel and accel > 0 then
		pitch = math.sin(math.clamp(t / accel, 0, 1) * math.pi)
	elseif brake > 0 and t > accel + cruise and t < accel + cruise + brake then
		local u = (t - accel - cruise) / brake
		pitch = -math.sin(math.clamp(u, 0, 1) * math.pi)
	end
	return fraction, pitch
end

function Sway.start()
	RunService:BindToRenderStep("LastLocalSway", Enum.RenderPriority.Camera.Value + 1, function()
		local camera = workspace.CurrentCamera
		if camera == nil then
			return
		end
		local fraction, pitchBias = sample()
		local now = os.clock()
		local bobY = (math.sin(now * 1.5) * 0.72 + math.sin(now * 2.7) * 0.28) * Constants.BOB_Y_M * fraction
		local bobZ = math.sin(now * 0.85) * Constants.BOB_X_M * fraction
		local lurch = pitchBias * 0.012 * fraction
		local roll = math.rad(math.sin(now * 0.7) * Constants.ROLL_DEG * fraction)
		local pitch = math.rad(pitchBias * Constants.PITCH_DEG)
		-- Assigning CFrame forces CameraType to Scriptable, which drops
		-- LockFirstPerson and leaves the camera on the avatar. Capture the
		-- type, nudge the view, then put the type back so the next frame's
		-- camera script still sits in the head.
		local cameraType = camera.CameraType
		local offset = Vector3.new(Constants.meters(lurch), Constants.meters(bobY), Constants.meters(bobZ))
		camera.CFrame = CFrame.new(offset) * (camera.CFrame * CFrame.Angles(pitch, 0, roll))
		if cameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = cameraType
		end
	end)
end

return Sway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Walk</string>
            <string name="Source"><![CDATA[--!strict
-- First person, and the standing-passenger keep-out.
-- Roblox walks the character. This pushes the root back to the 0.75 m circle
-- if physics lets it inside (the solid cylinder should already stop it).
-- A shove smaller than a tenth of a stud is left alone so the two don't jitter.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local KeepOut = require(ReplicatedStorage.Shared.KeepOut)

local Walk = {}

local function circles(): { KeepOut.Circle }
	local list: { KeepOut.Circle } = {}
	local car = workspace:FindFirstChild("SubwayCar")
	if car == nil then
		return list
	end
	local folder = car:FindFirstChild("Passengers")
	if folder == nil then
		return list
	end
	local radius = KeepOut.radiusStuds()
	for _, child in folder:GetChildren() do
		if child:IsA("Model") and child:GetAttribute("Standing") == true and child:GetAttribute("Hidden") ~= true then
			local pos = child:GetPivot().Position
			table.insert(list, { x = pos.X, z = pos.Z, r = radius })
		end
	end
	return list
end

local function conceal(character: Model)
	local function hide(inst: Instance)
		if inst:IsA("BasePart") then
			inst.LocalTransparencyModifier = 1
		elseif inst:IsA("Decal") then
			inst.Transparency = 1
		end
	end
	for _, descendant in character:GetDescendants() do
		hide(descendant)
	end
	character.DescendantAdded:Connect(hide)
end

local function lockView(player: Player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
end

local function hideCore()
	task.spawn(function()
		for _ = 1, 20 do
			local ok = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			end)
			if ok then
				return
			end
			task.wait(0.25)
		end
	end)
end

function Walk.start()
	local player = Players.LocalPlayer
	lockView(player)
	hideCore()
	local function onCharacter(character: Model)
		lockView(player)
		conceal(character)
	end
	local existing = player.Character
	if existing ~= nil then
		onCharacter(existing)
	end
	player.CharacterAdded:Connect(onCharacter)

	local lastX: number? = nil
	local lastZ: number? = nil

	RunService.Heartbeat:Connect(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root == nil or not root:IsA("BasePart") then
			lastX = nil
			lastZ = nil
			return
		end
		local x = root.Position.X
		local z = root.Position.Z
		local prevX = if lastX ~= nil then lastX else x
		local prevZ = if lastZ ~= nil then lastZ else z
		local nx, nz = KeepOut.pushOut(x, z, circles(), prevX, prevZ)
		local dx = nx - x
		local dz = nz - z
		if dx * dx + dz * dz > 0.08 * 0.08 then
			root.CFrame = CFrame.new(nx, root.Position.Y, nz) * root.CFrame.Rotation
			root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
			lastX = nx
			lastZ = nz
		else
			lastX = x
			lastZ = z
		end

		if root.Position.Y < -15 then
			local car = workspace:FindFirstChild("SubwayCar")
			local board = car and car:FindFirstChild("Board")
			if board ~= nil and board:IsA("BasePart") then
				root.CFrame = board.CFrame + Vector3.new(0, 5, 0)
				root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	end)
end

return Walk
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="25">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>