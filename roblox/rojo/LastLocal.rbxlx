          <string name="Name">Achievements</string>
          <string name="Source"><![CDATA[--!strict
-- Career achievements from src/game/achievements.ts.
-- Persistence lives in MetaStore; this module is defs + unlock helpers.

local Achievements = {}

export type AchievementId =
	"first_anomaly"
	| "photo_evidence"
	| "tuning_pro"
	| "broadcaster_lore"
	| "iron_composure"
	| "trestle_cross"
	| "loop_breaker"
	| "master_archivist"

export type AchievementDef = {
	id: AchievementId,
	title: string,
	category: string,
	description: string,
	badge: string,
	secret: boolean?,
}

export type UnlockedMap = { [string]: { unlockedAt: number } }

local DEFS: { [AchievementId]: AchievementDef } = {
	first_anomaly = {
		id = "first_anomaly",
		title = "First Contact",
		category = "observation",
		description = "Catch your first anomaly with a flag or Polaroid photo.",
		badge = "FLAG",
	},
	photo_evidence = {
		id = "photo_evidence",
		title = "Silver Halide Evidence",
		category = "observation",
		description = "Successfully photograph an active car anomaly with the Polaroid 600.",
		badge = "PHOTO",
	},
	tuning_pro = {
		id = "tuning_pro",
		title = "Signal Hunter",
		category = "signals",
		description = "Record at least 3 distinct radio signals on the microcassette recorder.",
		badge = "EVP",
	},
	broadcaster_lore = {
		id = "broadcaster_lore",
		title = "Phantom Broadcaster",
		category = "signals",
		description = "Discover and record a secret station broadcaster frequency.",
		badge = "RADIO",
	},
	iron_composure = {
		id = "iron_composure",
		title = "The Unbroken Mask",
		category = "composure",
		description = "Complete a full ride with 0 peak suspicion from your parents.",
		badge = "MASK",
		secret = true,
	},
	trestle_cross = {
		id = "trestle_cross",
		title = "Night Watch",
		category = "survival",
		description = "Witness the Newtown Creek trestle crossing into the night sky.",
		badge = "VISTA",
	},
	loop_breaker = {
		id = "loop_breaker",
		title = "Loop Breaker",
		category = "survival",
		description = "Unlock any alternative escape ending beyond standard Civilian Extraction.",
		badge = "ESCAPE",
	},
	master_archivist = {
		id = "master_archivist",
		title = "Chief Archivist",
		category = "observation",
		description = "Catalog at least 6 distinct anomaly types across rides.",
		badge = "DOSSIER",
	},
}

Achievements.DEFS = DEFS
Achievements.IDS = {
	"first_anomaly",
	"photo_evidence",
	"tuning_pro",
	"broadcaster_lore",
	"iron_composure",
	"trestle_cross",
	"loop_breaker",
	"master_archivist",
} :: { AchievementId }

function Achievements.definition(id: AchievementId): AchievementDef
	return DEFS[id]
end

function Achievements.has(map: UnlockedMap, id: string): boolean
	return map[id] ~= nil
end

-- Returns true when newly unlocked.
function Achievements.unlock(map: UnlockedMap, id: AchievementId, at: number, offRecord: boolean): boolean
	if offRecord then
		return false
	end
	if map[id] ~= nil then
		return false
	end
	map[id] = { unlockedAt = at }
	return true
end

function Achievements.count(map: UnlockedMap): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end

return Achievements
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[--!strict
-- Mesh and sound asset wiring for the Studio place.
--
-- Meshes: CarBuilder clones Models under ReplicatedStorage.Models (FBX
-- imports). A missing model uses Part figures — that is intentional, not an
-- error. See README "Put your characters in the car".
--
-- Sounds: classic rbxasset://sounds/* paths are often rejected as unapproved
-- and spam Output. Defaults are empty (silent). After you upload audio (or
-- pick Creator Store clips you may use), put rbxassetid://… values in
-- ReplicatedStorage.Assets StringValues named below. Do not invent private
-- asset IDs in source.

local Assets = {}

export type SoundKey = "chime" | "door" | "clack" | "rumble" | "openAir" | "polaroid"

-- Folder child names under ReplicatedStorage.Assets (StringValue.Value).
Assets.SOUND_VALUE_NAMES = {
	chime = "Chime",
	door = "Door",
	clack = "Clack",
	rumble = "Rumble",
	openAir = "OpenAir",
	polaroid = "Polaroid",
}

-- Ordered for one-line status logs.
Assets.SOUND_ORDER = { "chime", "door", "clack", "rumble", "openAir", "polaroid" } :: { SoundKey }

-- Verified public NYC subway door scene (~8.15s). Paste into place
-- ReplicatedStorage.Assets.Door when you want open/close scenes. Not a
-- silent-override fallback: empty Door stays silent (no invented private IDs).
Assets.RECOMMENDED_DOOR_ID = "rbxassetid://9117093785"

-- Strip whitespace; accept bare digits as rbxassetid://N; reject classic
-- rbxasset://sounds/* paths that Roblox often blocks for experiences.
function Assets.normalizeSoundId(raw: string?): string
	if raw == nil then
		return ""
	end
	local trimmed = string.gsub(raw, "^%s+", "")
	trimmed = string.gsub(trimmed, "%s+$", "")
	if trimmed == "" then
		return ""
	end
	local lower = string.lower(trimmed)
	if string.find(lower, "^rbxasset://sounds/") ~= nil then
		return ""
	end
	if string.match(trimmed, "^%d+$") ~= nil then
		return "rbxassetid://" .. trimmed
	end
	return trimmed
end

function Assets.isSoundIdReady(id: string): boolean
	return Assets.normalizeSoundId(id) ~= ""
end

local function readStringValue(folder: Instance?, name: string): string?
	if folder == nil then
		return nil
	end
	local child = folder:FindFirstChild(name)
	if child == nil then
		return nil
	end
	if child:IsA("StringValue") then
		return child.Value
	end
	local attr = folder:GetAttribute(name)
	if typeof(attr) == "string" then
		return attr
	end
	return nil
end

-- Place overrides live under ReplicatedStorage.Assets (created empty by Rojo;
-- Studio fills StringValues). Missing folder / empty values → silent.
function Assets.placeFolder(): Folder?
	local ok, replicated = pcall(function()
		return game:GetService("ReplicatedStorage")
	end)
	if not ok or replicated == nil then
		return nil
	end
	local rs = replicated :: any
	local folder = rs:FindFirstChild("Assets")
	if folder ~= nil and folder:IsA("Folder") then
		return folder
	end
	return nil
end

function Assets.soundId(key: SoundKey): string
	local name = Assets.SOUND_VALUE_NAMES[key]
	local fromPlace = readStringValue(Assets.placeFolder(), name)
	return Assets.normalizeSoundId(fromPlace)
end

function Assets.soundStatus(): (number, number, { string })
	local ready = 0
	local missing: { string } = {}
	for _, key in Assets.SOUND_ORDER do
		local id = Assets.soundId(key)
		if id ~= "" then
			ready += 1
		else
			table.insert(missing, Assets.SOUND_VALUE_NAMES[key])
		end
	end
	return ready, #Assets.SOUND_ORDER, missing
end

-- Mid-car riders CarBuilder always tries (modelName / NPC aliases).
Assets.CORE_MODEL_HINTS = {
	"mom / NPC_mom_seated",
	"dad / NPC_dad_seated",
	"passenger_mta / NPC_mta_seated",
	"passenger_coat / NPC_coat_seated",
	"passenger_puffer / NPC_puffer",
	"anomaly_extra",
	"Car_B (optional interior)",
}

return Assets
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Band</string>
          <string name="Source"><![CDATA[--!strict
-- Suspicion bands. The server picks the band from the suspicion number.
-- A band may blink one tube, dim the car slowly, or leave the lamps alone.
-- It never blacks the whole car out. That remains the flicker tick.

local Band = {}

function Band.fromSuspicion(value: number, calmMax: number, uneasyMax: number, watchedMax: number): string
	if value <= calmMax then
		return "calm"
	end
	if value <= uneasyMax then
		return "uneasy"
	end
	if value <= watchedMax then
		return "watched"
	end
	return "hunted"
end

-- Lamp action. "blackout" is not a band, and it is not returned.
function Band.light(band: string): string
	if band == "uneasy" then
		return "strip"
	end
	if band == "hunted" then
		return "dim"
	end
	return "none"
end

function Band.blacksOutCar(effect: string): boolean
	return effect == "blackout" or effect == "whole_car"
end

-- A hunted dim stays above off. Zero would be a blackout.
function Band.dimTarget(fraction: number): number
	if fraction <= 0 then
		return 0.5
	end
	return math.clamp(fraction, 0.05, 1)
end

-- Repeat the second word of an existing line. No new word is added.
function Band.glitchLine(line: string): string
	if line == "" then
		return ""
	end
	local words = string.split(line, " ")
	if #words == 0 then
		return line
	end
	local index = if #words >= 2 then 2 else 1
	table.insert(words, index + 1, words[index])
	return table.concat(words, " ")
end

-- Added to a false-stop roll at WATCHED. This slice's stops are a fixed
-- table, so the ride publishes the number and does not reroll them.
function Band.falseStopBonus(band: string, bonus: number): number
	if band == "watched" then
		return bonus
	end
	return 0
end

-- What the client does with heads. The server does not pose them.
function Band.look(band: string): string
	if band == "uneasy" then
		return "glance"
	end
	if band == "watched" then
		return "turn"
	end
	return "none"
end

return Band
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Constants</string>
          <string name="Source"><![CDATA[--!strict
-- Tuning copied from the web game (src/constants.ts, src/game/gameState.ts,
-- src/game/personKeepOut.ts). Distances in the tables stay in metres; the car
-- builder multiplies by STUDS_PER_METER.

local Constants = {}

-- A default Roblox character is about 5 studs tall. 3 studs per metre makes a
-- 1.7 m rider about 5.1 studs, so the imported people and the player match.
Constants.STUDS_PER_METER = 3

-- personKeepOut.ts: eye to the standing passenger's centre.
Constants.KEEP_OUT_METERS = 0.75

-- Default HumanoidRootPart is 2 studs wide. The solid keep-out cylinder is
-- this much smaller than 0.75 m so the root's centre, not its skin, stops at
-- the radius.
Constants.ROOT_HALF_WIDTH_STUDS = 1

-- gameState.ts walking speed (m/s) and the eye height the web camera uses.
Constants.WALK_SPEED_MPS = 2.4
Constants.EYE_HEIGHT_M = 1.18

-- constants.ts CFG.flagHold. How long Flag must be held on one person.
Constants.FLAG_HOLD = 0.7

-- Web timings, in seconds: TA = 5, TD = 6, default cruise 26.
-- NEXT_STOP_PA_AT = 7, NEXT_STOP_PA_S = 4.5.
-- This slice shortens accel, cruise and brake so a playtest can hear every
-- stop. The "next stop" line still starts 7 seconds into the stretch.
Constants.ACCEL = 3
Constants.BRAKE = 3
Constants.CRUISE = 12
Constants.NEXT_STOP_AT = 7
Constants.NEXT_STOP_FOR = 4.5

-- arrive(): flickerUntil = GT + 0.16. Whole-car blackout, flicker tick only.
Constants.FLICKER_TICK_SECONDS = 0.16

-- Far door leaves slide this many metres when doorOpen goes from 0 to 1.
Constants.DOOR_SLIDE_M = 0.62

-- Existing arrival hold when the PA tells a lie, measured from arrival.
-- The minimum dwell is a floor under this. It does not replace it.
Constants.PA_LIE_HOLD = 5.4

-- How long the doors stay open before the train may leave, in seconds.
-- The server waits at least this long after the doors open. The client
-- only shows the countdown. 2.6 is the gap this slice already waited
-- between the doors opening and "Stand clear".
Constants.MIN_DWELL_SECONDS = 2.6

-- Closing the doors or leaving before that dwell ends. The player is a
-- passenger and cannot depart, so the ride never adds this. The hook
-- stays. Clamped. The ride does not end.
Constants.EARLY_DEPARTURE_SUSPICION = 10
Constants.SUSPICION_MIN = 0
Constants.SUSPICION_MAX = 100

-- Flagging while no tell and no poster change is up. A correct flag lowers
-- suspicion. A clean stop and a stop with no flag each decay. A miss does
-- not raise suspicion; the decay is the only change on a quiet miss.
Constants.FALSE_ALARM_SUSPICION = 10
Constants.CORRECT_FLAG_SUSPICION = 5
Constants.CLEAN_STOP_SUSPICION = 5
Constants.DECAY_SUSPICION = 2

-- Reacting at a false stop: standing near an open door leaf during the dwell.
Constants.FALSE_STOP_REACT_SUSPICION = 10
Constants.FALSE_STOP_DOOR_RANGE_M = 2.2

-- Caught staring (web SUS.visible / CFG.dwellReact). Parents are "alert"
-- on watched/hunted, or while Held At Signal (StareIntervalScale > 1).
Constants.STARE_ANOMALY_SUSPICION = 15
Constants.STARE_PARENT_SUSPICION = 5
Constants.STARE_ANOMALY_SECONDS = 1.5
Constants.STARE_PARENT_SECONDS = 2.4
-- Sitting still on a clean stop (extra decay).
Constants.SITTING_STILL_SUSPICION = 2
Constants.SITTING_STILL_MOVE_M = 1.2

-- Flicker tick lengthens slightly at watched/hunted (still not a hold blackout).
Constants.FLICKER_WATCHED_SCALE = 1.6
Constants.FLICKER_HUNTED_SCALE = 2.2

-- Stay / step-off (web SUS.falsePos / refuseHaven / maskFail).
Constants.STEP_OFF_REAL_SUSPICION = 20
Constants.REFUSE_HAVEN_SUSPICION = 10
Constants.FALSE_STOP_STEP_OFF_SUSPICION = 15
-- Choice window after doors open. Timeout counts as Stay on.
Constants.DOOR_CHOICE_SECONDS = 5

-- False Stop Trial exit (web SUS.falsePos / SAN.trial).
Constants.TRIAL_EXIT_SUSPICION = 20
Constants.TRIAL_SANITY = 20
Constants.TRIAL_CYCLE = 3.6
Constants.TRIAL_FLICK_SECONDS = 0.14
Constants.TRIAL_HINT_SECONDS = 6

-- Parent chats during cruise (web CHAT_AT / CHAT_LINE_S). Slice times sit
-- after the next-stop PA (7 + 4.5) on the shortened stretch.
Constants.CHAT_AT_1 = 12.0
Constants.CHAT_AT_2 = 14.2
Constants.CHAT_LINE_SECONDS = 2.6

-- Mask checks (web MASK_CHECK_S / presentChoice). First dialogue tier only.
Constants.MASK_CHOICE_SECONDS = 4
Constants.MASK_PROMPT_SECONDS = 6
Constants.MASK_FAIL_SUSPICION = 15
Constants.MASK_TIMEOUT_SUSPICION = 8
-- Sanity (web SAN / BANDS / DRIFT). Safe Haven restores +15. Mask / trial /
-- restraint / intervention nudge it inside the current stop band.
Constants.SANITY_START = 100
Constants.SANITY_MIN = 0
Constants.SANITY_MAX = 100
Constants.SANITY_HAVEN = 15
Constants.MASK_FAIL_SANITY = 4
Constants.MASK_TIMEOUT_SANITY = 2
Constants.SANITY_INTERVENTION = 5
Constants.SANITY_RESTRAINT_OK = 8
Constants.SANITY_RESTRAINT_FAIL = 5
-- Holding the Greenpoint restraint lifts the 11–13 band ceiling (web RESTRAINT_RAISE).
Constants.RESTRAINT_RAISE = 6
Constants.RESTRAINT_START_AT = 8.0
Constants.RESTRAINT_DURATION = 15.0
-- Web grab window is 5s; Studio Play needs longer for Space/F to register
-- after the HOLD prompt appears. Fail still soft (suspicion bump, ride continues).
Constants.RESTRAINT_WAIT = 10.0
Constants.RESTRAINT_GRACE = 2.5
Constants.RESTRAINT_FAIL_SUSPICION = 15
-- Concerned intervention (web SUS.intervene). Resets suspicion to 40; does not end the ride.
Constants.INTERVENE_SUSPICION = 60
Constants.INTERVENTION_RESET_SUSPICION = 40
-- needsSus mask lines only appear at or above this suspicion.
Constants.MASK_NEED_SUSPICION = 10
-- Product decision (Rojo): reaching suspicion 100 does NOT end the ride.
-- Intervention can fire at 60+, but there is no hard fail at the cap.
-- Court Square endings (PR14) still use peak/interventions; they never invent a fail-at-100 ending.
Constants.SUSPICION_HARD_FAIL = false

-- Court Sq exit choice window (web presentFinalExitChoice window 8.0).
Constants.EXIT_CHOICE_SECONDS = 8
-- Quieter branch endings need peak ≤ half of INTERVENE_SUSPICION.
Constants.COMPOSED_PEAK = 30

-- Meta progression (PR15).
Constants.META_TAPE_ARCHIVE_MAX = 24
Constants.META_ALBUM_ARCHIVE_MAX = 24
Constants.META_REPORT_IDLE_SECONDS = 45

-- Bands from the suspicion number. 0–24 calm, 25–49 uneasy, 50–74 watched,
-- 75–100 hunted.
Constants.BAND_CALM_MAX = 24
Constants.BAND_UNEASY_MAX = 49
Constants.BAND_WATCHED_MAX = 74

-- Uneasy: one tube, occasionally. Not the whole car.
Constants.UNEASY_TUBE_EVERY = 7
Constants.UNEASY_TUBE_BLINK = 0.15
Constants.BAND_STRIP_NAME = "LightStrip_06"

-- How far a head may turn, in degrees. Glance is the short look.
Constants.GLANCE_YAW_DEG = 18
Constants.TURN_YAW_DEG = 28
Constants.GLANCE_SECONDS = 0.8
Constants.GLANCE_COOLDOWN = 2.4

-- Hunted: slow dim. Above zero so the car does not go dark.
Constants.HUNTED_DIM = 0.5
Constants.HUNTED_DIM_SECONDS = 2.5

-- Watched would raise the chance of a false stop. The route is a fixed
-- table, so this number is published and not rolled.
Constants.WATCHED_FALSE_STOP_BONUS = 0.15

-- One tell per stop, by the arrival number on the segment. Other stops
-- have none. 3 is the poster. 5 is the mid-ride extra passenger. 7 is the
-- ride into Flushing Av. 10 is the ride into Nassau Av. The scripted
-- arrival lie stays on stop 9 and is not one of these.
Constants.ANOMALY_POSTER_STOP = 3
Constants.ANOMALY_EXTRA_STOP = 5
Constants.ANOMALY_ANNOUNCE_STOP = 7
Constants.ANOMALY_COUNTDOWN_STOP = 10
-- Expanded catalog (PR12). Quiet / false-approach stretches; NEAR_X props stay close.
Constants.ANOMALY_LIGHTTEMP_STOP = 2
Constants.ANOMALY_STICKER_STOP = 4
Constants.ANOMALY_NEARWORD_STOP = 8
Constants.ANOMALY_MAPSTOP_STOP = 9
Constants.ANOMALY_MOVED_STOP = 11
Constants.ANOMALY_EMPTY_STOP = 13
-- Character-swap tells (Part fallback; optional FBX later).
Constants.ANOMALY_FACETURN_STOP = 0 -- unused this slice; apply path exists
Constants.ANOMALY_MOMFACE_STOP = 0
-- Mid-stretch appear times (seconds into the ride stretch).
Constants.CATALOG_APPEAR_AT = 7
-- Moved passenger home vs far-door X (metres), matching web s3 / moved.
Constants.MOVED_HOME_X = 5.0
Constants.MOVED_FAR_X = -5.0
-- Cold light for lighttemp (web 0x8cc2ff).
Constants.LIGHTTEMP_COLOR = Color3.fromRGB(140, 194, 255)

-- Seconds into the stretch when seat6 appears (after accel, during cruise).
-- Web waits until you look away; this slice reveals on a fixed timer.
Constants.EXTRA_APPEAR_AT = 7

-- Signed names the wrong announcement may say. 13 is Court Sq. 2 is
-- Fulton St, used only when 13 is the stop the train is actually nearing.
Constants.WRONG_ANNOUNCE_STOP = 13
Constants.WRONG_ANNOUNCE_FALLBACK_STOP = 2

-- The board's minute count. Every stretch in this slice is under a minute,
-- so the honest board reads 1. The wrong board reads 4.
Constants.COUNTDOWN_MINUTES = 1
Constants.WRONG_COUNTDOWN_MINUTES = 4

-- Held At Signal. Wall seconds into a stretch, then how long the tunnel
-- stays still. 6 is during cruise (accel is 3). The train is not at a
-- platform. Stops 8 and 11 are Broadway and Greenpoint Av.
Constants.HOLD_AT = 6
Constants.HOLD_SECONDS = 4
Constants.HOLD_STOP_A = 8
Constants.HOLD_STOP_B = 11
Constants.HOLD_EFFECT_A = "strip"
Constants.HOLD_EFFECT_B = "dim"
-- One tube. Not the whole car. The door tick still owns the blackout.
Constants.HOLD_STRIP_NAME = "LightStrip_05"
Constants.HOLD_BLINK = 0.35
-- Slow dim. Above zero so the car does not go dark.
Constants.HOLD_DIM = 0.55
Constants.HOLD_RECOVER = 1.2
-- While held, stare dwell needs are divided by this scale (2 = twice as fast).
Constants.HOLD_STARE_MULTIPLIER = 2
-- Existing catalog id, shown only during the Broadway hold, then cleared.
Constants.HOLD_TELL = "wrong_countdown"
Constants.HOLD_TELL_STOP = 8

-- Final stretch only. Linear, from full to this fraction. Not a flicker.
Constants.FINAL_DIM = 0.62

-- Published MeshPart budget. The importer's hard ceiling is about 21,000.
-- https://create.roblox.com/docs/art/modeling/specifications
Constants.MESH_TRIANGLE_LIMIT = 20000

-- How far a flag ray reaches, in metres. Long enough for one car of the
-- three-car consist (A / B / C) from inside that car.
Constants.FLAG_RANGE_M = 22

-- Polaroid (web STARTING_FILM / SHUTTER_COOLDOWN / SUS.visible).
Constants.POLAROID_STARTING_FILM = 8
Constants.POLAROID_MAX_FILM = 10
Constants.POLAROID_SHUTTER_COOLDOWN = 0.9
Constants.POLAROID_FLASH_WATCH_SUSPICION = 10
Constants.POLAROID_FLASH_GLANCE_CHANCE = 0.5
-- Sound bed volumes / playback (IDs live in Shared.Assets + place StringValues).
-- Classic rbxasset://sounds/* defaults were removed: Studio rejects many as
-- unapproved and spams Output. Empty place values → silent (no Failed to load).
Constants.SOUND_POLAROID_VOLUME = 0.4
-- Open-air trestle wind/rain bed (web audioEngine.setOpenAir).
Constants.SOUND_OPEN_AIR_MAX = 0.12
Constants.SOUND_OPEN_AIR_PLAYBACK = 0.55
Constants.SOUND_CHIME_VOLUME = 0.45
Constants.SOUND_DOOR_VOLUME = 0.35
Constants.SOUND_CLACK_VOLUME = 0.12
Constants.SOUND_RUMBLE_MIN = 0.02
Constants.SOUND_RUMBLE_MAX = 0.14
Constants.SOUND_RUMBLE_PLAYBACK = 0.35
-- Door scene (verified rbxassetid://9117093785, ~8.15s). Open 0–4.45;
-- close 4.45–end. Clips shorter than SCENE_MIN play full on either edge.
-- Dwell (~2.6s) must not cut the open scene; close starts a second instance.
Constants.SOUND_DOOR_OPEN_END = 4.45
Constants.SOUND_DOOR_SCENE_MIN_LENGTH = 6.0
Constants.SOUND_DOOR_EVP_START = 0.75
Constants.SOUND_DOOR_EVP_END = 1.10
-- Safety destroy for one-shots; door scenes use region lifetime instead.
Constants.SOUND_ONESHOT_MAX_LIFE = 8
-- Metres of travel between track clacks at top speed (client integrates speed).
Constants.CLACK_SPACING_M = 9

-- constants.ts V. Cruise speed in metres per second. The slice's accel, cruise
-- and brake times scale the distance; they do not change this speed.
Constants.TOP_SPEED_MPS = 14

-- View motion only. The car and the player do not move with the train.
-- Peak bob is 2.2 cm and roll stays under 1 degree, times speed/top speed,
-- so a stop is still and cruise stays inside comfort limits.
Constants.BOB_Y_M = 0.022
Constants.BOB_X_M = 0.01
Constants.ROLL_DEG = 0.7
Constants.PITCH_DEG = 0.4

-- Web point light: 0xfff0d4, intensity 0.55, distance 9.5 m, decay 1.6
-- (subwayCarBuilder.setupLighting, gameState.applyLighting). Roblox's light
-- units are hotter, and 9.5 m of range washed the whole car in the playtest.
-- The shorter range is the decay: a pool under each lamp, ends in shadow.
Constants.LAMP_BRIGHTNESS = 0.48
Constants.LAMP_RANGE_M = 4.2

Constants.COLOR = {
	-- Web wall 0xc9ccc4, ceiling 0xe6e4db. Those hexes are the paint under
	-- three.js Lambert. On Roblox SmoothPlastic they read as white, so the
	-- value is pulled down and the hue is kept (sage gray, warm ceiling).
	wall = Color3.fromRGB(86, 90, 82),
	lowWall = Color3.fromRGB(62, 66, 62),
	seatOrange = Color3.fromRGB(176, 90, 28),
	seatYellow = Color3.fromRGB(184, 122, 38),
	underSeat = Color3.fromRGB(42, 44, 46),
	door = Color3.fromRGB(96, 100, 96),
	steel = Color3.fromRGB(118, 120, 122),
	ceiling = Color3.fromRGB(78, 76, 68),
	floor = Color3.fromRGB(32, 32, 30),
	glass = Color3.fromRGB(70, 92, 86),
	dark = Color3.fromRGB(6, 8, 9),
	-- Tube body. Not 0xfff4de: Neon at that hex is a white bar. The point
	-- light carries 0xfff0d4; the strip is the dimmer fixture around it.
	lightOn = Color3.fromRGB(150, 128, 88),
	lightOff = Color3.fromRGB(12, 10, 8),
	lamp = Color3.fromRGB(255, 240, 212),
	gLine = Color3.fromRGB(108, 190, 69),
	warn = Color3.fromRGB(227, 168, 58),
	cream = Color3.fromRGB(243, 239, 226),
	ink = Color3.fromRGB(12, 10, 8),
	paBg = Color3.fromRGB(18, 13, 5),
}

function Constants.meters(metres: number): number
	return metres * Constants.STUDS_PER_METER
end

return Constants
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Dialogue</string>
          <string name="Source"><![CDATA[--!strict
-- Parent chats and mask lines from src/constants.ts (CHATS, CALM_CHATS,
-- MASK_DIALOGUES). Critical glitch UI (PARANOID_UI_WORDS) stays out; critical
-- mask lines still appear as plain copy when the band is hunted.

local Dialogue = {}

export type ChatLine = { who: number, line: string }
export type ChatExchange = { ChatLine }

export type MaskLine = {
	who: number,
	line: string,
	calm: string,
	off: { string },
	needsSus: boolean,
}

-- who: 0 Mom, 1 Dad. Indices match web SEGS.chat.
local CHATS: { ChatExchange } = {
	{
		{ who = 1, line = "Did you ever call your sister back?" },
		{ who = 0, line = "Tonight. Remind me." },
	},
	{
		{ who = 0, line = "Your cousin’s gonna be so tall now." },
		{ who = 1, line = "Everybody’s tall now." },
	},
	{
		{ who = 1, line = "We should’ve taken the bus." },
		{ who = 0, line = "The bus takes forever." },
	},
	{
		{ who = 0, line = "Did you ever call your sister back?" },
		{ who = 1, line = "Did you ever call your sister back?" },
	},
	{
		{ who = 1, line = "Is it always this empty?" },
		{ who = 0, line = "It’s always this empty." },
	},
}

local CALM_CHATS: { ChatExchange } = {
	{
		{ who = 0, line = "Don’t lean against the doors." },
		{ who = 1, line = "Should be in Queens in twenty minutes." },
	},
	{
		{ who = 0, line = "Did they change the schedule?" },
		{ who = 1, line = "It feels slower today." },
	},
	{
		{ who = 0, line = "I always hated this curve." },
		{ who = 1, line = "Check your bag." },
	},
}

-- Tier 0: High / Calm. needsSus lines need Suspicion >= MASK_NEED_SUSPICION.
local MASK_TIER0: { MaskLine } = {
	{
		who = 0,
		line = "You've been quiet. You okay, hon?",
		calm = "Yeah, just tired.",
		off = { "Why? Do I look weird?", "Did the lights just change?" },
		needsSus = false,
	},
	{
		who = 1,
		line = "How many more stops, you think?",
		calm = "A few. We’re fine.",
		off = { "Why are you asking me?", "Wait, which train is this?" },
		needsSus = false,
	},
	{
		who = 0,
		line = "Did you eat anything today?",
		calm = "Had a bagel earlier.",
		off = { "Why does everyone keep asking that?", "Sorry, what?" },
		needsSus = false,
	},
	{
		who = 0,
		line = "You look warm. Are you warm?",
		calm = "Just stuffy in here.",
		off = { "Is it hot to you?", "Stop looking at me like that." },
		needsSus = false,
	},
	{
		who = 1,
		line = "You’re staring at something.",
		calm = "Just zoning out.",
		off = { "No I’m not.", "Don’t you see it?" },
		needsSus = true,
	},
	{
		who = 0,
		line = "Did you drop something on the floor?",
		calm = "No, just adjusting my bag.",
		off = { "Why are you staring?", "Leave me alone." },
		needsSus = false,
	},
	{
		who = 1,
		line = "You want the window seat?",
		calm = "Nah, I’m good here.",
		off = { "Why, what’s out there?", "Don’t make me move." },
		needsSus = false,
	},
	{
		who = 0,
		line = "Text your aunt we’re on the train.",
		calm = "Sending it now.",
		off = { "There’s no signal down here.", "Which train do I tell her?" },
		needsSus = false,
	},
}

-- Tier 1: Uneasy / Watched set (web Medium/Low).
local MASK_TIER1: { MaskLine } = {
	{
		who = 1,
		line = "You’d tell us if something was wrong, right?",
		calm = "Of course.",
		off = { "Would you tell me?", "Define wrong." },
		needsSus = false,
	},
	{
		who = 0,
		line = "Why do you keep looking over there?",
		calm = "Thought I saw someone I knew.",
		off = { "You saw it too?", "Over where?" },
		needsSus = false,
	},
	{
		who = 1,
		line = "You’re staring at something.",
		calm = "Just zoning out.",
		off = { "No I’m not.", "Don’t you see it?" },
		needsSus = true,
	},
	{
		who = 0,
		line = "You’re holding that pole awfully tight.",
		calm = "Train’s bumpy tonight.",
		off = { "Because it keeps moving.", "Don’t let go of yours." },
		needsSus = false,
	},
	{
		who = 1,
		line = "You didn’t say a word that whole stop.",
		calm = "Just tired, Dad.",
		off = { "Was it a stop?", "Nobody got on." },
		needsSus = false,
	},
	{
		who = 0,
		line = "Is your stomach bothering you again?",
		calm = "A little. It’ll pass.",
		off = { "It’s not my stomach.", "Can you feel that too?" },
		needsSus = false,
	},
	{
		who = 1,
		line = "Put your phone away and talk to us.",
		calm = "Okay, okay. It’s away.",
		off = { "It stopped showing the time.", "About what?" },
		needsSus = false,
	},
	{
		who = 0,
		line = "You’re counting the stops again, aren’t you?",
		calm = "Habit. Sorry.",
		off = { "Someone has to.", "We passed this one already." },
		needsSus = false,
	},
}

-- Tier 2: Hunted / Critical set (plain copy; no glitch overlay).
local MASK_TIER2: { MaskLine } = {
	{
		who = 0,
		line = "You can see it too, can’t you?",
		calm = "See what?",
		off = { "Yes.", "Don’t." },
		needsSus = false,
	},
	{
		who = 1,
		line = "We’re not getting off. You know that.",
		calm = "I know.",
		off = { "Why would you say that?", "Who said we were?" },
		needsSus = false,
	},
	{
		who = 0,
		line = "Who are you looking for?",
		calm = "Nobody. Just looking.",
		off = { "The people who were here.", "You." },
		needsSus = false,
	},
	{
		who = 1,
		line = "Sit still. They notice when you fidget.",
		calm = "Okay. Sitting still.",
		off = { "Who notices?", "You noticed." },
		needsSus = false,
	},
	{
		who = 0,
		line = "We’ve always taken this train, sweetie.",
		calm = "Right. I know.",
		off = { "Since when?", "There’s no always down here." },
		needsSus = false,
	},
	{
		who = 1,
		line = "Don’t look at the windows. Look at me.",
		calm = "I’m looking at you.",
		off = { "What’s in the windows?", "Your face is wrong." },
		needsSus = false,
	},
	{
		who = 0,
		line = "Smile for me, hon. Like you used to.",
		calm = "Like this?",
		off = { "I don’t remember how.", "You first." },
		needsSus = false,
	},
	{
		who = 1,
		line = "Nobody gets off at this one. Remember?",
		calm = "I remember.",
		off = { "Then why do the doors open?", "Who told you that?" },
		needsSus = false,
	},
}

-- Soft hunted overlays on ordinary chats (band-tuned parent lines).
local HUNTED_CHATS: { ChatExchange } = {
	{
		{ who = 0, line = "Keep your eyes on us." },
		{ who = 1, line = "Don’t make a scene." },
	},
	{
		{ who = 1, line = "They’re watching how you sit." },
		{ who = 0, line = "Look at me. Only me." },
	},
}

function Dialogue.parentName(who: number): string
	if who == 1 then
		return "Dad"
	end
	return "Mom"
end

function Dialogue.chatLine(who: number, line: string): string
	return Dialogue.parentName(who) .. ": " .. line
end

function Dialogue.maskPrompt(who: number, line: string): string
	return Dialogue.parentName(who) .. ": " .. line
end

function Dialogue.youAnswer(text: string, parentWho: number): string
	return "You: " .. text .. " (" .. Dialogue.parentName(parentWho) .. " nods.)"
end

function Dialogue.maskHesitate(parentWho: number): string
	return "You don’t answer fast enough. " .. Dialogue.parentName(parentWho) .. ": Hon?"
end

function Dialogue.maskOdd(parentWho: number): string
	return Dialogue.parentName(parentWho) .. " keeps looking at you."
end

-- Swap some of chat indices 0–2 for calm small talk (web chatSwap).
function Dialogue.buildChatPlan(rng: () -> number): { [number]: ChatExchange }
	local plan: { [number]: ChatExchange } = {}
	local extras = table.clone(CALM_CHATS)
	for i = 0, 2 do
		if #extras > 0 and rng() < 0.5 then
			local index = math.clamp(math.floor(rng() * #extras) + 1, 1, #extras)
			plan[i] = extras[index]
			table.remove(extras, index)
		else
			plan[i] = CHATS[i + 1]
		end
	end
	for i = 3, #CHATS - 1 do
		plan[i] = CHATS[i + 1]
	end
	return plan
end

function Dialogue.chatFor(plan: { [number]: ChatExchange }, chatIndex: number): ChatExchange?
	return plan[chatIndex]
end

local function filterNeeds(tier: { MaskLine }, suspicion: number, needSusAt: number): { MaskLine }
	local pool = {}
	for _, entry in tier do
		if not entry.needsSus or suspicion >= needSusAt then
			table.insert(pool, entry)
		end
	end
	return pool
end

function Dialogue.maskPool(suspicion: number, needSusAt: number): { MaskLine }
	return filterNeeds(MASK_TIER0, suspicion, needSusAt)
end

-- Band picks the mask tier (calm→0, uneasy/watched→1, hunted→2).
function Dialogue.maskPoolForBand(band: string, suspicion: number, needSusAt: number): { MaskLine }
	if band == "hunted" then
		return filterNeeds(MASK_TIER2, suspicion, needSusAt)
	end
	if band == "uneasy" or band == "watched" then
		return filterNeeds(MASK_TIER1, suspicion, needSusAt)
	end
	return filterNeeds(MASK_TIER0, suspicion, needSusAt)
end

function Dialogue.huntedChat(rng: () -> number): ChatExchange
	local index = math.clamp(math.floor(rng() * #HUNTED_CHATS) + 1, 1, #HUNTED_CHATS)
	return HUNTED_CHATS[index]
end

function Dialogue.pickMask(
	pool: { MaskLine },
	used: { [string]: boolean },
	lastLine: string?,
	rng: () -> number
): MaskLine?
	if #pool == 0 then
		return nil
	end
	local fresh = {}
	for _, entry in pool do
		if used[entry.line] ~= true then
			table.insert(fresh, entry)
		end
	end
	if #fresh == 0 then
		table.clear(used)
		fresh = table.clone(pool)
	end
	local candidates = {}
	for _, entry in fresh do
		if entry.line ~= lastLine then
			table.insert(candidates, entry)
		end
	end
	if #candidates == 0 then
		candidates = fresh
	end
	local index = math.clamp(math.floor(rng() * #candidates) + 1, 1, #candidates)
	return candidates[index]
end

function Dialogue.shuffleAnswers(calm: string, offA: string, offB: string, rng: () -> number): { { text: string, val: string } }
	local items = {
		{ text = calm, val = "calm" },
		{ text = offA, val = "off" },
		{ text = offB, val = "off" },
	}
	for i = #items, 2, -1 do
		local j = math.clamp(math.floor(rng() * i) + 1, 1, i)
		items[i], items[j] = items[j], items[i]
	end
	return items
end

return Dialogue
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DoorSound</string>
          <string name="Source"><![CDATA[--!strict
-- Door clip windows for the sound bed (client Audio plays the regions).
-- Verified Studio scene rbxassetid://9117093785 (~8.15s): open 0–4.45,
-- close 4.45–end. Short latch clips (< SCENE_MIN) play start→end on either edge.

local Constants = require(script.Parent.Constants)

local DoorSound = {}

-- (startTime, endTime) in seconds on the asset timeline.
function DoorSound.edgeWindow(length: number, opening: boolean): (number, number)
	if length <= 0 then
		return 0, 0
	end
	if length < Constants.SOUND_DOOR_SCENE_MIN_LENGTH then
		return 0, length
	end
	local split = math.min(Constants.SOUND_DOOR_OPEN_END, length)
	if opening then
		return 0, split
	end
	return split, length
end

-- EVP raise click: attack slice only (0.75–1.10 on the long scene).
function DoorSound.evpAttackWindow(length: number): (number, number)
	if length <= 0 then
		return 0, 0
	end
	local startAt = math.min(Constants.SOUND_DOOR_EVP_START, length)
	local endAt = math.min(Constants.SOUND_DOOR_EVP_END, length)
	if endAt <= startAt then
		return 0, length
	end
	return startAt, endAt
end

return DoorSound
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Doors</string>
          <string name="Source"><![CDATA[--!strict
-- Stay / step-off outcomes. Mirrors web resolveDoors (gameState.ts).
-- Haven runs Shared.Haven + Ride.executeHaven.
-- Non-forgiving false step-off runs Shared.Trial + TrialSpace.

local Doors = {}

export type Choice = "stay" | "off"
export type StopKind = "real" | "false" | "haven"

export type Outcome = {
	choice: Choice,
	correct: boolean,
	suspicionDelta: number,
	-- "depart" continues the ride. "haven" runs the platform linger.
	-- "trial" runs the False Stop Trial room.
	mode: "depart" | "haven" | "trial",
	line: string,
	holdSeconds: number,
}

export type Amounts = {
	realOff: number,
	refuseHaven: number,
	falseOff: number,
}

function Doors.normalize(choice: string?): Choice
	if choice == "off" then
		return "off"
	end
	return "stay"
end

-- kind/forgiving come from Route. line* are the spoken/subtitle strings.
function Doors.resolve(
	kind: StopKind,
	forgiving: boolean,
	rawChoice: string?,
	amounts: Amounts,
	lineRealOff: string,
	lineRefuseHaven: string,
	lineFalseForgiving: string,
	_lineHavenUnused: string,
	_lineTrialUnused: string
): Outcome
	local choice = Doors.normalize(rawChoice)
	if kind == "real" then
		if choice == "off" then
			return {
				choice = choice,
				correct = false,
				suspicionDelta = amounts.realOff,
				mode = "depart",
				line = lineRealOff,
				holdSeconds = 3.2,
			}
		end
		return {
			choice = choice,
			correct = true,
			suspicionDelta = 0,
			mode = "depart",
			line = "",
			holdSeconds = 0,
		}
	end
	if kind == "haven" then
		if choice == "off" then
			-- Ride runs the Safe Haven linger; holdSeconds stays 0 here.
			return {
				choice = choice,
				correct = true,
				suspicionDelta = 0,
				mode = "haven",
				line = "",
				holdSeconds = 0,
			}
		end
		return {
			choice = choice,
			correct = false,
			suspicionDelta = amounts.refuseHaven,
			mode = "depart",
			line = lineRefuseHaven,
			holdSeconds = 3.2,
		}
	end
	-- False stop.
	if choice == "stay" then
		return {
			choice = choice,
			correct = true,
			suspicionDelta = 0,
			mode = "depart",
			line = "",
			holdSeconds = 0,
		}
	end
	if forgiving then
		return {
			choice = choice,
			correct = false,
			suspicionDelta = amounts.falseOff,
			mode = "depart",
			line = lineFalseForgiving,
			holdSeconds = 3.8,
		}
	end
	-- Non-forgiving: enter the False Stop Trial. Suspicion applies on exit.
	return {
		choice = choice,
		correct = false,
		suspicionDelta = 0,
		mode = "trial",
		line = "",
		holdSeconds = 0,
	}
end

return Doors
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Dwell</string>
          <string name="Source"><![CDATA[--!strict
-- Minimum-dwell math. The server owns the clock and whether anyone asked
-- to leave early. This module only updates the suspicion number.
-- The result stays in range. It does not end the ride.

local Dwell = {}

-- When the train may leave. lieHold is the existing PA-lie wait from
-- arrival, or nil when that stop has no lie. The result is never earlier
-- than openAt + minimum.
function Dwell.departTime(openAt: number, minimum: number, lieHold: number?): number
	local departAt = openAt + minimum
	if lieHold ~= nil then
		return math.max(departAt, lieHold)
	end
	return departAt
end

function Dwell.departureSuspicion(
	current: number,
	elapsed: number,
	minimum: number,
	requestedEarly: boolean,
	penalty: number,
	least: number,
	most: number
): number
	local nextValue = current
	if requestedEarly and elapsed < minimum then
		nextValue += penalty
	end
	return math.clamp(nextValue, least, most)
end

return Dwell
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Endings</string>
          <string name="Source"><![CDATA[--!strict
-- Court Square endings from src/game/endings.ts. resolveEnding is pure:
-- first match in priority order wins. The exit only picks which earned
-- ending you walk into; the menu never says what's open.

local Endings = {}

export type EndingId =
	"secret_mask"
	| "eternal_commute"
	| "signal_archivist"
	| "skyward_void"
	| "dawn_horizon"
	| "exposed"
	| "collapse"
	| "civilian_extraction"

export type ExitChoice = "escalators" | "lower_level" | "surface_hatch"

export type EndingDefinition = {
	id: EndingId,
	priority: number,
	title: string,
	badge: string,
	narrative: string,
	summary: string,
}

export type EndingSummary = {
	peak: number,
	interventions: number,
	trialStops: { number },
	sanPct: number,
	accPct: number,
	restraintOK: boolean,
	tapes: { string },
	exit: ExitChoice,
}

-- Half of INTERVENE_SUSPICION (60). Quieter endings need peak ≤ this.
Endings.COMPOSED_PEAK = 30
Endings.BAIT_STOP = 12

local function fill(text: string): string
	return (
		text:gsub("{terminus}", "Court Square")
			:gsub("{terminusSign}", "Court Sq")
			:gsub("{origin}", "Hoyt–Schermerhorn")
			:gsub("{bait}", "21 St")
			:gsub("{street}", "Jackson Ave")
			:gsub("{area}", "Long Island City")
			:gsub("{line}", "G")
	)
end

local ENDINGS: { [EndingId]: EndingDefinition } = {
	secret_mask = {
		id = "secret_mask",
		priority = 1,
		title = "The Unbroken Mask",
		badge = "[SECRET: THE UNBROKEN MASK]",
		narrative = fill(
			'At {terminus}, Mom takes your hand on the escalator. "You can stop pretending now," she says, not looking at you. "We saw it too."'
		),
		summary = "The whole ride without a single visible reaction (peak Suspicion 0).",
	},
	eternal_commute = {
		id = "eternal_commute",
		priority = 2,
		title = "The Eternal Commute",
		badge = "[LOOP: THE ETERNAL COMMUTE]",
		narrative = fill(
			'The doors open. The sign says {origin}. Mom stands up and smooths her coat. "This is us," she says.'
		),
		summary = fill("Stepped off at {bait}, or let too much of yourself slip away (Sanity Retained under 30%)."),
	},
	signal_archivist = {
		id = "signal_archivist",
		priority = 3,
		title = "Midnight Terminal",
		badge = "[BRANCH: SIGNAL ARCHIVIST]",
		narrative = fill(
			"You descend past the rusted chain-link gate into {terminus}'s abandoned lower level. The microcassette recorder crackles to life on its own in the damp darkness. A calm dispatcher voice speaks through the hiss: \"Track 4 clear. All units hold position.\" The loop is broken."
		),
		summary = "Followed the static down the side stairs, with tapes in hand, most anomalies caught, and your composure intact.",
	},
	skyward_void = {
		id = "skyward_void",
		priority = 4,
		title = "Skyward Catwalk",
		badge = "[BRANCH: SKYWARD VOID]",
		narrative = "You break away through the emergency door and climb until there is open air. Below you, the sodium lights of the city glow in eerie silence, completely empty. Behind you, the train rumbles into the dark tunnel—its cars completely hollow.",
		summary = "Pushed through the emergency door after holding firm through the restraint, without a single False Stop or intervention.",
	},
	dawn_horizon = {
		id = "dawn_horizon",
		priority = 5,
		title = "Dawn Horizon",
		badge = "[BRANCH: DAWN HORIZON]",
		narrative = fill(
			"The doors open at {terminus} onto daylight that shouldn't reach this platform. Dad squints and says nothing. For once, neither do you."
		),
		summary = "Stayed with your parents after holding firm through the restraint, with the conductor on tape and most of yourself intact.",
	},
	exposed = {
		id = "exposed",
		priority = 6,
		title = "Exposed",
		badge = "[TERMINAL: EXPOSED]",
		narrative = fill(
			"You made it to {terminus}. Dad keeps a firm, unyielding grip on your shoulder all the way up the stairs into the street. Nobody says a single word."
		),
		summary = "Your parents stepped in.",
	},
	collapse = {
		id = "collapse",
		priority = 7,
		title = "Disoriented Collapse",
		badge = "[COLLAPSE: DISORIENTED]",
		narrative = fill(
			"You made it to {terminus}. Mom doesn't let go of your sleeve until you're outside on {street}. You have no memory of the last three stops."
		),
		summary = "Stepped off at a False Stop.",
	},
	civilian_extraction = {
		id = "civilian_extraction",
		priority = 8,
		title = "Civilian Extraction",
		badge = "[STANDARD: EXTRACTION]",
		narrative = fill(
			"You made it to {terminus}. Your parents push through the turnstiles, already arguing about where to eat in {area}."
		),
		summary = "An ordinary arrival.",
	},
}

Endings.ENDINGS = ENDINGS

function Endings.definition(id: EndingId): EndingDefinition
	return ENDINGS[id]
end

function Endings.normalizeExit(value: string?): ExitChoice
	if value == "lower_level" or value == "surface_hatch" or value == "escalators" then
		return value
	end
	return "escalators"
end

function Endings.accuracyPercent(correct: number, miss: number): number
	local total = correct + miss
	if total <= 0 then
		return 100
	end
	return math.floor((100 * correct) / total + 0.5)
end

local function hasTrial(stops: { number }, stop: number): boolean
	for _, s in stops do
		if s == stop then
			return true
		end
	end
	return false
end

local function hasTape(tapes: { string }, id: string): boolean
	for _, t in tapes do
		if t == id then
			return true
		end
	end
	return false
end

function Endings.resolve(s: EndingSummary): EndingDefinition
	local noTrials = #s.trialStops == 0
	if s.peak == 0 then
		return ENDINGS.secret_mask
	end
	if hasTrial(s.trialStops, Endings.BAIT_STOP) or s.sanPct < 30 then
		return ENDINGS.eternal_commute
	end
	if
		s.exit == "lower_level"
		and #s.tapes >= 2
		and s.accPct >= 75
		and s.peak <= Endings.COMPOSED_PEAK
	then
		return ENDINGS.signal_archivist
	end
	if s.exit == "surface_hatch" and s.restraintOK and noTrials and s.interventions == 0 then
		return ENDINGS.skyward_void
	end
	if
		s.exit == "escalators"
		and s.restraintOK
		and noTrials
		and hasTape(s.tapes, "conductor")
		and s.sanPct >= 60
	then
		return ENDINGS.dawn_horizon
	end
	if s.interventions > 0 then
		return ENDINGS.exposed
	end
	if not noTrials then
		return ENDINGS.collapse
	end
	return ENDINGS.civilian_extraction
end

function Endings.exitLine(choice: ExitChoice): string
	if choice == "lower_level" then
		return "You drift toward the side stairs. The hiss in your pocket gets louder."
	end
	if choice == "surface_hatch" then
		return "You lean on the emergency bar. Somewhere above, the air is moving."
	end
	return "You follow your parents toward the escalators."
end

return Endings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Evp</string>
          <string name="Source"><![CDATA[--!strict
-- Tape recorder / EVP from src/game/evpManager.ts.
-- Frequencies shuffle per ride; meter treats signals and decoys the same.
-- Case Files archive persistence stays out.

local Evp = {}

Evp.MIN_KHZ = 70
Evp.MAX_KHZ = 180
Evp.LOCK_KHZ = 1.0
Evp.METER_WIDTH = 4
Evp.RECORD_HOLD = 1.5
Evp.REVEAL_SECONDS = 3
Evp.DECOYS_PER_SEGMENT = 2
Evp.SIGNAL_GAP = 8
Evp.DECOY_GAP = 5
Evp.TAPE_GLANCE_CHANCE = 0.5

export type SignalDef = {
	id: string,
	title: string,
	stops: { number },
	transcript: string,
}

export type Carrier = {
	kind: "signal" | "decoy",
	khz: number,
	signalId: string?,
}

export type Tape = {
	signalId: string,
	title: string,
	stop: string,
	freq: string,
	transcript: string,
}

export type State = {
	raised: boolean,
	recording: boolean,
	khz: number,
	meter: number,
	lockedKind: string, -- "" | "signal" | "decoy"
	lockedId: string,
	reveal: number,
	recordT: number,
	tapes: { Tape },
	signalKhz: { [string]: number },
	decoyKhz: { [number]: { number } },
	heard: { [string]: number },
}

-- G-route copy with tokens already filled (fillRoute for the G).
local SIGNALS: { SignalDef } = {
	{
		id = "dispatch-hold",
		title = "Dispatch, track 2",
		stops = { 6, 7 },
		transcript = "…G four-forty, hold at Nassau. Hold. Do not open the doors at Nassau…",
	},
	{
		id = "passenger-hoyt",
		title = "A passenger",
		stops = { 7, 8, 9 },
		transcript = "…I got on at Hoyt too. I always get on at Hoyt. I always get on at Hoyt…",
	},
	{
		id = "dispatch-empty",
		title = "Dispatch, no train number",
		stops = { 9, 10 },
		transcript = "…there is no train scheduled on this track. Repeat: nothing is scheduled on this track…",
	},
	{
		id = "passenger-greenpoint",
		title = "Someone at the far end",
		stops = { 10, 11 },
		transcript = "…first time? It gets easier after Greenpoint. Don’t let them see you looking…",
	},
	{
		id = "warning-time",
		title = "Static, then a time",
		stops = { 11, 12 },
		transcript = "…6:52… 6:52 a.m.… it was 6:52 the last time, too…",
	},
	{
		id = "conductor",
		title = "The conductor",
		stops = { 12, 13 },
		transcript = "…this is your conductor. We are above ground. This train does not go above ground…",
	},
	{
		id = "mom-voice",
		title = "A voice like Mom’s",
		stops = { 12, 13 },
		transcript = "…honey, don’t look at the window. Look at me. Look at me…",
	},
	{
		id = "station-bedford",
		title = "Bedford–Nostrand dispatch static",
		stops = { 6, 7 },
		transcript = "…Dispatch 44 to all units on G… relay failure at Bedford–Nostrand. Unauthorized personnel on track bed… repeat: do not look at track bed…",
	},
	{
		id = "station-classon",
		title = "Classon Av phantom PA echo",
		stops = { 6, 7, 8 },
		transcript = "…Please stand clear of the closing doors… the train following this one does not exist… return to your seat immediately…",
	},
	{
		id = "station-flushing",
		title = "Flushing Av night wiretap",
		stops = { 7, 8, 9 },
		transcript = "…Station log 02:14. Platform empty, but footsteps continue down the south stairs. Someone is whistling the wrong chime…",
	},
	{
		id = "station-newtown",
		title = "Newtown Creek emergency channel",
		stops = { 10, 11, 12 },
		transcript = "…Maritime security channel 16. Bridge clearance confirmed. Unscheduled train visible on upper trestle. Who authorized that train…",
	},
}

Evp.SIGNALS = SIGNALS

function Evp.signalById(id: string): SignalDef?
	for _, sig in SIGNALS do
		if sig.id == id then
			return sig
		end
	end
	return nil
end

local function share(a: SignalDef, b: SignalDef): boolean
	for _, stop in a.stops do
		for _, other in b.stops do
			if stop == other then
				return true
			end
		end
	end
	return false
end

function Evp.newState(rng: () -> number): State
	local state: State = {
		raised = false,
		recording = false,
		khz = 120,
		meter = 0,
		lockedKind = "",
		lockedId = "",
		reveal = 0,
		recordT = 0,
		tapes = {},
		signalKhz = {},
		decoyKhz = {},
		heard = {},
	}

	local function rnd(): number
		return math.round((Evp.MIN_KHZ + 4 + rng() * (Evp.MAX_KHZ - Evp.MIN_KHZ - 8)) * 10) / 10
	end

	local function pick(minGap: number, against: { number }): number?
		for _ = 1, 300 do
			local f = rnd()
			local ok = true
			for _, o in against do
				if math.abs(o - f) < minGap then
					ok = false
					break
				end
			end
			if ok then
				return f
			end
		end
		return nil
	end

	local function layout(): boolean
		state.signalKhz = {}
		local order = table.clone(SIGNALS)
		table.sort(order, function(a, b)
			local ca, cb = 0, 0
			for _, x in SIGNALS do
				if share(x, a) then
					ca += 1
				end
				if share(x, b) then
					cb += 1
				end
			end
			return cb < ca
		end)
		for _, sig in order do
			local against = {}
			for _, o in order do
				if o ~= sig and state.signalKhz[o.id] ~= nil and share(o, sig) then
					table.insert(against, state.signalKhz[o.id])
				end
			end
			local f = pick(Evp.SIGNAL_GAP, against)
			if f == nil then
				return false
			end
			state.signalKhz[sig.id] = f
		end
		state.decoyKhz = {}
		for stop = 6, 13 do
			local near = {}
			for _, sig in SIGNALS do
				for _, s in sig.stops do
					if s == stop then
						table.insert(near, state.signalKhz[sig.id])
						break
					end
				end
			end
			local ds = {}
			for _ = 1, Evp.DECOYS_PER_SEGMENT do
				local against = table.clone(near)
				for _, d in ds do
					table.insert(against, d)
				end
				local f = pick(Evp.DECOY_GAP, against)
				if f == nil then
					return false
				end
				table.insert(ds, f)
			end
			state.decoyKhz[stop] = ds
		end
		return true
	end

	for _ = 1, 50 do
		if layout() then
			break
		end
	end
	return state
end

function Evp.carriers(state: State, stop: number?): { Carrier }
	if stop == nil then
		return {}
	end
	local out: { Carrier } = {}
	for _, sig in SIGNALS do
		for _, s in sig.stops do
			if s == stop then
				table.insert(out, {
					kind = "signal",
					khz = state.signalKhz[sig.id] or 0,
					signalId = sig.id,
				})
				break
			end
		end
	end
	for _, f in state.decoyKhz[stop] or {} do
		table.insert(out, { kind = "decoy", khz = f, signalId = nil })
	end
	return out
end

function Evp.setKhz(state: State, khz: number)
	local v = math.round(khz * 10) / 10
	state.khz = math.clamp(v, Evp.MIN_KHZ, Evp.MAX_KHZ)
end

function Evp.tune(state: State, delta: number)
	Evp.setKhz(state, state.khz + delta)
end

function Evp.raise(state: State): boolean
	if state.raised then
		return false
	end
	state.raised = true
	return true
end

function Evp.lower(state: State)
	state.raised = false
	state.recording = false
	state.recordT = 0
	state.lockedKind = ""
	state.lockedId = ""
	state.meter = 0
	state.reveal = 0
end

function Evp.setRecording(state: State, on: boolean)
	local nextOn = on and state.raised
	if nextOn == state.recording then
		return
	end
	state.recording = nextOn
	if not nextOn then
		state.recordT = 0
	end
end

function Evp.hasTape(state: State, signalId: string): boolean
	for _, tape in state.tapes do
		if tape.signalId == signalId then
			return true
		end
	end
	return false
end

-- Returns a new tape when one is saved this frame; otherwise nil.
function Evp.update(state: State, dt: number, stop: number?, stopLabel: string): Tape?
	if not state.raised then
		state.meter = 0
		state.lockedKind = ""
		state.lockedId = ""
		state.reveal = 0
		return nil
	end
	local cs = Evp.carriers(state, stop)
	local best: Carrier? = nil
	local bestD = math.huge
	for _, c in cs do
		local d = math.abs(c.khz - state.khz)
		if d < bestD then
			bestD = d
			best = c
		end
	end
	state.meter = if best then math.exp(-((bestD / Evp.METER_WIDTH) ^ 2)) else 0
	if best and bestD <= Evp.LOCK_KHZ then
		state.lockedKind = best.kind
		state.lockedId = best.signalId or ""
	else
		state.lockedKind = ""
		state.lockedId = ""
	end

	local sig = if state.lockedKind == "signal" then Evp.signalById(state.lockedId) else nil
	if sig ~= nil then
		state.heard[sig.id] = math.min(1, (state.heard[sig.id] or 0) + dt / Evp.REVEAL_SECONDS)
		state.reveal = state.heard[sig.id]
	else
		state.reveal = 0
	end

	if state.recording and sig ~= nil and not Evp.hasTape(state, sig.id) then
		state.recordT += dt
		if state.recordT >= Evp.RECORD_HOLD then
			state.recordT = 0
			local tape: Tape = {
				signalId = sig.id,
				title = sig.title,
				stop = stopLabel,
				freq = string.format("%.1f kHz", state.khz),
				transcript = sig.transcript,
			}
			table.insert(state.tapes, tape)
			return tape
		end
	else
		state.recordT = 0
	end
	return nil
end

function Evp.tapesJson(state: State): string
	-- Compact hand-rolled JSON for the HUD (no HttpService dependency in specs).
	local parts = {}
	for _, tape in state.tapes do
		local entry = string.format(
			'{"signalId":%q,"title":%q,"stop":%q,"freq":%q,"transcript":%q}',
			tape.signalId,
			tape.title,
			tape.stop,
			tape.freq,
			tape.transcript
		)
		table.insert(parts, entry)
	end
	return "[" .. table.concat(parts, ",") .. "]"
end

function Evp.statusLine(state: State, riding: boolean): string
	if state.lockedKind == "signal" then
		local sig = Evp.signalById(state.lockedId)
		if sig ~= nil then
			local n = math.max(1, math.round(#sig.transcript * state.reveal))
			return string.sub(sig.transcript, 1, n)
		end
	end
	if state.lockedKind == "decoy" then
		return "— a carrier tone, no voice —"
	end
	if state.recording then
		return "Recording hiss…"
	end
	if riding then
		return "Tune slowly. Something is out there."
	end
	return "Nothing comes through at a standstill."
end

return Evp
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Haven</string>
          <string name="Source"><![CDATA[--!strict
-- Safe Haven helpers from gameState.executeSafeHaven / giveRecorder.
-- Unlocks HasRecorder for the EVP UI (PR8) and restores sanity.

local Haven = {}

-- Relative to haven phase start (doors already open, player stepped off).
Haven.MOM_STAND_AT = 0.8
Haven.DAD_STOPS_AT = 3.5
Haven.RECORDER_AT = 6.4
Haven.SANITY_AT = 10.4
Haven.BOARD_AT = 10.4
Haven.DEPART_AT = 11.4

-- Seconds before stretch end for Mom's "stretch our legs" cue (calm tier).
Haven.APPROACH_LEAD = 6.5

-- Train handoff if the player refused the platform (web startSegment).
Haven.TRAIN_HANDOFF_AT = 6.0

function Haven.shouldTrainHandoff(hasRecorder: boolean, stop: number, b: boolean): boolean
	if hasRecorder then
		return false
	end
	return stop > 6 or (stop == 6 and b)
end

function Haven.restoreSanity(current: number, amount: number, minValue: number, maxValue: number): number
	return math.clamp(current + amount, minValue, maxValue)
end

return Haven
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Hold</string>
          <string name="Source"><![CDATA[--!strict
-- Held At Signal. The server pauses the tunnel between stations.
-- A hold may blink one strip or dim the car slowly. It never blacks
-- the whole car out. That remains the flicker tick.

local Hold = {}

function Hold.applies(stop: number, b: boolean, final: boolean, first: number, second: number): boolean
	if b or final then
		return false
	end
	return stop == first or stop == second
end

-- The pause must start while the train is already in the tunnel: after
-- accel, before braking. A pause at the platform or on the way into a
-- station is not a hold.
function Hold.placed(holdAt: number, holdFor: number, accel: number, cruise: number): boolean
	if holdFor <= 0 or cruise <= 0 then
		return false
	end
	return holdAt >= accel and holdAt < accel + cruise
end

-- Motion clock. Wall time keeps moving. Travel time does not, for holdFor
-- seconds starting at holdAt.
function Hold.motionTime(elapsed: number, holdAt: number, holdFor: number): number
	local t = math.max(0, elapsed)
	if holdFor <= 0 then
		return t
	end
	if t <= holdAt then
		return t
	end
	if t < holdAt + holdFor then
		return holdAt
	end
	return t - holdFor
end

function Hold.moving(elapsed: number, holdAt: number, holdFor: number): boolean
	if holdFor <= 0 then
		return true
	end
	return elapsed < holdAt or elapsed >= holdAt + holdFor
end

function Hold.wallDuration(segmentLength: number, held: boolean, holdFor: number): number
	if held and holdFor > 0 then
		return segmentLength + holdFor
	end
	return segmentLength
end

-- "blackout" is the door tick. A hold cannot select it.
function Hold.blacksOutCar(effect: string): boolean
	return effect == "blackout" or effect == "whole_car"
end

function Hold.plan(effect: string): string
	if effect == "dim" then
		return "dim"
	end
	return "strip"
end

-- A hold dim stays above off. Zero would be a blackout.
function Hold.dimTarget(fraction: number): number
	if fraction <= 0 then
		return 0.55
	end
	return math.clamp(fraction, 0.05, 1)
end

-- Caught-staring is not in this port. The number is what that check would
-- multiply by while the train is held. Nothing here looks at the player.
function Hold.stareScale(held: boolean, multiplier: number): number
	if held then
		return multiplier
	end
	return 1
end

-- Only an id the anomaly catalog already has. Anything else is dropped.
function Hold.tell(kind: string): string?
	if kind == "poster_changed" or kind == "wrong_announcement" or kind == "wrong_countdown" then
		return kind
	end
	return nil
end

return Hold
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">KeepOut</string>
          <string name="Source"><![CDATA[--!strict
-- Port of src/game/personKeepOut.ts. Standing passengers occupy a circle on
-- the floor. The eye (here, the HumanoidRootPart centre) is pushed to the
-- edge of any circle it lands inside. Seated passengers are not in the list;
-- the benches keep the player off those spots.

local Constants = require(script.Parent.Constants)

local KeepOut = {}

export type Circle = {
	x: number,
	z: number,
	r: number,
}

function KeepOut.radiusStuds(): number
	return Constants.meters(Constants.KEEP_OUT_METERS)
end

-- Solid cylinder radius. Smaller than the eye radius by half the root width,
-- so a default character's centre stops on the 0.75 m circle.
function KeepOut.cylinderRadiusStuds(): number
	local radius = KeepOut.radiusStuds() - Constants.ROOT_HALF_WIDTH_STUDS
	return math.max(0.4, radius)
end

function KeepOut.pushOut(x: number, z: number, circles: { Circle }, prevX: number, prevZ: number): (number, number)
	for _, c in circles do
		local dx = x - c.x
		local dz = z - c.z
		local d = math.sqrt(dx * dx + dz * dz)
		if d < c.r then
			if d < 1e-6 then
				dx = prevX - c.x
				dz = prevZ - c.z
				local pd = math.sqrt(dx * dx + dz * dz)
				if pd < 1e-6 then
					dx = 0
					dz = if c.z > 0 then -1 else 1
				else
					dx /= pd
					dz /= pd
				end
			else
				dx /= d
				dz /= d
			end
			x = c.x + dx * c.r
			z = c.z + dz * c.r
		end
	end
	return x, z
end

return KeepOut
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Lines</string>
          <string name="Source"><![CDATA[--!strict
-- On-screen strings copied from the web game, plus the dwell banner,
-- the minute board, tell labels, door choice, and Safe Haven lines.
-- The dwell banner and the board are labels and numbers.
-- Sources: src/constants.ts (STOPS, the Stop 9 paLie), src/game/gameState.ts
-- (PA, boarding, the Court Sq line), src/components/HUD.tsx ("Next:"),
-- src/components/ReportScreen.tsx (Caught / Missed / false flag).

local Lines = {}

-- fillRoute('This is the Last Local. {terminus}–bound {line} train.') on the G.
Lines.INTRO_PA = "This is the Last Local. Court Square–bound G train."

-- departNext() and the boarding close.
Lines.STAND_CLEAR = "Stand clear of the closing doors, please."

-- fillRoute('{terminus}. This is the last stop on this train.')
Lines.LAST_PA = "Court Square. This is the last stop on this train."

-- SEGS stop 9, paLie. The conductor says this instead of "This is Metropolitan Av."
Lines.PA_LIE = "This is Court Square. Last stop. Everybody off the train."

-- say(1, ...) during boarding. The subtitle is "Dad: " plus the line.
Lines.DAD_BOARD = "Dad: Grab a seat. It’s a long one."

-- say(0, fillRoute('Here we are. {terminus}.'))
Lines.MOM_ARRIVE = "Mom: Here we are. Court Square."

-- The first-ride hint (keyboard).
Lines.HINT = "Move the mouse to look. Hold F while looking at anything that changes."

-- Report words. A correct flag and a miss use these alone.
Lines.CAUGHT = "Caught"
Lines.MISSED = "Missed"
Lines.FALSE_FLAG = "False flag"
Lines.CLEAN = "Clean"

-- HUD station card.
Lines.NEXT_LABEL = "Next:"

-- Mute toggle. Not a spoken line.
Lines.MUTE = "MUTE"
Lines.UNMUTE = "UNMUTE"

-- Stay / step-off choice (web presentDoorChoice / resolveDoors).
Lines.STAY_ON = "Stay on"
Lines.STEP_OFF = "Step off"
Lines.DOOR_PROMPT = "The doors are open."
Lines.MOM_REAL_OFF = "Mom: Hey! Where are you going? Get back in here."
Lines.MOM_REFUSE_HAVEN = "Mom: You don’t want to stretch your legs? …Okay."
Lines.MOM_FALSE_FORGIVING = "Mom: Not this one, hon. The doors opened funny."
-- Safe Haven (Myrtle–Willoughby). Web executeSafeHaven / giveRecorder.
Lines.MOM_HAVEN_CUE = "Mom: I think this is our transfer. Let’s stretch our legs."
Lines.MOM_HAVEN_STAND = "Mom: Feels good to stand up, right?"
Lines.DAD_HAVEN_STOPS = "Dad: Couple more stops after this. Then Court Square."
Lines.DAD_RECORDER_HAVEN =
	"Dad: Here. Your grandfather’s. He used it on the night shift. Never could get it to stop picking up the radio."
Lines.DAD_RECORDER_TRAIN =
	"Dad: Here, hold onto this. Your grandfather’s old recorder. Never could get it to stop picking up the radio."
Lines.RECORDER_HINT = "Dad gave you a tape recorder. Press R to raise it. Tab opens Evidence."
Lines.RECORDER_NONE = "You don’t have anything to record with."
Lines.RECORDER_BUSY = "Your hands are full."
-- Polaroid (web camera / film hints).
Lines.CAMERA_BUSY = "Answer first."
Lines.CAMERA_OUT_OF_FILM = "Out of film."
Lines.CAMERA_HINT = "Press C for the Polaroid. Space snaps. P opens the album strip."
Lines.CAMERA_FLASH_WATCH = "The flash caught a parent's eye."
Lines.HAVEN_BOARD = "You get back on with them."
-- Kept for Doors.resolve signature / older call sites; unused once haven runs.
Lines.HAVEN_STUB = ""
Lines.TRIAL_STUB = ""
-- False Stop Trial (engineTrial.ts).
Lines.TRIAL_HINT = "Find the way back. The signs lie. Watch the lights when the chime plays."
Lines.MOM_TRIAL_CLEAN = "Mom: Where did you go?! You can’t just walk off like that!"
Lines.MOM_TRIAL_ROUGH = "You don’t remember getting back on. Mom: Oh my god. Where were you?"
Lines.DAD_TRIAL_SIT = "Dad: Sit. Stay where we can see you."

-- ReportScreen: "False flag: {name}"
function Lines.falseFlag(label: string): string
	return Lines.FALSE_FLAG .. ": " .. label
end

-- "This is Fulton St."
function Lines.thisIs(name: string): string
	return "This is " .. name .. "."
end

-- "The next stop is Fulton St."
function Lines.nextStop(name: string): string
	return "The next stop is " .. name .. "."
end

-- "{miss} missed, {fp} false flag(s)."
function Lines.scoreLine(miss: number, fp: number): string
	local suffix = if fp == 1 then "" else "s"
	return string.format("%d missed, %d false flag%s.", miss, fp, suffix)
end

-- Dwell banner. Not a spoken line.
Lines.MIN_DWELL = "MINIMUM DWELL TIME"

function Lines.dwellCountdown(secondsLeft: number): string
	local whole = math.ceil(secondsLeft)
	if whole < 1 then
		whole = 1
	end
	return tostring(whole)
end

-- Minute board. The number is the count. MIN is the unit.
Lines.MIN_LABEL = "MIN"

function Lines.minutesLabel(minutes: number): string
	return tostring(minutes) .. " " .. Lines.MIN_LABEL
end

-- Flag labels for the two tells. Not spoken lines.
Lines.ANNOUNCEMENT = "the announcement"
Lines.COUNTDOWN = "the countdown"
Lines.STICKER = "the window sticker"
Lines.MAPSTOP = "the route map"
Lines.NEARWORD = "the warped ad"
Lines.LIGHTTEMP = "the cold light"
Lines.EMPTY = "the empty car"
Lines.MAP_NORMAL = "G · Hoyt–Schermerhorn → Court Sq"
Lines.MAP_HOLLOW = "G · Hollow St (impossible)"
Lines.AD_NORMAL = "GREENPOINT SAVINGS"
Lines.AD_WARP = "DONT LOOK BACK"

-- Suspicion HUD. The number is Ride.Suspicion; the word is Ride.Band
-- (calm / uneasy / watched / hunted from Shared.Band). Display only.
Lines.BAND_CALM = "CALM"
Lines.BAND_UNEASY = "UNEASY"
Lines.BAND_WATCHED = "WATCHED"
Lines.BAND_HUNTED = "HUNTED"

function Lines.bandLabel(band: string): string
	if band == "uneasy" then
		return Lines.BAND_UNEASY
	end
	if band == "watched" then
		return Lines.BAND_WATCHED
	end
	if band == "hunted" then
		return Lines.BAND_HUNTED
	end
	return Lines.BAND_CALM
end

-- "25 UNEASY" — whole number plus the band word.
function Lines.suspicionMeter(value: number, band: string): string
	local n = math.floor(value + 0.5)
	if n < 0 then
		n = 0
	elseif n > 100 then
		n = 100
	end
	return tostring(n) .. " " .. Lines.bandLabel(band)
end

-- Sanity HUD. Number is Ride.Sanity; word is Ride.SanityTier.
Lines.TIER_HIGH = "HIGH"
Lines.TIER_MEDIUM = "MEDIUM"
Lines.TIER_LOW = "LOW"
Lines.TIER_CRITICAL = "CRITICAL"

function Lines.tierLabel(tier: string): string
	if tier == "medium" then
		return Lines.TIER_MEDIUM
	end
	if tier == "low" then
		return Lines.TIER_LOW
	end
	if tier == "critical" then
		return Lines.TIER_CRITICAL
	end
	return Lines.TIER_HIGH
end

-- "82 HIGH" — whole number plus the tier word.
function Lines.sanityMeter(value: number, tier: string): string
	local n = math.floor(value + 0.5)
	if n < 0 then
		n = 0
	elseif n > 100 then
		n = 100
	end
	return tostring(n) .. " " .. Lines.tierLabel(tier)
end

-- Restraint (Greenpoint Av). Hold Space or F; same button as Flag.
-- Banner matches web "Hold Space. Don't let go. Don't react." with F called out for Studio.
Lines.RESTRAINT_HINT = "HOLD — keep Space or F down. Don't let go. Don't react."
Lines.RESTRAINT_BUTTON = "Space / F"
Lines.RESTRAINT_DAD = "Dad: No. We're not getting off. You know that."
Lines.RESTRAINT_MOM_MOUTH = "Mom (her mouth doesn't move): You can stop pretending."
Lines.RESTRAINT_OK = "The lights come back. Everyone is where they were."
Lines.RESTRAINT_FAIL = "You flinch. Dad sees it."
Lines.RESTRAINT_FAIL_WAIT = "You couldn't keep it together"

-- Concerned intervention (suspicion ≥ intervene threshold). Does not end the ride.
Lines.INTERVENTION_DAD = "Dad: Hey. Look at me. Both of us, right now."
Lines.INTERVENTION_MOM = "Mom: Talk to us. What is going on with you?"
Lines.INTERVENTION_YOU = "You: Nothing. I'm okay. I promise."

-- Court Square exit choice (labels never spoil which ending is open).
Lines.EXIT_PROMPT = "Which way out?"
Lines.EXIT_ESCALATORS = "Follow Mom and Dad to the escalators"
Lines.EXIT_LOWER = "Follow the static down the side stairs"
Lines.EXIT_HATCH = "Push through the emergency door"
Lines.EXIT_DEFAULT = "default Escalators"

-- Meta menu (nightmare / chapter / archive).
Lines.META_TITLE = "LAST LOCAL"
Lines.META_START = "Ride from Hoyt"
Lines.META_CH2 = "Practice · Ch II (Haven)"
Lines.META_CH3 = "Practice · Ch III (Greenpoint)"
Lines.META_NIGHTMARE = "Nightmare mode"
Lines.META_NIGHTMARE_LOCKED = "Nightmare (finish one full ride)"
Lines.META_PRACTICE_NOTE = "Practice: nothing is saved."
Lines.META_ARCHIVE = "Case Files"
Lines.META_AGAIN = "Back to menu"
Lines.META_HINT = "Choose a ride. Nightmare unlocks after one full arrival at Court Sq."

-- Caught staring / false-stop react feedback.
Lines.STARE_CAUGHT = "They saw you looking."
Lines.STARE_PARENT = "Mom: Don’t stare."
Lines.FALSE_STOP_REACT = "You moved toward the doors. They noticed."

return Lines
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Motion</string>
          <string name="Source"><![CDATA[--!strict
-- Speed and distance along one stretch. Port of gameState.segVel / segPos.
-- smoothstep accel, steady cruise, smoothstep brake. Times are the slice's
-- ACCEL, sliceCruise and BRAKE, so the scenery and the stop timer agree.

local Motion = {}

function Motion.smooth(x: number): number
	local u = math.clamp(x, 0, 1)
	return u * u * (3 - 2 * u)
end

function Motion.speed(t: number, accel: number, cruise: number, brake: number, top: number): number
	if t <= 0 or accel <= 0 or brake <= 0 then
		return 0
	end
	if t < accel then
		return top * Motion.smooth(t / accel)
	end
	if t < accel + cruise then
		return top
	end
	if t < accel + cruise + brake then
		return top * (1 - Motion.smooth((t - accel - cruise) / brake))
	end
	return 0
end

-- Metres travelled since the start of the stretch. At the end of braking
-- this is top * (accel/2 + cruise + brake/2), matching segDist.
function Motion.distance(t: number, accel: number, cruise: number, brake: number, top: number): number
	if t <= 0 or accel <= 0 or brake <= 0 then
		return 0
	end
	local length = accel + cruise + brake
	if t >= length then
		return top * (accel / 2 + cruise + brake / 2)
	end
	if t <= accel then
		local u = t / accel
		return top * accel * (u * u * u - (u * u * u * u) / 2)
	end
	local travelled = top * accel / 2
	if t <= accel + cruise then
		return travelled + top * (t - accel)
	end
	travelled += top * cruise
	local u = math.clamp((t - accel - cruise) / brake, 0, 1)
	return travelled + top * brake * (u - (u * u * u - (u * u * u * u) / 2))
end

function Motion.segmentDistance(accel: number, cruise: number, brake: number, top: number): number
	return top * (accel / 2 + cruise + brake / 2)
end

return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Nightmare</string>
          <string name="Source"><![CDATA[--!strict
-- Nightmare mode tuning from src/constants.ts NIGHTMARE.
-- Unlocked after one completed full (non-practice) ride.

local Nightmare = {}

Nightmare.CRUISE = 0.75
Nightmare.SPEED = 1.2
Nightmare.DRIFT = 1.5
Nightmare.MIN_DRIFT = -2

function Nightmare.cruiseSeconds(base: number, on: boolean): number
	if not on then
		return base
	end
	return math.max(4, base * Nightmare.CRUISE)
end

function Nightmare.topSpeed(base: number, on: boolean): number
	if not on then
		return base
	end
	return base * Nightmare.SPEED
end

function Nightmare.driftDelta(base: number, on: boolean): number
	if not on then
		return base
	end
	local scaled = base * Nightmare.DRIFT
	if scaled > Nightmare.MIN_DRIFT then
		return Nightmare.MIN_DRIFT
	end
	return scaled
end

return Nightmare
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
