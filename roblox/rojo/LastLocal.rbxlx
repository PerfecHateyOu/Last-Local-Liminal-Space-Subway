        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[--!strict
-- Minimal sound bed. Client only. Phase, stretch timing, Held, DoorTarget,
-- and PaText stay server-owned; this module listens and plays.
-- Chime before PA, rumble from stretch speed, door open/close scenes, track
-- clacks. Door uses Shared.DoorSound windows (long scene open 0–4.45 / close
-- 4.45–end; short latch full clip). Open and close are separate instances so
-- a short dwell does not cut the open scene. EVP raise uses the 0.75–1.10
-- attack only. No ride-music decay, pause music, heartbeat, or intercom voice.
-- OpenAir (0–1) fades a wind/rain bed on the Newtown Creek trestle.
-- SoundIds come from Shared.Assets (place StringValues). Empty → skip play
-- so unapproved classic rbxasset:// paths never hit Output.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Constants = require(ReplicatedStorage.Shared.Constants)
local DoorSound = require(ReplicatedStorage.Shared.DoorSound)
local Hold = require(ReplicatedStorage.Shared.Hold)
local Lines = require(ReplicatedStorage.Shared.Lines)
local Motion = require(ReplicatedStorage.Shared.Motion)

local Audio = {}

local muted = false
local group: SoundGroup? = nil
local rumble: Sound? = nil
local openAir: Sound? = nil
local muteButton: TextButton? = nil
local lastDoor: number? = nil
local lastPa = ""
local clackTravel = 0
local lastSpeedSample = 0
local openAirLevel = 0

local function makeSound(name: string, id: string, volume: number, looped: boolean): Sound?
	local ready = Assets.normalizeSoundId(id)
	if ready == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = ready
	sound.Volume = volume
	sound.Looped = looped
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	if group ~= nil then
		sound.SoundGroup = group
	end
	sound.Parent = SoundService
	return sound
end

local function destroySound(sound: Sound)
	if sound.Parent ~= nil then
		sound:Stop()
		sound:Destroy()
	end
end

local function whenSoundReady(sound: Sound, onReady: (length: number) -> ())
	local function finish(length: number)
		if sound.Parent == nil then
			return
		end
		onReady(length)
	end

	if sound.IsLoaded and sound.TimeLength > 0 then
		finish(sound.TimeLength)
		return
	end

	local conn: RBXScriptConnection? = nil
	conn = sound.Loaded:Connect(function()
		local c = conn
		if c ~= nil then
			c:Disconnect()
		end
		finish(sound.TimeLength)
	end)
	task.delay(Constants.SOUND_ONESHOT_MAX_LIFE, function()
		local c = conn
		if c ~= nil and c.Connected then
			c:Disconnect()
		end
		if sound.Parent ~= nil and not sound.IsPlaying then
			destroySound(sound)
		end
	end)
end

local function playOneShot(key: Assets.SoundKey, volume: number, playback: number?)
	if muted then
		return
	end
	local id = Assets.soundId(key)
	local sound = makeSound("OneShot", id, volume, false)
	if sound == nil then
		return
	end
	if playback ~= nil then
		sound.PlaybackSpeed = playback
	end
	sound:Play()
	sound.Ended:Once(function()
		destroySound(sound)
	end)
	task.delay(Constants.SOUND_ONESHOT_MAX_LIFE, function()
		destroySound(sound)
	end)
end

-- Play [startAt, endAt) on the Door asset. New instance per call so a 2.6s
-- dwell does not cut the open scene when close starts on top.
local function playDoorSlice(
	name: string,
	volume: number,
	windowFor: (length: number) -> (number, number)
)
	if muted then
		return
	end
	local id = Assets.soundId("door")
	local sound = makeSound(name, id, volume, false)
	if sound == nil then
		return
	end

	whenSoundReady(sound, function(length: number)
		if length <= 0 then
			destroySound(sound)
			return
		end
		local startAt, endAt = windowFor(length)
		local finish = math.clamp(endAt, 0, length)
		local start = math.clamp(startAt, 0, finish)
		if finish <= start then
			destroySound(sound)
			return
		end
		local speed = math.max(sound.PlaybackSpeed, 0.05)
		local life = (finish - start) / speed
		sound.TimePosition = start
		sound:Play()
		-- Stop at the scene end (do not wait for full-asset Ended / old 4s cutoff).
		task.delay(life + 0.05, function()
			destroySound(sound)
		end)
	end)
end

local function playChime()
	-- Two-tone stand-in for the MTA ding using one clip pitched twice.
	playOneShot("chime", Constants.SOUND_CHIME_VOLUME, 1.05)
	task.delay(0.45, function()
		playOneShot("chime", Constants.SOUND_CHIME_VOLUME * 0.9, 0.84)
	end)
end

local function playDoor(opening: boolean)
	playDoorSlice(if opening then "DoorOpen" else "DoorClose", Constants.SOUND_DOOR_VOLUME, function(length: number)
		return DoorSound.edgeWindow(length, opening)
	end)
end

local function playDoorEvpAttack()
	playDoorSlice("DoorEvp", 0.15, DoorSound.evpAttackWindow)
end

local function playClack()
	playOneShot("clack", Constants.SOUND_CLACK_VOLUME, 1.4 + math.random() * 0.2)
end

local function speedFraction(): number
	local ride = ReplicatedStorage:FindFirstChild("Ride")
	if ride == nil then
		return 0
	end
	if ride:GetAttribute("Phase") ~= "ride" then
		return 0
	end
	local start = ride:GetAttribute("StretchStart")
	local accel = ride:GetAttribute("StretchAccel")
	local cruise = ride:GetAttribute("StretchCruise")
	local brake = ride:GetAttribute("StretchBrake")
	if typeof(start) ~= "number" or typeof(accel) ~= "number" or typeof(cruise) ~= "number" or typeof(brake) ~= "number" then
		return 0
	end
	local holdAt = ride:GetAttribute("HoldAt")
	local holdFor = ride:GetAttribute("HoldFor")
	local at = if typeof(holdAt) == "number" then holdAt else 0
	local span = if typeof(holdFor) == "number" then holdFor else 0
	local elapsed = workspace:GetServerTimeNow() - start
	if not Hold.moving(elapsed, at, span) then
		return 0
	end
	local motionT = Hold.motionTime(elapsed, at, span)
	local top = Constants.TOP_SPEED_MPS
	local velocity = Motion.speed(motionT, accel, cruise, brake, top)
	if top <= 0 then
		return 0
	end
	return math.clamp(velocity / top, 0, 1)
end

local function refreshMuteLabel()
	local button = muteButton
	if button == nil then
		return
	end
	button.Text = if muted then Lines.UNMUTE else Lines.MUTE
end

function Audio.isMuted(): boolean
	return muted
end

function Audio.setMute(value: boolean)
	muted = value
	local bus = group
	if bus ~= nil then
		bus.Volume = if muted then 0 else 1
	end
	local loop = rumble
	if loop ~= nil and muted then
		loop.Volume = 0
	end
	local wind = openAir
	if wind ~= nil and muted then
		wind.Volume = 0
	end
	refreshMuteLabel()
end

function Audio.toggleMute(): boolean
	Audio.setMute(not muted)
	return muted
end

function Audio.start(button: TextButton)
	muteButton = button
	refreshMuteLabel()
	button.MouseButton1Click:Connect(function()
		Audio.toggleMute()
	end)

	local bus = Instance.new("SoundGroup")
	bus.Name = "LastLocal"
	bus.Volume = 1
	bus.Parent = SoundService
	group = bus

	local readyCount, total, missing = Assets.soundStatus()
	if readyCount == 0 then
		print(
			"[Last Local] Sound bed silent (no ReplicatedStorage.Assets IDs). Ride continues. See README → Sound bed."
		)
	elseif readyCount < total then
		print(
			string.format(
				"[Last Local] Sound bed %d/%d wired; silent without IDs: %s",
				readyCount,
				total,
				table.concat(missing, ", ")
			)
		)
	else
		print("[Last Local] Sound bed fully wired.")
	end

	local loop = makeSound("Rumble", Assets.soundId("rumble"), 0, true)
	if loop ~= nil then
		loop.PlaybackSpeed = Constants.SOUND_RUMBLE_PLAYBACK
		loop:Play()
		rumble = loop
	end

	local wind = makeSound("OpenAir", Assets.soundId("openAir"), 0, true)
	if wind ~= nil then
		wind.PlaybackSpeed = Constants.SOUND_OPEN_AIR_PLAYBACK
		wind:Play()
		openAir = wind
	end

	local ride = ReplicatedStorage:WaitForChild("Ride")
	local openAttr = ride:GetAttribute("OpenAir")
	openAirLevel = if typeof(openAttr) == "number" then math.clamp(openAttr, 0, 1) else 0

	local function onDoor(value: any)
		if typeof(value) ~= "number" then
			return
		end
		local previous = lastDoor
		lastDoor = value
		if previous == nil then
			return
		end
		if previous < 0.5 and value >= 0.5 then
			playDoor(true)
		elseif previous >= 0.5 and value < 0.5 then
			playDoor(false)
		end
	end

	local function onPa(value: any)
		local text = if typeof(value) == "string" then value else ""
		if text ~= "" and text ~= lastPa then
			playChime()
		end
		lastPa = text
	end

	onDoor(ride:GetAttribute("DoorTarget"))
	onPa(ride:GetAttribute("PaText"))

	local lastEvpRaised = false
	local lastPlayId = ""

	ride.AttributeChanged:Connect(function(name: string)
		if name == "DoorTarget" then
			onDoor(ride:GetAttribute("DoorTarget"))
		elseif name == "PaText" then
			onPa(ride:GetAttribute("PaText"))
		elseif name == "TrialChime" then
			local stamp = ride:GetAttribute("TrialChime")
			if typeof(stamp) == "number" and stamp > 0 then
				playChime()
			end
		elseif name == "EvpRaised" then
			local on = ride:GetAttribute("EvpRaised") == true
			if on and not lastEvpRaised then
				playDoorEvpAttack()
			end
			lastEvpRaised = on
			local loopSound = rumble
			if loopSound ~= nil and on and not muted then
				loopSound.Volume = math.min(loopSound.Volume, Constants.SOUND_RUMBLE_MIN)
			end
		elseif name == "PolaroidFlash" then
			local stamp = ride:GetAttribute("PolaroidFlash")
			if typeof(stamp) == "number" and stamp > 0 then
				playOneShot("polaroid", Constants.SOUND_POLAROID_VOLUME, 1.35)
			end
		elseif name == "OpenAir" then
			local level = ride:GetAttribute("OpenAir")
			openAirLevel = if typeof(level) == "number" then math.clamp(level, 0, 1) else 0
		elseif name == "EvpPlayId" then
			local id = ride:GetAttribute("EvpPlayId")
			local text = if typeof(id) == "string" then id else ""
			if text ~= "" and text ~= lastPlayId then
				playOneShot("chime", 0.25, 0.7)
				task.delay(0.35, function()
					playOneShot("chime", 0.2, 0.55)
				end)
			end
			lastPlayId = text
		end
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.M then
			Audio.toggleMute()
		end
	end)

	lastSpeedSample = os.clock()
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		local dt = now - lastSpeedSample
		lastSpeedSample = now
		if dt <= 0 or dt > 0.5 then
			return
		end
		local fraction = speedFraction()
		local loopSound = rumble
		if loopSound ~= nil and not muted then
			local vol = Constants.SOUND_RUMBLE_MIN
				+ (Constants.SOUND_RUMBLE_MAX - Constants.SOUND_RUMBLE_MIN) * fraction
			loopSound.Volume = if fraction > 0.02 then vol else 0
		elseif loopSound ~= nil and muted then
			loopSound.Volume = 0
		end
		local windSound = openAir
		if windSound ~= nil and not muted then
			-- Web peaks ~0.14 * level; slice uses a quieter stand-in.
			windSound.Volume = Constants.SOUND_OPEN_AIR_MAX * openAirLevel
		elseif windSound ~= nil and muted then
			windSound.Volume = 0
		end
		if fraction > 0.08 then
			clackTravel += Constants.TOP_SPEED_MPS * fraction * dt
			if clackTravel >= Constants.CLACK_SPACING_M then
				clackTravel = 0
				playClack()
			end
		else
			clackTravel = 0
		end
	end)
end

return Audio
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Choice</string>
            <string name="Source"><![CDATA[--!strict
-- Stay / Step off UI. Server owns validation; this only fires the Doors remote
-- while ChoiceActive is true. Timeout on the server counts as Stay on.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Lines = require(ReplicatedStorage.Shared.Lines)

local Choice = {}

function Choice.start(stayButton: TextButton, offButton: TextButton, setVisible: (boolean) -> (), setCountdown: (string) -> ())
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local doorsRemote = remotes:WaitForChild("Doors") :: RemoteEvent
	local sent = false

	local function active(): boolean
		return ride:GetAttribute("ChoiceActive") == true
	end

	local function pick(choice: string)
		if not active() or sent then
			return
		end
		sent = true
		doorsRemote:FireServer(choice)
	end

	stayButton.MouseButton1Click:Connect(function()
		pick("stay")
	end)
	offButton.MouseButton1Click:Connect(function()
		pick("off")
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.KeypadOne then
			pick("stay")
		elseif input.KeyCode == Enum.KeyCode.Two or input.KeyCode == Enum.KeyCode.KeypadTwo then
			pick("off")
		end
	end)

	local function refresh()
		local on = active()
		setVisible(on)
		if not on then
			sent = false
			setCountdown("")
			return
		end
		local deadline = ride:GetAttribute("ChoiceUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			setCountdown("")
			return
		end
		local remain = math.ceil(deadline - workspace:GetServerTimeNow())
		if remain < 1 then
			remain = 1
		end
		setCountdown(Lines.dwellCountdown(remain) .. " · default Stay on")
	end

	ride.AttributeChanged:Connect(function(name: string)
		if name == "ChoiceActive" or name == "ChoiceUntil" then
			refresh()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if active() then
			refresh()
		end
	end)
	refresh()
end

return Choice
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Evp</string>
            <string name="Source"><![CDATA[--!strict
-- Tape recorder UI: raise/lower, tune, hold-to-record, Evidence list + playback.
-- Server owns meter/lock/tapes; this only fires remotes and draws attributes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local Constants = require(ReplicatedStorage.Shared.Constants)

local Evp = {}

local function corner(parent: Instance, radius: number)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius)
	ui.Parent = parent
end

local function parseTapes(raw: string): { { signalId: string, title: string, stop: string, freq: string, transcript: string } }
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or typeof(data) ~= "table" then
		return {}
	end
	local out = {}
	for _, item in data do
		if typeof(item) == "table" and typeof(item.signalId) == "string" and typeof(item.title) == "string" then
			table.insert(out, {
				signalId = item.signalId,
				title = item.title,
				stop = if typeof(item.stop) == "string" then item.stop else "",
				freq = if typeof(item.freq) == "string" then item.freq else "",
				transcript = if typeof(item.transcript) == "string" then item.transcript else "",
			})
		end
	end
	return out
end

function Evp.start(recorderButton: TextButton, evidenceButton: TextButton)
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local toggleRemote = remotes:WaitForChild("EvpToggle") :: RemoteEvent
	local tuneRemote = remotes:WaitForChild("EvpTune") :: RemoteEvent
	local recordRemote = remotes:WaitForChild("EvpRecord") :: RemoteEvent
	local playRemote = remotes:WaitForChild("EvpPlay") :: RemoteEvent

	local gui = playerGui:WaitForChild("LastLocalHud") :: ScreenGui

	local panel = Instance.new("Frame")
	panel.Name = "EvpRecorder"
	panel.AnchorPoint = Vector2.new(1, 1)
	panel.Position = UDim2.new(1, -16, 1, -120)
	panel.Size = UDim2.fromOffset(280, 168)
	panel.BackgroundColor3 = Color3.fromRGB(18, 16, 12)
	panel.BackgroundTransparency = 0.08
	panel.BorderSizePixel = 0
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 10)

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Code
	title.Text = "MICROCASSETTE"
	title.TextSize = 11
	title.TextColor3 = Color3.fromRGB(180, 176, 166)
	title.Position = UDim2.fromOffset(12, 8)
	title.Size = UDim2.new(1, -48, 0, 16)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local lower = Instance.new("TextButton")
	lower.Name = "Lower"
	lower.AnchorPoint = Vector2.new(1, 0)
	lower.Position = UDim2.new(1, -8, 0, 4)
	lower.Size = UDim2.fromOffset(28, 28)
	lower.BackgroundColor3 = Color3.fromRGB(40, 36, 30)
	lower.BorderSizePixel = 0
	lower.Font = Enum.Font.GothamBold
	lower.Text = "×"
	lower.TextColor3 = Constants.COLOR.cream
	lower.TextSize = 16
	lower.Parent = panel
	corner(lower, 14)

	local khzLabel = Instance.new("TextLabel")
	khzLabel.Name = "Khz"
	khzLabel.BackgroundTransparency = 1
	khzLabel.Font = Enum.Font.GothamBold
	khzLabel.Text = "120.0 kHz"
	khzLabel.TextSize = 18
	khzLabel.TextColor3 = Constants.COLOR.cream
	khzLabel.Position = UDim2.fromOffset(12, 28)
	khzLabel.Size = UDim2.fromOffset(120, 24)
	khzLabel.TextXAlignment = Enum.TextXAlignment.Left
	khzLabel.Parent = panel

	local lockDot = Instance.new("Frame")
	lockDot.Name = "Lock"
	lockDot.Position = UDim2.fromOffset(140, 34)
	lockDot.Size = UDim2.fromOffset(12, 12)
	lockDot.BackgroundColor3 = Color3.fromRGB(44, 58, 40)
	lockDot.BorderSizePixel = 0
	lockDot.Parent = panel
	corner(lockDot, 6)

	local meterBack = Instance.new("Frame")
	meterBack.Name = "MeterBack"
	meterBack.Position = UDim2.fromOffset(12, 58)
	meterBack.Size = UDim2.new(1, -24, 0, 8)
	meterBack.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	meterBack.BorderSizePixel = 0
	meterBack.Parent = panel
	corner(meterBack, 4)

	local meterFill = Instance.new("Frame")
	meterFill.Name = "Fill"
	meterFill.Size = UDim2.fromScale(0, 1)
	meterFill.BackgroundColor3 = Constants.COLOR.gLine
	meterFill.BorderSizePixel = 0
	meterFill.Parent = meterBack
	corner(meterFill, 4)

	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Font = Enum.Font.Gotham
	status.Text = ""
	status.TextSize = 12
	status.TextColor3 = Constants.COLOR.cream
	status.TextWrapped = true
	status.Position = UDim2.fromOffset(12, 72)
	status.Size = UDim2.new(1, -24, 0, 40)
	status.TextXAlignment = Enum.TextXAlignment.Left
	status.TextYAlignment = Enum.TextYAlignment.Top
	status.Parent = panel

	local tuneLeft = Instance.new("TextButton")
	tuneLeft.Position = UDim2.fromOffset(12, 118)
	tuneLeft.Size = UDim2.fromOffset(40, 36)
	tuneLeft.BackgroundColor3 = Color3.fromRGB(40, 36, 30)
	tuneLeft.BorderSizePixel = 0
	tuneLeft.Font = Enum.Font.GothamBold
	tuneLeft.Text = "["
	tuneLeft.TextColor3 = Constants.COLOR.cream
	tuneLeft.TextSize = 16
	tuneLeft.Parent = panel
	corner(tuneLeft, 8)

	local tuneRight = Instance.new("TextButton")
	tuneRight.Position = UDim2.fromOffset(56, 118)
	tuneRight.Size = UDim2.fromOffset(40, 36)
	tuneRight.BackgroundColor3 = Color3.fromRGB(40, 36, 30)
	tuneRight.BorderSizePixel = 0
	tuneRight.Font = Enum.Font.GothamBold
	tuneRight.Text = "]"
	tuneRight.TextColor3 = Constants.COLOR.cream
	tuneRight.TextSize = 16
	tuneRight.Parent = panel
	corner(tuneRight, 8)

	local rec = Instance.new("TextButton")
	rec.Name = "Record"
	rec.Position = UDim2.fromOffset(108, 118)
	rec.Size = UDim2.new(1, -120, 0, 36)
	rec.BackgroundColor3 = Color3.fromRGB(80, 28, 24)
	rec.BorderSizePixel = 0
	rec.Font = Enum.Font.GothamBold
	rec.Text = "HOLD  REC"
	rec.TextColor3 = Constants.COLOR.cream
	rec.TextSize = 13
	rec.Parent = panel
	corner(rec, 8)

	local evidence = Instance.new("Frame")
	evidence.Name = "EvidenceLog"
	evidence.AnchorPoint = Vector2.new(0.5, 0.5)
	evidence.Position = UDim2.fromScale(0.5, 0.48)
	evidence.Size = UDim2.fromOffset(360, 280)
	evidence.BackgroundColor3 = Color3.fromRGB(14, 12, 10)
	evidence.BackgroundTransparency = 0.05
	evidence.BorderSizePixel = 0
	evidence.Visible = false
	evidence.Parent = gui
	corner(evidence, 12)

	local evTitle = Instance.new("TextLabel")
	evTitle.BackgroundTransparency = 1
	evTitle.Font = Enum.Font.GothamBold
	evTitle.Text = "Evidence Log — Tapes"
	evTitle.TextSize = 16
	evTitle.TextColor3 = Constants.COLOR.cream
	evTitle.Position = UDim2.fromOffset(14, 10)
	evTitle.Size = UDim2.new(1, -50, 0, 24)
	evTitle.TextXAlignment = Enum.TextXAlignment.Left
	evTitle.Parent = evidence

	local evClose = Instance.new("TextButton")
	evClose.AnchorPoint = Vector2.new(1, 0)
	evClose.Position = UDim2.new(1, -10, 0, 8)
	evClose.Size = UDim2.fromOffset(28, 28)
	evClose.BackgroundColor3 = Color3.fromRGB(40, 36, 30)
	evClose.BorderSizePixel = 0
	evClose.Font = Enum.Font.GothamBold
	evClose.Text = "×"
	evClose.TextColor3 = Constants.COLOR.cream
	evClose.TextSize = 16
	evClose.Parent = evidence
	corner(evClose, 14)

	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.Position = UDim2.fromOffset(12, 44)
	list.Size = UDim2.new(1, -24, 1, -56)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.fromOffset(0, 0)
	list.Parent = evidence

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = list

	local recordingHeld = false

	local function hasRecorder(): boolean
		return ride:GetAttribute("HasRecorder") == true
	end

	local function raised(): boolean
		return ride:GetAttribute("EvpRaised") == true
	end

	local function refreshRecorderButton()
		recorderButton.Visible = hasRecorder()
		recorderButton.Text = if raised() then "LOWER" else "REC"
		recorderButton.BackgroundColor3 = if raised()
			then Color3.fromRGB(48, 28, 18)
			else Color3.fromRGB(8, 8, 8)
	end

	local function refreshPanel()
		panel.Visible = raised()
		if not raised() then
			return
		end
		local khz = ride:GetAttribute("EvpKhz")
		local meter = ride:GetAttribute("EvpMeter")
		local locked = ride:GetAttribute("EvpLocked")
		local statusText = ride:GetAttribute("EvpStatus")
		local saved = ride:GetAttribute("EvpSaved")
		khzLabel.Text = string.format("%.1f kHz", if typeof(khz) == "number" then khz else 120)
		meterFill.Size = UDim2.fromScale(math.clamp(if typeof(meter) == "number" then meter else 0, 0, 1), 1)
		local lockedOn = typeof(locked) == "string" and locked ~= ""
		lockDot.BackgroundColor3 = if lockedOn then Constants.COLOR.gLine else Color3.fromRGB(44, 58, 40)
		if typeof(saved) == "string" and saved ~= "" then
			status.Text = "Saved to tape: " .. saved
		elseif typeof(statusText) == "string" then
			status.Text = statusText
		else
			status.Text = ""
		end
		local recordT = ride:GetAttribute("EvpRecordT")
		if typeof(recordT) == "number" and recordT > 0 then
			rec.Text = string.format("REC  %.1fs", recordT)
		else
			rec.Text = "HOLD  REC"
		end
	end

	local function rebuildEvidence()
		for _, child in list:GetChildren() do
			if child:IsA("TextButton") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local raw = ride:GetAttribute("EvpTapes")
		local tapes = parseTapes(if typeof(raw) == "string" then raw else "[]")
		if #tapes == 0 then
			local empty = Instance.new("TextLabel")
			empty.BackgroundTransparency = 1
			empty.Font = Enum.Font.Gotham
			empty.Text = "No tapes yet. Raise the recorder (R), tune, and hold REC on a voice."
			empty.TextSize = 13
			empty.TextColor3 = Color3.fromRGB(180, 176, 166)
			empty.TextWrapped = true
			empty.Size = UDim2.new(1, 0, 0, 48)
			empty.Parent = list
		else
			for _, tape in tapes do
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -4, 0, 52)
				btn.BackgroundColor3 = Color3.fromRGB(28, 26, 22)
				btn.BorderSizePixel = 0
				btn.AutoButtonColor = true
				btn.Font = Enum.Font.GothamMedium
				btn.Text = tape.title .. "\n" .. tape.freq .. " · " .. tape.stop .. "  [Play]"
				btn.TextColor3 = Constants.COLOR.cream
				btn.TextSize = 13
				btn.TextXAlignment = Enum.TextXAlignment.Left
				btn.Parent = list
				corner(btn, 8)
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 10)
				pad.PaddingTop = UDim.new(0, 6)
				pad.Parent = btn
				local id = tape.signalId
				btn.MouseButton1Click:Connect(function()
					playRemote:FireServer(id)
				end)
			end
		end
		list.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 8)
	end

	recorderButton.MouseButton1Click:Connect(function()
		toggleRemote:FireServer()
	end)
	evidenceButton.MouseButton1Click:Connect(function()
		evidence.Visible = not evidence.Visible
		if evidence.Visible then
			rebuildEvidence()
		end
	end)
	lower.MouseButton1Click:Connect(function()
		if raised() then
			toggleRemote:FireServer()
		end
	end)
	evClose.MouseButton1Click:Connect(function()
		evidence.Visible = false
	end)
	tuneLeft.MouseButton1Click:Connect(function()
		tuneRemote:FireServer(-0.5)
	end)
	tuneRight.MouseButton1Click:Connect(function()
		tuneRemote:FireServer(0.5)
	end)

	local function setRecording(on: boolean)
		if recordingHeld == on then
			return
		end
		recordingHeld = on
		recordRemote:FireServer(on)
	end

	rec.MouseButton1Down:Connect(function()
		setRecording(true)
	end)
	rec.MouseButton1Up:Connect(function()
		setRecording(false)
	end)
	rec.MouseLeave:Connect(function()
		setRecording(false)
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if ride:GetAttribute("Phase") == "menu" then
			return
		end
		if input.KeyCode == Enum.KeyCode.R then
			toggleRemote:FireServer()
		elseif input.KeyCode == Enum.KeyCode.Tab then
			evidence.Visible = not evidence.Visible
			if evidence.Visible then
				rebuildEvidence()
			end
		elseif raised() then
			if input.KeyCode == Enum.KeyCode.LeftBracket then
				tuneRemote:FireServer(-0.5)
			elseif input.KeyCode == Enum.KeyCode.RightBracket then
				tuneRemote:FireServer(0.5)
			elseif input.KeyCode == Enum.KeyCode.Space then
				setRecording(true)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject, _processed: boolean)
		if input.KeyCode == Enum.KeyCode.Space then
			setRecording(false)
		end
	end)
	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if processed or not raised() then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			local z = input.Position.Z
			tuneRemote:FireServer(if z > 0 then 0.5 else -0.5)
		end
	end)

	ride.AttributeChanged:Connect(function(name: string)
		if
			name == "HasRecorder"
			or name == "EvpRaised"
			or name == "EvpKhz"
			or name == "EvpMeter"
			or name == "EvpLocked"
			or name == "EvpStatus"
			or name == "EvpSaved"
			or name == "EvpRecordT"
		then
			refreshRecorderButton()
			refreshPanel()
		elseif name == "EvpTapes" and evidence.Visible then
			rebuildEvidence()
		end
	end)

	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		list.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 8)
	end)

	RunService.Heartbeat:Connect(function()
		evidenceButton.Visible = hasRecorder()
		refreshRecorderButton()
	end)

	refreshRecorderButton()
	refreshPanel()
end

return Evp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Exit</string>
            <string name="Source"><![CDATA[--!strict
-- Court Square exit pick. Server owns resolveEnding; this fires Remotes.Exit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Lines = require(ReplicatedStorage.Shared.Lines)

local Exit = {}

function Exit.start(
	buttonA: TextButton,
	buttonB: TextButton,
	buttonC: TextButton,
	setVisible: (boolean) -> (),
	setCountdown: (string) -> (),
	setLabels: (string, string, string) -> ()
)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local exitRemote = remotes:WaitForChild("Exit") :: RemoteEvent
	local sent = false

	local function active(): boolean
		return ride:GetAttribute("ExitActive") == true
	end

	local function pick(choice: string)
		if not active() or sent then
			return
		end
		sent = true
		exitRemote:FireServer(choice)
	end

	buttonA.MouseButton1Click:Connect(function()
		pick("escalators")
	end)
	buttonB.MouseButton1Click:Connect(function()
		pick("lower_level")
	end)
	buttonC.MouseButton1Click:Connect(function()
		pick("surface_hatch")
	end)

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.One or input.KeyCode == Enum.KeyCode.KeypadOne then
			pick("escalators")
		elseif input.KeyCode == Enum.KeyCode.Two or input.KeyCode == Enum.KeyCode.KeypadTwo then
			pick("lower_level")
		elseif input.KeyCode == Enum.KeyCode.Three or input.KeyCode == Enum.KeyCode.KeypadThree then
			pick("surface_hatch")
		end
	end)

	local function refresh()
		local on = active()
		setVisible(on)
		if on then
			setLabels(Lines.EXIT_ESCALATORS, Lines.EXIT_LOWER, Lines.EXIT_HATCH)
		end
		if not on then
			sent = false
			setCountdown("")
			return
		end
		local deadline = ride:GetAttribute("ExitUntil")
		if typeof(deadline) ~= "number" or deadline <= 0 then
			setCountdown("")
			return
		end
		local remain = math.ceil(deadline - workspace:GetServerTimeNow())
		if remain < 1 then
			remain = 1
		end
		setCountdown(tostring(remain) .. "s · " .. Lines.EXIT_DEFAULT)
	end

	ride.AttributeChanged:Connect(function(name: string)
		if name == "ExitActive" or name == "ExitUntil" then
			refresh()
		end
	end)
	RunService.Heartbeat:Connect(function()
		if active() then
			refresh()
		end
	end)
	refresh()
end

return Exit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Flag</string>
            <string name="Source"><![CDATA[--!strict
-- Hold Flag (F, or the button) while the crosshair is on a passenger.
-- The hold is 0.7 seconds, the web game's CFG.flagHold. It only fills
-- during a ride, which is when the web game counts a flag.
-- During the Greenpoint restraint, Space or F reports to Remotes.Hold
-- and does not flag. Space never flags ordinary passengers.
-- The server decides caught vs false flag. This script does not.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Hud = require(script.Parent.Hud)

local Flag = {}

local function passengerFromHit(inst: Instance): string?
	local found: string? = nil
	local hidden = false
	local current: Instance? = inst
	while current ~= nil and current ~= workspace do
		local id = current:GetAttribute("PassengerId")
		if typeof(id) == "string" then
			found = id
		end
		if current:GetAttribute("Hidden") == true then
			hidden = true
		end
		current = current.Parent
	end
	if hidden then
		return nil
	end
	return found
end

local function gazeId(): string?
	local camera = workspace.CurrentCamera
	if camera == nil then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = Players.LocalPlayer.Character
	if character ~= nil then
		params.FilterDescendantsInstances = { character }
	end
	local result = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * Constants.meters(Constants.FLAG_RANGE_M), params)
	if result == nil then
		return nil
	end
	return passengerFromHit(result.Instance)
end

function Flag.start(button: TextButton)
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local flagRemote = remotes:WaitForChild("Flag") :: RemoteEvent
	local holdRemote = remotes:WaitForChild("Hold") :: RemoteEvent

	local keyDown = false
	local spaceDown = false
	local buttonDown = false
	local locked = false
	local progress = 0
	local currentId: string? = nil
	local lastSentHold: boolean? = nil

	-- Space is restraint-only (web Hold Space). Ordinary flags stay on F / button.
	local function flagHolding(): boolean
		return keyDown or buttonDown
	end

	local function restraintHolding(): boolean
		return keyDown or spaceDown or buttonDown
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.F then
			keyDown = true
		elseif input.KeyCode == Enum.KeyCode.Space then
			spaceDown = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.F then
			keyDown = false
		elseif input.KeyCode == Enum.KeyCode.Space then
			spaceDown = false
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			buttonDown = false
		end
	end)

	button.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			buttonDown = true
		end
	end)

	RunService.RenderStepped:Connect(function(dt: number)
		local riding = ride:GetAttribute("Phase") == "ride"
		local restraint = ride:GetAttribute("RestraintActive") == true
		local intervening = ride:GetAttribute("Intervening") == true

		if restraint then
			local down = restraintHolding()
			if lastSentHold ~= down then
				lastSentHold = down
				holdRemote:FireServer(down)
			end
			local ratioAttr = ride:GetAttribute("RestraintProgress")
			local ratio = if typeof(ratioAttr) == "number" then ratioAttr else 0
			Hud.setRestraintMode(true)
			Hud.setProgress(ratio, down)
			return
		end

		if lastSentHold ~= false and lastSentHold ~= nil then
			lastSentHold = false
			holdRemote:FireServer(false)
		end
		Hud.setRestraintMode(false)

		local down = flagHolding()
		if intervening or not down then
			locked = false
			progress = 0
			currentId = nil
			Hud.setProgress(0, false)
			return
		end
		if not riding or locked then
			Hud.setProgress(if locked then 1 else 0, riding)
			return
		end

		local id = gazeId()
		if id == nil or id ~= currentId then
			currentId = id
			progress = 0
		end
		if currentId == nil then
			Hud.setProgress(0, true)
			return
		end
		progress += dt
		local ratio = math.clamp(progress / Constants.FLAG_HOLD, 0, 1)
		Hud.setProgress(ratio, true)
		if progress >= Constants.FLAG_HOLD and currentId ~= nil then
			locked = true
			flagRemote:FireServer(currentId)
		end
	end)
end

return Flag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Gaze</string>
            <string name="Source"><![CDATA[--!strict
-- Center gaze report for caught-staring. Server owns the meter; this only
-- raycasts and tells Remotes.Gaze who (if anyone) is under the crosshair.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)

local Gaze = {}

local function passengerFromHit(inst: Instance): string?
	local found: string? = nil
	local hidden = false
	local current: Instance? = inst
	while current ~= nil and current ~= workspace do
		local id = current:GetAttribute("PassengerId")
		if typeof(id) == "string" then
			found = id
		end
		if current:GetAttribute("Hidden") == true then
			hidden = true
		end
		current = current.Parent
	end
	if hidden then
		return nil
	end
	return found
end

local function gazeId(): string?
	local camera = workspace.CurrentCamera
	if camera == nil then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local character = Players.LocalPlayer.Character
	if character ~= nil then
		params.FilterDescendantsInstances = { character }
	end
	local result =
		workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * Constants.meters(Constants.FLAG_RANGE_M), params)
	if result == nil then
		return nil
	end
	return passengerFromHit(result.Instance)
end

function Gaze.start()
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local gazeRemote = remotes:WaitForChild("Gaze") :: RemoteEvent
	local lastSent: string? = nil
	local lastAt = 0

	RunService.Heartbeat:Connect(function()
		local phase = ride:GetAttribute("Phase")
		if phase ~= "ride" and phase ~= "stop" and phase ~= "haven" then
			if lastSent ~= nil then
				lastSent = nil
				gazeRemote:FireServer(nil)
			end
			return
		end
		local now = os.clock()
		if now - lastAt < 0.12 then
			return
		end
		lastAt = now
		local id = gazeId()
		if id == lastSent then
			return
		end
		lastSent = id
		gazeRemote:FireServer(id)
	end)
end

return Gaze
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Glance</string>
            <string name="Source"><![CDATA[--!strict
-- Heads, from the band the server already chose. Uneasy: one glance while
-- you walk. Watched: heads stay turned toward you. No new parts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Band = require(ReplicatedStorage.Shared.Band)
local Constants = require(ReplicatedStorage.Shared.Constants)

local Glance = {}

type Cluster = {
	head: BasePart,
	parts: { BasePart },
	rest: { [BasePart]: CFrame },
}

local function clusterOf(model: Model): Cluster?
	if model:GetAttribute("Tell") ~= nil then
		return nil
	end
	if model:GetAttribute("Hidden") == true then
		return nil
	end
	local head = model:FindFirstChild("Head", true)
	if head == nil or not head:IsA("BasePart") then
		return nil
	end
	local parts = {}
	local rest = {}
	for _, desc in model:GetDescendants() do
		if desc:IsA("BasePart") and (desc.Name == "Head" or desc.Name == "Hair" or desc.Name == "Eye") then
			table.insert(parts, desc)
			rest[desc] = desc.CFrame
		end
	end
	if #parts == 0 then
		return nil
	end
	return { head = head, parts = parts, rest = rest }
end

local function yawTo(face: Vector3, toward: Vector3): number
	local a = Vector3.new(face.X, 0, face.Z)
	local b = Vector3.new(toward.X, 0, toward.Z)
	if a.Magnitude < 0.05 or b.Magnitude < 0.05 then
		return 0
	end
	a = a.Unit
	b = b.Unit
	return math.atan2(a:Cross(b).Y, a:Dot(b))
end

local function pose(group: Cluster, angle: number)
	local headRest = group.rest[group.head]
	local origin = headRest.Position
	local spin = CFrame.Angles(0, angle, 0)
	for _, part in group.parts do
		local rest = group.rest[part]
		local rel = rest.Position - origin
		part.CFrame = CFrame.new(origin) * spin * CFrame.new(rel) * (rest - rest.Position)
	end
end

local function restore(group: Cluster)
	for _, part in group.parts do
		local rest = group.rest[part]
		part.CFrame = rest
	end
end

function Glance.start()
	local ride = ReplicatedStorage:WaitForChild("Ride")
	local player = Players.LocalPlayer
	local groups: { Cluster } = {}
	local known: { [Model]: boolean } = {}
	local glanceGroup: Cluster? = nil
	local glanceStart = 0
	local nextGlance = 0
	local tapeGlanceUntil = 0

	local function collect()
		local car = workspace:FindFirstChild("SubwayCar")
		local folder = if car ~= nil then car:FindFirstChild("Passengers") else nil
		if folder == nil then
			return
		end
		for _, child in folder:GetChildren() do
			if child:IsA("Model") and known[child] ~= true then
				local group = clusterOf(child)
				if group ~= nil then
					known[child] = true
					table.insert(groups, group)
				end
			end
		end
	end

	ride.AttributeChanged:Connect(function(name: string)
		if name == "TapeGlance" or name == "FlashGlance" then
			tapeGlanceUntil = os.clock() + 2.0
			collect()
			if #groups > 0 then
				glanceGroup = groups[math.random(1, #groups)]
				glanceStart = os.clock()
			end
		end
	end)

	local function angleToward(group: Cluster, maxRad: number): number
		local character = player.Character
		local root = if character ~= nil then character:FindFirstChild("HumanoidRootPart") else nil
		if root == nil or not root:IsA("BasePart") then
			return 0
		end
		local rest = group.rest[group.head]
		local face = -rest.LookVector
		local yaw = yawTo(face, root.Position - rest.Position)
		return math.clamp(yaw, -maxRad, maxRad)
	end

	local function moving(): boolean
		local character = player.Character
		local humanoid = if character ~= nil then character:FindFirstChildOfClass("Humanoid") else nil
		return humanoid ~= nil and humanoid.MoveDirection.Magnitude > 0.05
	end

	RunService.Heartbeat:Connect(function()
		collect()
		local now = os.clock()
		local tapeGlance = now < tapeGlanceUntil
		local band = ride:GetAttribute("Band")
		local look = if typeof(band) == "string" then Band.look(band) else "none"
		if look == "none" and not tapeGlance then
			for _, group in groups do
				restore(group)
			end
			glanceGroup = nil
			return
		end
		if look == "turn" and not tapeGlance then
			glanceGroup = nil
			local maxRad = math.rad(Constants.TURN_YAW_DEG)
			for _, group in groups do
				pose(group, angleToward(group, maxRad))
			end
			return
		end
		if glanceGroup == nil and (tapeGlance or (moving() and now >= nextGlance)) and #groups > 0 then
			glanceGroup = groups[math.random(1, #groups)]
			glanceStart = now
			if not tapeGlance then
				nextGlance = now + Constants.GLANCE_COOLDOWN
			end
		end
		local active = glanceGroup
		for _, group in groups do
			if active ~= nil and group == active then
				local u = (now - glanceStart) / Constants.GLANCE_SECONDS
				if u >= 1 then
					restore(group)
					glanceGroup = nil
				else
					local weight = math.sin(math.pi * math.clamp(u, 0, 1))
					pose(group, angleToward(group, math.rad(Constants.GLANCE_YAW_DEG)) * weight)
				end
			else
				restore(group)
			end
		end
	end)
end

return Glance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen text. The words come from the server (Shared.Lines). This file
-- only places them: the amber PA line, the station card, the suspicion
-- and sanity meters, the flag/hold button. Suspicion, Sanity, and band /
-- tier are Ride attributes; scoring stays on the server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Constants = require(ReplicatedStorage.Shared.Constants)
local Lines = require(ReplicatedStorage.Shared.Lines)
local Route = require(ReplicatedStorage.Shared.Route)

local Hud = {}

local flagButton: TextButton? = nil
local muteButton: TextButton? = nil
local stayButton: TextButton? = nil
local offButton: TextButton? = nil
local choiceFrame: Frame? = nil
local choiceCountdown: TextLabel? = nil
local maskFrame: Frame? = nil
local maskCountdown: TextLabel? = nil
local maskButtonA: TextButton? = nil
local maskButtonB: TextButton? = nil
local maskButtonC: TextButton? = nil
local trialFrame: Frame? = nil
local trialCountdown: TextLabel? = nil
local trialButtonA: TextButton? = nil
local trialButtonB: TextButton? = nil
local trialButtonC: TextButton? = nil
local exitFrame: Frame? = nil
local exitCountdown: TextLabel? = nil
local exitButtonA: TextButton? = nil
local exitButtonB: TextButton? = nil
local exitButtonC: TextButton? = nil
local reportFrame: Frame? = nil
local reportBadge: TextLabel? = nil
local reportTitle: TextLabel? = nil
local reportNarrative: TextLabel? = nil
local reportStats: TextLabel? = nil
local reportPsych: TextLabel? = nil
local againButton: TextButton? = nil
local metaMenuFrame: Frame? = nil
local metaArchiveLabel: TextLabel? = nil
local metaNightmareLabel: TextLabel? = nil
local recorderButton: TextButton? = nil
local evidenceButton: TextButton? = nil
local cameraButton: TextButton? = nil
local albumButton: TextButton? = nil
local progressFill: Frame? = nil
local flagHoldHint: TextLabel? = nil
local restraintMode = false

local function corner(parent: Instance, radius: number)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius)
	ui.Parent = parent
end

local function label(parent: Instance, text: string, size: number, color: Color3): TextLabel
	local ui = Instance.new("TextLabel")
	ui.BackgroundTransparency = 1
	ui.Font = Enum.Font.GothamMedium
	ui.Text = text
	ui.TextSize = size
	ui.TextColor3 = color
	ui.TextXAlignment = Enum.TextXAlignment.Left
	ui.TextYAlignment = Enum.TextYAlignment.Center
	ui.TextWrapped = true
	ui.Parent = parent
	return ui
end

function Hud.flagButton(): TextButton
	assert(flagButton ~= nil, "Hud.start must run first")
	return flagButton
end

function Hud.muteButton(): TextButton
	assert(muteButton ~= nil, "Hud.start must run first")
	return muteButton
end

function Hud.stayButton(): TextButton
	assert(stayButton ~= nil, "Hud.start must run first")
	return stayButton
end

function Hud.offButton(): TextButton
	assert(offButton ~= nil, "Hud.start must run first")
	return offButton
end

function Hud.setChoiceVisible(visible: boolean)
	local frame = choiceFrame
	if frame ~= nil then
		frame.Visible = visible
	end
end

function Hud.setChoiceCountdown(text: string)
	local countdown = choiceCountdown
	if countdown ~= nil then
		countdown.Text = text
	end
end

function Hud.maskButtonA(): TextButton
	assert(maskButtonA ~= nil, "Hud.start must run first")
	return maskButtonA
end

function Hud.maskButtonB(): TextButton
	assert(maskButtonB ~= nil, "Hud.start must run first")
	return maskButtonB
end

function Hud.maskButtonC(): TextButton
	assert(maskButtonC ~= nil, "Hud.start must run first")
	return maskButtonC
end

function Hud.setMaskVisible(visible: boolean)
	local frame = maskFrame
	if frame ~= nil then
		frame.Visible = visible
	end
end

function Hud.setMaskCountdown(text: string)
	local countdown = maskCountdown
	if countdown ~= nil then
		countdown.Text = text
	end
end

function Hud.setMaskLabels(a: string, b: string, c: string)
	local ba = maskButtonA
	local bb = maskButtonB
	local bc = maskButtonC
	if ba ~= nil then
		ba.Text = "[1]  " .. a
	end
	if bb ~= nil then
		bb.Text = "[2]  " .. b
	end
	if bc ~= nil then
		bc.Text = "[3]  " .. c
	end
end

function Hud.trialButtonA(): TextButton
	assert(trialButtonA ~= nil, "Hud.start must run first")
	return trialButtonA
end

function Hud.trialButtonB(): TextButton
	assert(trialButtonB ~= nil, "Hud.start must run first")
	return trialButtonB
end

function Hud.trialButtonC(): TextButton
	assert(trialButtonC ~= nil, "Hud.start must run first")
	return trialButtonC
end

function Hud.setTrialVisible(visible: boolean)
	local frame = trialFrame
	if frame ~= nil then
		frame.Visible = visible
	end
end

function Hud.setTrialCountdown(text: string)
	local countdown = trialCountdown
	if countdown ~= nil then
		countdown.Text = text
	end
end

function Hud.setTrialLabels(a: string, b: string, c: string, slots: number)
	local ba = trialButtonA
	local bb = trialButtonB
	local bc = trialButtonC
	if ba ~= nil then
		ba.Text = "[1]  " .. a
		ba.Visible = slots >= 1
	end
	if bb ~= nil then
		bb.Text = "[2]  " .. b
		bb.Visible = slots >= 2
	end
	if bc ~= nil then
		bc.Text = "[3]  " .. c
		bc.Visible = slots >= 3
	end
end

function Hud.exitButtonA(): TextButton
	assert(exitButtonA ~= nil, "Hud.start must run first")
	return exitButtonA
end

function Hud.exitButtonB(): TextButton
	assert(exitButtonB ~= nil, "Hud.start must run first")
	return exitButtonB
end

function Hud.exitButtonC(): TextButton
	assert(exitButtonC ~= nil, "Hud.start must run first")
	return exitButtonC
end

function Hud.setExitVisible(visible: boolean)
	local frame = exitFrame
	if frame ~= nil then
		frame.Visible = visible
	end
end

function Hud.setExitCountdown(text: string)
	local countdown = exitCountdown
	if countdown ~= nil then
		countdown.Text = text
	end
end

function Hud.setExitLabels(a: string, b: string, c: string)
	local ba = exitButtonA
	local bb = exitButtonB
	local bc = exitButtonC
	if ba ~= nil then
		ba.Text = "[1]  " .. a
	end
	if bb ~= nil then
		bb.Text = "[2]  " .. b
	end
	if bc ~= nil then
		bc.Text = "[3]  " .. c
	end
end

function Hud.recorderButton(): TextButton
	assert(recorderButton ~= nil, "Hud.start must run first")
	return recorderButton
end

function Hud.evidenceButton(): TextButton
	assert(evidenceButton ~= nil, "Hud.start must run first")
	return evidenceButton
end

function Hud.cameraButton(): TextButton
	assert(cameraButton ~= nil, "Hud.start must run first")
	return cameraButton
end

function Hud.albumButton(): TextButton
	assert(albumButton ~= nil, "Hud.start must run first")
	return albumButton
end

function Hud.setRestraintMode(active: boolean)
	restraintMode = active
	local button = flagButton
	local hint = flagHoldHint
	if button == nil or hint == nil then
		return
	end
	if active then
		button.Text = "HOLD"
		hint.Text = Lines.RESTRAINT_BUTTON
		hint.TextColor3 = Constants.COLOR.warn
		button.BackgroundColor3 = Color3.fromRGB(36, 28, 12)
	else
		button.Text = "FLAG"
		hint.Text = "hold to catch"
		hint.TextColor3 = Color3.fromRGB(210, 206, 196)
		button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	end
end

function Hud.setProgress(ratio: number, holding: boolean)
	local fill = progressFill
	local button = flagButton
	if fill == nil or button == nil then
		return
	end
	local clamped = math.clamp(ratio, 0, 1)
	fill.Size = UDim2.fromScale(clamped, 1)
	fill.BackgroundTransparency = if clamped > 0 then 0 else 1
	if restraintMode then
		fill.BackgroundColor3 = Constants.COLOR.warn
		if holding then
			button.BackgroundColor3 = Color3.fromRGB(48, 36, 14)
		else
			button.BackgroundColor3 = Color3.fromRGB(36, 28, 12)
		end
		return
	end
	fill.BackgroundColor3 = Constants.COLOR.gLine
	if holding and clamped > 0 then
		button.BackgroundColor3 = Color3.fromRGB(28, 46, 22)
	else
		button.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	end
end

function Hud.againButton(): TextButton
	assert(againButton ~= nil, "Hud.start must run first")
	return againButton
end

function Hud.setMenuVisible(visible: boolean)
	local frame = metaMenuFrame
	if frame ~= nil then
		frame.Visible = visible
	end
end

function Hud.setNightmareLabel(text: string, _unlocked: boolean)
	local lbl = metaNightmareLabel
	if lbl ~= nil then
		lbl.Text = text
	end
end

function Hud.setArchiveText(text: string)
	local lbl = metaArchiveLabel
	if lbl ~= nil then
		lbl.Text = text
	end
end

function Hud.setArchiveVisible(visible: boolean)
	local lbl = metaArchiveLabel
	if lbl ~= nil then
		lbl.Visible = visible
	end
end

